\\ test/test.6502 - what make test's checks share: where their answers go, the run the loader calls
\\ in a check's build (-D TEST=TRUE, its program naming its check), and T emptied and summed.

TEST_RESULTS = &C000                    ; HAZEL, the filing system's 8K: paged in, its OS gone
TEST_RESULTS_END = &E000

SECTION TestResults, org = TEST_RESULTS, guard = TEST_RESULTS_END, virtual = TRUE
.t_done     SKIP 1                      ; &A5 once the check's answers are written
ENDSECTION

\\ Run the check, then stop here: the loader that came in is gone, as T's clear wipes it.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     TestResults: its answers, t_done last

.test
{
    LDA #0:STA t_done
    JSR check
    LDA #&A5:STA t_done
.stop
    JMP stop
}

\\ The checks' made-up values' LFSR: 32 bits, Galois, taps &80200003. A check seeds it.

ZA_AUTO 4, random

\\ The LFSR's next byte, eight steps on, as the C's checks step theirs: one step leaves the low byte
\\ the last one shifted a bit.
\\
\\ Inputs:
\\     random: the LFSR
\\
\\ Outputs:
\\     random: stepped
\\     A: its low byte
\\     X, Y: preserved

.random_byte
{
    ZA_AUTO1 steps                      ; local: the steps to go

    LDA #8:STA steps
.step
    LSR random+3:ROR random+2:ROR random+1:ROR random
    BCC stepped
    LDA random+3:EOR #&80:STA random+3
    LDA random+2:EOR #&20:STA random+2
    LDA random:EOR #&03:STA random
.stepped
    DEC steps
    BNE step
    LDA random
    RTS
}

\\ Empty T, its junk rows too.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     T_JUNK_TOP to SCREEN_A: 0
\\     A, X, Y: corrupted

.clear_t
{
    LDA #HI(T_JUNK_TOP):STA page+2
    LDA #0:TAY
    LDX #HI(SCREEN_A-T_JUNK_TOP)        ; pages
.page
    STA T_JUNK_TOP,Y
    INY
    BNE page
    INC page+2                          ; the operand's high byte
    DEX
    BNE page
    RTS
}

\\ T's sums, its junk rows too.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     sum1, sum2: the Fletcher sums of T_JUNK_TOP to SCREEN_A
\\     A, X, Y: corrupted

.sum_t
{
    ZA_AUTO1 sum1                       ; out: the sum of the bytes
    ZA_AUTO1 sum2                       ; out: the sum of the sums

    LDA #HI(T_JUNK_TOP):STA page+2
    LDA #0:STA sum1:STA sum2:TAY
    LDX #HI(SCREEN_A-T_JUNK_TOP)        ; pages
.page
    LDA T_JUNK_TOP,Y:FLETCHER sum1, sum2
    INY
    BNE page
    INC page+2
    DEX
    BNE page
    RTS
}
