\\ test/capture.6502 - make test's check of the capture: its setup and root walk from each cell's
\\ centroid at every angle, and HEIGHT_OF, for host/test_build.py to compare with the C's.

\\ Each cell's centroid, as the C's tools take it: the mean of its ring's vertices, truncated.

cell_bounds = CONCAT(map_cell_first, {MAP_SIDES})

FUNCTION ring_mean(xs, c)
    f = cell_bounds[c]
    e = cell_bounds[c+1]
= SUM(xs[map_side_v[f..<e]]) DIV (e-f)

SECTION TestResults
.t_capture1 SKIP MAX_CELLS              ; the capture's Fletcher sums, by the camera's cell
.t_capture2 SKIP MAX_CELLS
.t_height1  SKIP &100                   ; HEIGHT_OF's, by the eye's height
.t_height2  SKIP &100
ENDSECTION

\\ From each cell's centroid, at every angle: the capture's setup and root walk. Too many answers
\\ to keep, so each cell's go into a pair of sums; then every height from every eye height.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     t_capture1, t_capture2: the capture's sums, by the camera's cell
\\     t_height1, t_height2: HEIGHT_OF's, by the eye's height

.test_capture
{
    ZA_AUTO1 sum1                       ; local: the sum of the answers' bytes
    ZA_AUTO1 sum2                       ; local: and the sum of the sums

    LDA #1:STA camcell
.cell
    LDX camcell
    LDA t_centrexlo,X:STA camx
    LDA t_centrexhi,X:STA camx+1
    LDA t_centreylo,X:STA camy
    LDA t_centreyhi,X:STA camy+1
    JSR vcache_reset
    LDA #0:STA camangle:STA camangle+1:STA sum1:STA sum2
.angle
    JSR capture

    \\ the walk, its visit, the eye's height, the counts, and where each byte column's fill stops

    FOR v = {walk_vi, walk_x, walk_tmax, walk_bmin, walk_wrap, walk_wrap+1, walk_u0, walk_u0+1}
        LDA v:FLETCHER sum1, sum2
    NEXT
    FOR v = {walk_u1, walk_u1+1, walk_c0, walk_c1}
        LDA v:FLETCHER sum1, sum2
    NEXT
    LDX walk_vi
    FOR t = {visit_cell, visit_side, visit_xr, visit_kept, visit_hclo, visit_hchi, visit_hflo}
        LDA t,X:FLETCHER sum1, sum2
    NEXT
    LDA visit_hfhi,X:FLETCHER sum1, sum2
    FOR v = {eye_z, num_visits, num_kept, num_recs}
        LDA v:FLETCHER sum1, sum2
    NEXT
    LDX #0
.ends
    LDA toggle_end,X:FLETCHER sum1, sum2
    INX
    CPX #SCREEN_WIDTH/4
    BNE ends

    CLC:LDA camangle:ADC #4             ; the next of the C's 256ths
    STA camangle
    LDA camangle+1:ADC #0:AND #3:STA camangle+1
    ORA camangle
    BEQ angles                          ; round to 0: all 256
    JMP angle
.angles
    LDX camcell
    LDA sum1:STA t_capture1,X
    LDA sum2:STA t_capture2,X
    INC camcell
    LDA camcell:CMP #MAP_CELLS
    BEQ heights
    JMP cell

    \\ every height from every eye height: the log's low byte, then its high and the side

    ZA_AUTO1 z                          ; local: the height

.heights
    LDA #0:STA eye_z
.eye
    LDA #0:STA z:STA sum1:STA sum2
.height
    LDA z
    HEIGHT_OF
    PHA
    TXA:FLETCHER sum1, sum2
    PLA:FLETCHER sum1, sum2
    INC z
    BNE height
    LDX eye_z
    LDA sum1:STA t_height1,X
    LDA sum2:STA t_height2,X
    INC eye_z
    BNE eye
    RTS
}

\\ The centroids, by cell: cell 0, the outside, has none.

    FITPAGE MAP_CELLS
.t_centrexlo
FOR c = 0..MAP_CELLS-1
    EQUB LO((c != 0)*ring_mean(map_vert_x, MAX({c, 1})))
NEXT
    FITPAGE MAP_CELLS
.t_centrexhi
FOR c = 0..MAP_CELLS-1
    EQUB HI((c != 0)*ring_mean(map_vert_x, MAX({c, 1})))
NEXT
    FITPAGE MAP_CELLS
.t_centreylo
FOR c = 0..MAP_CELLS-1
    EQUB LO((c != 0)*ring_mean(map_vert_y, MAX({c, 1})))
NEXT
    FITPAGE MAP_CELLS
.t_centreyhi
FOR c = 0..MAP_CELLS-1
    EQUB HI((c != 0)*ring_mean(map_vert_y, MAX({c, 1})))
NEXT
