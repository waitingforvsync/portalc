\ **************************************************************************
\ *
\ *     crc.6502 - the CRC-16 tables every suite's checks fold their results with
\ *
\ **************************************************************************
\
\ CRC-16/XMODEM: polynomial &1021, MSB first, a byte at a time through two
\ tables (a byte's CRC, low and high), made at start into test BSS.

\\ crc_lo and crc_hi: the CRC of each byte v, (v << 8) shifted through the
\\ polynomial eight times.
.crc_init
{
    ZA_AUTO2 c                  ; local
    LDX #0
.byte
    STX c + 1 : LDA #0 : STA c
    LDY #8
.bit
    ASL c : ROL c + 1 : BCC @+
    LDA c : EOR #&21 : STA c
    LDA c + 1 : EOR #&10 : STA c + 1
.@  DEY : BNE bit
    LDA c : STA crc_lo,X
    LDA c + 1 : STA crc_hi,X
    INX : BNE byte
    RTS
}
