\\ tables.6502 - the tables, made by the loader exactly as arith.c makes them: the smooth ones
\\ from a bit a delta, packed here at assembly time, the rest by recurrence, logs and division.

RPOST_START = POST_NEAR DIV 8           ; rpost's first index, 32
RPOST_END = CAM_RADIUS*CAM_RADIUS DIV 8 ; its end, 200: the camera's circle
RPOST_DIVIDEND = POST_SCALE DIV 8-1     ; (see make_tables), 5119
ASSERT POST_SCALE MOD 8 == 0 AND HI(RPOST_DIVIDEND) < RPOST_START, "rpost: a byte quotient over i"

ASSERT T_ORG+SCREEN_HEIGHT DIV 4*&100 == T_JUNK_BOT, "T: four rows a page, then the junk row"

FILL_ENDS = SCREEN_HEIGHT+2             ; the fill's end rows, 0 to 65 (0 unused)

SECTION Tables
.nrm        SKIP &100                   ; the bits under b's leading one (0: unused)
.k8         SKIP &100                   ; 8 - lz(b): its bit length (0: unused)
.logf       SKIP &100                   ; 256 log2(1 + j/256)
.expf       SKIP &100                   ; 256 (2^(f/256) - 1)
.atan       SKIP &100                   ; atan of ratio byte i, in steps, floored
.lhyp       SKIP &100                   ; 256 log2 sec of the same
.sinq       SKIP &100                   ; 256 sin over the right angle (from 246, 256)
.a2c        SKIP &100                   ; screen angle -> column
.lsec16lo   SKIP &100                   ; -256 log2 cos at each step's middle: lsec,
.lsec16hi   SKIP &100                   ; then on past 45 degrees
.sq1lo      SKIP &200                   ; i*i/4
.sq1hi      SKIP &200
.sq2lo      SKIP &200                   ; (i-255)*(i-255)/4
.sq2hi      SKIP &200
.shr3       SKIP &100                   ; b DIV 8: a sprite run byte's row
.rpostmem   SKIP RPOST_END-RPOST_START  ; POST_SCALE / d2, by d2 / 8
.trowhi     SKIP SCREEN_HEIGHT+1        ; row y's page in T, to the junk row's
IF DEFINED(fill_body_a)                 ; the fill's, by a column's end row, where it's assembled:
    FITPAGE FILL_ENDS
.fill_exitlo_a  SKIP FILL_ENDS          ; where screen A's body takes the RTS
    FITPAGE FILL_ENDS
.fill_exithi_a  SKIP FILL_ENDS
    FITPAGE FILL_ENDS
.fill_taillo_a  SKIP FILL_ENDS          ; where its tail starts
    FITPAGE FILL_ENDS
.fill_tailhi_a  SKIP FILL_ENDS
    FITPAGE FILL_ENDS
.fill_exitlo_b  SKIP FILL_ENDS          ; and screen B's
    FITPAGE FILL_ENDS
.fill_exithi_b  SKIP FILL_ENDS
    FITPAGE FILL_ENDS
.fill_taillo_b  SKIP FILL_ENDS
    FITPAGE FILL_ENDS
.fill_tailhi_b  SKIP FILL_ENDS
ENDIF
ENDSECTION

ASSERT HI(trowhi) == HI(trowhi+SCREEN_HEIGHT), "trowhi: within a page"

lsec = lsec16lo                         ; its first 128: under 45 degrees, bytes
rpost = rpostmem-RPOST_START
lsx = SCRATCH_ORG                       ; the loader's, for lsec16: in Scratch, the payloads out

\\ The multiply's pointers into the quarter squares, live throughout. A multiply by a puts a in
\\ sq1's low bytes and a EOR &FF in sq2's, so (ptr),Y reads sq1[a + Y] and sq2[255 - a + Y].

ZA_AUTO2 sq1loptr
ZA_AUTO2 sq1hiptr
ZA_AUTO2 sq2loptr
ZA_AUTO2 sq2hiptr

ASSERT (LO(sq1lo) OR LO(sq1hi) OR LO(sq2lo) OR LO(sq2hi)) == 0, "the quarter squares: on pages"

\\ The ideal values, as arith.c has them.

FUNCTION log2(x) = LN(x)/LN(2)
FUNCTION f_sinq(j) = 256*SIN(j*(PI/512))
FUNCTION f_atan(i) = ATAN((i+0.5)/256)*(512/PI)
FUNCTION f_lhyp(i) = 128*log2(1+((i+0.5)/256)*((i+0.5)/256))
FUNCTION f_logf(j) = 256*log2(1+j/256)
FUNCTION f_expf(f) = 256*(2^(f/256)-1)
FUNCTION f_lsec(i) = -256*log2(COS((i+0.5)*(PI/512)))
FUNCTION f_lsx(j)
    x = (j+0.5)*(PI/512)
= -256*log2(SIN(x)/x)
FUNCTION f_a2c(k) = 64+64*TAN((k-128+0.5)*(PI/512))

ideal_logf = ROUND(f_logf(0..255))
ideal_expf = ROUND(f_expf(0..255))
ideal_atan = FLOOR(f_atan(0..255))
ideal_lhyp = ROUND(f_lhyp(0..255))
ideal_sinq = ROUND(f_sinq(0..255))
ideal_a2c = ROUND(f_a2c(0..255))
ideal_lsec = ROUND(f_lsec(0..127))
ideal_lsx = ROUND(f_lsx(0..127))

LOG_STEP = ROUND(-256*log2(PI/1024))    ; 2137.2, for lsec16: a step's angle, its log negated

\\ Make every table, as arith.c does.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     Tables: made
\\     sq1loptr to sq2hiptr: the multiply's pointers

.make_tables
{
    \\ the normalisers, an octave at a time: the bytes of bit length k normalise to 128 on, in
    \\ steps of 2^(8 - k), and nrm takes them with the leading one shifted out

    ZA_AUTO1 step                       ; local: 2^(8 - k)

    LDA #0:STA nrm:STA k8
    LDX #1:LDY #1
    LDA #128:STA step
.octave
    LDA #128
.bytes
    PHA:ASL A:STA nrm,X
    TYA:STA k8,X:PLA
    INX
    CLC:ADC step
    BCC bytes
    INY
    LSR step
    CPX #0
    BNE octave

    \\ the tables of a bit a delta

    UNPACK logf, ideal_logf, bits_logf
    UNPACK expf, ideal_expf, bits_expf
    UNPACK atan, ideal_atan, bits_atan
    UNPACK lhyp, ideal_lhyp, bits_lhyp
    UNPACK sinq, ideal_sinq, bits_sinq
    UNPACK a2c, ideal_a2c, bits_a2c
    UNPACK lsec, ideal_lsec, bits_lsec
    UNPACK lsx, ideal_lsx, bits_lsx

    \\ lsec16 past 45 degrees, from logs: LOG_STEP - log2(2j + 1) + lsx[j] at 255 - j, the log as
    \\ pt_log2_8 has it; under 45, high bytes of 0

    ZA_AUTO1 logfrac                    ; local: log2(2j + 1)'s fraction
    ZA_AUTO1 logk8                      ; local: its whole part + 1
    ZA_AUTO2 lsecv                      ; local: the entry

    LDY #127
.lsec16
    TYA:ASL A:ORA #1:TAX                ; 2j + 1
    LDA k8,X:STA logk8
    LDA nrm,X:TAX
    LDA logf,X:STA logfrac
    TYA:EOR #&FF:TAX                    ; 255 - j
    SEC
    LDA #LO(LOG_STEP+&100):SBC logfrac:STA lsecv
    LDA #HI(LOG_STEP+&100):SBC logk8:STA lsecv+1
    CLC
    LDA lsecv:ADC lsx,Y:STA lsec16lo,X
    LDA lsecv+1:ADC #0:STA lsec16hi,X
    LDA #0:STA lsec16hi,Y
    DEY
    BPL lsec16

    \\ the quarter squares, x*x DIV 4 for x = 0..511 (as starglobe's): sq1[x + 1] = sq1[x] +
    \\ (x + 1) DIV 2. Then sq2[x] = sq1[255 - x], and sq1[x - 255] past 255

    ZA_AUTO2 quarter                    ; local: x*x DIV 4
    ZA_AUTO1 delta                      ; local: (x + 1) DIV 2

    LDX #0
    STX quarter:STX quarter+1
    STX delta
    LDY #2                              ; pages
.sq1
    LDA quarter+1
.sq1h
    STA sq1hi,X                         ; the operand's high byte steps on
    LDA quarter
.sq1l
    STA sq1lo,X                         ; likewise
    CLC:ADC delta:STA quarter
    BCC @+:INC quarter+1:.@
    TXA:LSR A:BCS @+:INC delta:.@       ; delta steps on even x
    INX
    BNE sq1
    INC sq1h+2
    INC sq1l+2
    DEY
    BNE sq1
    DEY                                 ; X = 0, Y = 255
.sq2
    LDA sq1lo,X:STA sq2lo,Y             ; sq2[255 - x] = sq1[x]
    LDA sq1hi,X:STA sq2hi,Y
    LDA sq1lo+1,X:STA sq2lo+&100,X      ; sq2[256 + x] = sq1[x + 1]
    LDA sq1hi+1,X:STA sq2hi+&100,X
    DEY
    INX
    BNE sq2

    \\ the multiply's pointers: each table's page, the low bytes 0 (X is)

    STX sq1loptr:STX sq1hiptr:STX sq2loptr:STX sq2hiptr
    LDA #HI(sq1lo):STA sq1loptr+1
    LDA #HI(sq1hi):STA sq1hiptr+1
    LDA #HI(sq2lo):STA sq2loptr+1
    LDA #HI(sq2hi):STA sq2hiptr+1

    \\ rpost: (POST_SCALE + d - 1) DIV d for d = 8i, which is 1 + RPOST_DIVIDEND DIV i, by
    \\ restoring division as beebdoom's: the remainder in A, its ninth bit the carry out of ROL A

    ZA_AUTO1 divisor                    ; local: i
    ZA_AUTO1 quotient                   ; local: the dividend's low byte, then the quotient

    LDX #RPOST_START
.posts
    STX divisor
    LDA #LO(RPOST_DIVIDEND):STA quotient
    LDA #HI(RPOST_DIVIDEND)             ; the remainder: 19, under i
    LDY #8
    SEC
.divide
    ROL quotient                        ; the dividend's next bit out, the last quotient bit in
    ROL A
    BCS goes                            ; 256 or more: over i
    CMP divisor
    BCC under
.goes
    SBC divisor
    SEC                                 ; the quotient's bit
.under
    DEY
    BNE divide
    ROL quotient                        ; its last bit in, the SEC out
    LDA quotient:ADC #0                 ; plus the SEC: the 1
    STA rpost,X
    INX
    CPX #RPOST_END
    BNE posts

    \\ T's rows' pages, for the plotters: row y's is T's plus y DIV 4, 64 the junk row's

    LDX #SCREEN_HEIGHT
.trows
    TXA:LSR A:LSR A
    CLC:ADC #HI(T_ORG)
    STA trowhi,X
    DEX
    BPL trows

    \\ shr3

    LDX #0
.shifts
    TXA:LSR A:LSR A:LSR A
    STA shr3,X
    INX
    BNE shifts

    \\ the fill's, where it's assembled: by the end row, where each screen's body takes the RTS,
    \\ the row's EOR (past row 63 fill_spare, as the body's own RTS ends it), and where its tail
    \\ starts, the row's store from row 1's (row 65 row 64's)

    IF DEFINED(fill_body_a)
        STEPPED fill_exitlo_a, fill_exithi_a, fill_body_a, FILL_BLOCK, SCREEN_HEIGHT
        STEPPED fill_exitlo_b, fill_exithi_b, fill_body_b, FILL_BLOCK, SCREEN_HEIGHT
        STEPPED fill_taillo_a, fill_tailhi_a, fill_tail_a-FILL_STORE, FILL_STORE, SCREEN_HEIGHT+1
        STEPPED fill_taillo_b, fill_tailhi_b, fill_tail_b-FILL_STORE, FILL_STORE, SCREEN_HEIGHT+1
        last_a = fill_tail_a+FILL_STORE*(SCREEN_HEIGHT-1)    ; row 64's tail, row 65's too
        last_b = fill_tail_b+FILL_STORE*(SCREEN_HEIGHT-1)
        exits = {fill_exitlo_a, fill_exitlo_b, fill_exithi_a, fill_exithi_b}
        spares = {LO(fill_spare), LO(fill_spare), HI(fill_spare), HI(fill_spare)}
        tails = {fill_taillo_a, fill_tailhi_a, fill_taillo_b, fill_tailhi_b}
        lasts = {LO(last_a), HI(last_a), LO(last_b), HI(last_b)}
        rest = CONCAT(ZIP(exits+SCREEN_HEIGHT, spares), ZIP(exits+SCREEN_HEIGHT+1, spares))
        rest_sorted = SORT(CONCAT(rest, ZIP(tails+SCREEN_HEIGHT+1, lasts)), 1)
        FOR i = 0..<LEN(rest_sorted)            ; by value, each loaded once
            IF i == 0
                LDA #rest_sorted[0][1]
            ELIF rest_sorted[i][1] != rest_sorted[i-1][1]
                LDA #rest_sorted[i][1]
            ENDIF
            STA rest_sorted[i][0]
        NEXT
    ENDIF
    RTS
}

\\ The tables' bits, for make_tables to unpack (and empty).

.bits_logf
    PACK ideal_logf
.bits_expf
    PACK ideal_expf
.bits_atan
    PACK ideal_atan
.bits_lhyp
    PACK ideal_lhyp
.bits_sinq
    PACK ideal_sinq
.bits_a2c
    PACK ideal_a2c
.bits_lsec
    PACK ideal_lsec
.bits_lsx
    PACK ideal_lsx
