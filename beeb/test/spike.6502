\ **************************************************************************
\ *
\ *     spike.6502 - the recursion spike (PLAN.md section 6, Phase 1)
\ *
\ **************************************************************************
\
\ walk's skeleton, before any clip code exists: the real save stack, the
\ real nine bytes a level, descend inlined, and a dummy leaf chain as deep
\ as the real one (process_edge -> clip_edge_line -> clip_line ->
\ resolve_block -> crossing -> div_cols -> mulg). Each chain routine holds
\ a few bytes across its call, about what the real one will, so the zero
\ page adds up as it will for real. Everything mixes into a checksum that
\ host/spike.py recomputes: a bad save, restore or allocation shows.
\
\ The tree: three edges a cell. The first always has a child, the second
\ one time in eight, the last (a tail call) one time in eight, all decided
\ by the chain's result. Deep enough to hit the depth cap every time.

CMD_SPIKE = 2

\ the save stack: nine arrays of 16, indexed by depth
STK_CELL = &100
STK_X = &110
STK_XR = &120
STK_TCUR = &130
STK_BCUR = &140
STK_TMAX = &150
STK_BMIN = &160
STK_STEPS = &170
STK_PEND = &180
CANARY = &190                       ; to &1BF: the hardware stack must stop short
CANARY_END = &1C0

\ The instruments live in the results block, not the pool: they are the
\ test's, not the walk's, and three of them (the checksum, the deepest
\ level, the low water) are running values rebuilt through A, which Baron
\ can't tell from a fresh per-level store across the recursion.
spike_sum = spike_out + 0           ; the checksum
spike_nodes = spike_out + 2         ; portals walked
spike_closes = spike_out + 4        ; children the depth cap closed
spike_dhigh = spike_out + 6         ; the deepest level
spike_lows = spike_out + 7          ; the lowest S seen at the bottom of the chain
spike_canary = spike_out + 8        ; canary bytes found damaged
spike_usecs = spike_out + 9         ; four bytes: the walk's time

\ The walk's own running state, INCed and DECed through the recursion: one
\ byte each, seeded outside it.
ZA_AUTO1 spike_npend                ; seg_record's counter
ZA_AUTO1 spike_depth                ; the walk's depth

\\ SPIKE: walk the dummy tree from a root portal seeded by arg0; results at
\\ spike_out (above).
.cmd_spike
{
    ZA_AUTO 4, t0                   ; local: the clock at the start
    LDX #CANARY_END - CANARY - 1
.fill
    TXA : EOR #&A5 : STA CANARY,X
    DEX : BPL fill

    LDA #0
    STA spike_sum : STA spike_sum + 1
    STA spike_nodes : STA spike_nodes + 1
    STA spike_closes : STA spike_closes + 1
    STA spike_npend : STA spike_dhigh
    LDA #&FF : STA spike_lows
    LDA #1 : STA spike_depth

    LDA MB_ARG : STA sp_walk.cell      ; the root portal
    LDA #0 : STA sp_walk.x : STA sp_walk.tmax
    LDA #128 : STA sp_walk.xr
    LDA #1 : STA sp_walk.tcur
    LDA #2 : STA sp_walk.bcur
    LDA #64 : STA sp_walk.bmin

    JSR now
    ZA_DISCARD t0                   ; the old value's dead: the loop makes a new one
    LDX #3
.keep
    LDA now.t,X : ZA_INDEXEDBY 0..3
    STA t0,X : ZA_INDEXEDBY 0..3
    DEX : BPL keep
    JSR sp_walk
    JSR now
    SEC
    FOR i = 0 ..< 4
        LDA now.t + i : SBC t0 + i : STA spike_usecs + i
    NEXT

    LDY #0                          ; the canary's damage
    LDX #CANARY_END - CANARY - 1
.check
    TXA : EOR #&A5 : CMP CANARY,X
    BEQ @+
    INY
.@  DEX : BPL check
    STY spike_canary
    RTS
}

\\ Mix A into the checksum: rotate it left a bit, then EOR A into the low byte.
.spike_mix
{
    TAY
    LDA spike_sum + 1 : ASL A
    ROL spike_sum : ROL spike_sum + 1
    TYA : EOR spike_sum : STA spike_sum
    RTS
}

\\ A portal: each edge of its cell, a child through any but the last walked
\\ one level down, the last's child walked here (the tail call).
.sp_walk
{
    ZA_AUTO1 cell, x, xr, tcur, bcur, tmax, bmin  ; in: the portal (restored after each descent)
    ZA_AUTO1 steps                  ; local: edges left, counting down
    ZA_AUTO1 pend                   ; local: the pending count at entry

    LDA spike_npend : STA pend
    LDA spike_depth : CMP spike_dhigh : BCC portal
    STA spike_dhigh
.portal
    INC spike_npend                 ; seg_record's stand-in
    INC spike_nodes : BNE @+
    INC spike_nodes + 1
.@  LDA cell : JSR spike_mix
    LDA x : JSR spike_mix
    LDA xr : JSR spike_mix
    LDA tcur : JSR spike_mix
    LDA bcur : JSR spike_mix
    LDA tmax : JSR spike_mix
    LDA bmin : JSR spike_mix
    LDA #4 : STA steps              ; three edges, plus one for the wrap
.edge
    LDA steps : BNE next
.done
    LDA pend : JMP spike_mix        ; inst_issue's stand-in
.next
    DEC steps
    JSR sp_process_edge                ; C: a child, in process_edge.ccell..cbmin
    LDX steps : DEX : BNE notlast
    BCC done                        ; the last edge, no child
    JSR sp_take_child                  ; the tail call
    JMP portal
.notlast
    BCC advance
    ; descend, inlined: past the cap, close instead
    LDX spike_depth
    CPX #PT_MAX_DEPTH : BCS cap
    LDA cell : STA STK_CELL,X
    LDA x : STA STK_X,X
    LDA xr : STA STK_XR,X
    LDA tcur : STA STK_TCUR,X
    LDA bcur : STA STK_BCUR,X
    LDA tmax : STA STK_TMAX,X
    LDA bmin : STA STK_BMIN,X
    LDA steps : STA STK_STEPS,X
    LDA pend : STA STK_PEND,X
    JSR sp_take_child
    INC spike_depth
    JSR sp_walk
    DEC spike_depth
    LDX spike_depth
    LDA STK_CELL,X : STA cell
    LDA STK_X,X : STA x
    LDA STK_XR,X : STA xr
    LDA STK_TCUR,X : STA tcur
    LDA STK_BCUR,X : STA bcur
    LDA STK_TMAX,X : STA tmax
    LDA STK_BMIN,X : STA bmin
    LDA STK_STEPS,X : STA steps
    LDA STK_PEND,X : STA pend
    JMP advance
.cap
    INC spike_closes : BNE @+       ; close_columns' stand-in
    INC spike_closes + 1
.@  LDA sp_process_edge.ccell : JSR spike_mix
.advance
    LDA cell : JSR spike_mix        ; visit_advance's stand-in
    LDA steps : JSR spike_mix
    JMP edge
}

\\ The child becomes the portal.
.sp_take_child
{
    LDA sp_process_edge.ccell : STA sp_walk.cell
    LDA sp_process_edge.cx : STA sp_walk.x
    LDA sp_process_edge.cxr : STA sp_walk.xr
    LDA sp_process_edge.ctcur : STA sp_walk.tcur
    LDA sp_process_edge.cbcur : STA sp_walk.bcur
    LDA sp_process_edge.ctmax : STA sp_walk.tmax
    LDA sp_process_edge.cbmin : STA sp_walk.bmin
    RTS
}

\\ In: walk's portal and steps. Out: C set when the edge has a child, and
\\ the child (always written). Holds 12 bytes across the chain.
.sp_process_edge
{
    ZA_AUTO 12, keep                ; local: the edge's state, live across the chain
    ZA_AUTO1 r                      ; local: the chain's result
    ZA_AUTO1 ccell, cx, cxr, ctcur, cbcur, ctmax, cbmin  ; out: the child portal
    LDA sp_walk.cell : EOR sp_walk.steps
    FOR i = 0 ..< 12 : STA keep + i : NEXT
    JSR sp_clip_edge_line
    CLC
    FOR i = 0 ..< 12 : ADC keep + i : NEXT
    STA r
    CLC : ADC sp_walk.cell : STA ccell
    LDA r : CLC : ADC #1 : CLC : ADC sp_walk.x : STA cx
    LDA r : CLC : ADC #2 : CLC : ADC sp_walk.xr : STA cxr
    LDA r : CLC : ADC #3 : CLC : ADC sp_walk.tcur : STA ctcur
    LDA r : CLC : ADC #4 : CLC : ADC sp_walk.bcur : STA cbcur
    LDA r : CLC : ADC #5 : CLC : ADC sp_walk.tmax : STA ctmax
    LDA r : CLC : ADC #6 : CLC : ADC sp_walk.bmin : STA cbmin
    LDA sp_walk.steps : CMP #3 : BEQ yes
    CMP #2 : BNE last
    LDA r : AND #7 : BEQ yes
.no CLC
    RTS
.last
    LDA r : AND #7 : CMP #1 : BNE no
.yes
    SEC
    RTS
}

\\ A chain link: A = v in; v' = 5v + 1 + byte, held in keep across next;
\\ out A = next's result plus every held byte.
MACRO LINK next, byte, n
    STA t
    ASL A : ASL A : CLC : ADC t
    SEC : ADC byte
    FOR i = 0 ..< n : STA keep + i : NEXT
    JSR next
    CLC
    FOR i = 0 ..< n : ADC keep + i : NEXT
    RTS
ENDMACRO

.sp_clip_edge_line
{
    ZA_AUTO1 t                      ; local
    ZA_AUTO 10, keep                ; local: the line and its state, live across clip_line
    LINK sp_clip_line, sp_walk.x, 10
}

.sp_clip_line
{
    ZA_AUTO1 t                      ; local
    ZA_AUTO 9, keep                 ; local: the clip cursors, live across resolve_block
    LINK sp_resolve_block, sp_walk.xr, 9
}

.sp_resolve_block
{
    ZA_AUTO1 t                      ; local
    ZA_AUTO 6, keep                 ; local: the block's differences, live across crossing
    LINK sp_crossing, sp_walk.tcur, 6
}

.sp_crossing
{
    ZA_AUTO1 t                      ; local
    ZA_AUTO 3, keep                 ; local: live across div_cols
    LINK sp_div_cols, sp_walk.bcur, 3
}

.sp_div_cols
{
    ZA_AUTO1 t                      ; local
    ZA_AUTO 4, keep                 ; local: numerator and denominator, live across mulg
    LINK sp_mulg, sp_walk.tmax, 4
}

\\ The chain's leaf: v' = 5v + 1 + (bmin EOR depth), and the stack's low water.
.sp_mulg
{
    ZA_AUTO1 t, u                   ; local
    STA t
    LDA sp_walk.bmin : EOR spike_depth : STA u
    LDA t : ASL A : ASL A : CLC : ADC t
    SEC : ADC u
    TSX : CPX spike_lows : BCS @+
    STX spike_lows
.@  RTS
}
