\\ tables.6502 - the tables, made by the loader exactly as arith.c makes
\\ them: the normalisers an octave at a time, every smooth table from a bit a
\\ delta (packed here, at assembly time, from its ideal values), lsec16's
\\ second half from logs, the quarter squares by recurrence, rpost by
\\ restoring division, and T's rows' pages.

RPOST_START = POST_NEAR DIV 8           ; rpost's first index, 32
RPOST_END = CAM_RADIUS*CAM_RADIUS DIV 8 ; its end, 200: the camera's circle
RPOST_DIVIDEND = POST_SCALE DIV 8-1     ; (see make_tables), 5119
ASSERT POST_SCALE MOD 8 == 0 AND HI(RPOST_DIVIDEND) < RPOST_START, "rpost: a byte quotient over i"

ASSERT T_ORG+SCREEN_HEIGHT DIV 4*&100 == T_JUNK_BOT, "T: four rows a page, then the junk row"

SECTION Tables
.nrm        SKIP &100                   ; b << lz(b): the byte normalised (0: unused)
.k8         SKIP &100                   ; 8 - lz(b): its bit length (0: unused)
.logf       SKIP &100                   ; 256 log2(1 + j/256)
.expf       SKIP &100                   ; 256 (2^(f/256) - 1)
.atan       SKIP &100                   ; atan of ratio byte i, in steps, floored
.lhyp       SKIP &100                   ; 256 log2 sec of the same
.sinq       SKIP &100                   ; 256 sin over the right angle (from 246, 256)
.a2c        SKIP &100                   ; view step's place -> column
.lsec16lo   SKIP &100                   ; -256 log2 cos at each step's middle: lsec,
.lsec16hi   SKIP &100                   ; then on past 45 degrees
.sq1lo      SKIP &200                   ; i*i/4
.sq1hi      SKIP &200
.sq2lo      SKIP &200                   ; (i-255)*(i-255)/4
.sq2hi      SKIP &200
.rpostmem   SKIP RPOST_END-RPOST_START  ; POST_SCALE / d2, by d2 / 8
.trowhi     SKIP SCREEN_HEIGHT+1        ; row y's page in T, to the junk row's
ENDSECTION

ASSERT HI(trowhi) == HI(trowhi+SCREEN_HEIGHT), "trowhi: within a page, so trowhi,X never crosses one"

lsec = lsec16lo                         ; its first 128: under 45 degrees, bytes
rpost = rpostmem-RPOST_START
lsx = SCRATCH_ORG                       ; the loader's, for lsec16: in Scratch, the payloads out

\\ The multiply's pointers into the quarter squares, live throughout: each
\\ at its table's page. A multiply by a puts a in sq1's low bytes and
\\ a EOR &FF in sq2's, so (ptr),Y with b in Y reads sq1[a + b] and
\\ sq2[255 - a + b] = sq1[a - b].

ZA_AUTO2 sq1loptr
ZA_AUTO2 sq1hiptr
ZA_AUTO2 sq2loptr
ZA_AUTO2 sq2hiptr

ASSERT (LO(sq1lo) OR LO(sq1hi) OR LO(sq2lo) OR LO(sq2hi)) == 0, "the quarter squares start on pages, for the pointers"

\\ The ideal values, as arith.c has them.

FUNCTION log2(x) = LN(x)/LN(2)
FUNCTION f_sinq(j) = 256*SIN(j*(PI/512))
FUNCTION f_atan(i) = ATAN((i+0.5)/256)*(512/PI)
FUNCTION f_lhyp(i) = 128*log2(1+((i+0.5)/256)*((i+0.5)/256))
FUNCTION f_logf(j) = 256*log2(1+j/256)
FUNCTION f_expf(f) = 256*(2^(f/256)-1)
FUNCTION f_lsec(i) = -256*log2(COS((i+0.5)*(PI/512)))
FUNCTION f_lsx(j)
    x = (j+0.5)*(PI/512)
= -256*log2(SIN(x)/x)
FUNCTION f_a2c(k) = 64+64*TAN((k-128+0.5)*(PI/512))

ideal_logf = ROUND(f_logf(0..255))
ideal_expf = ROUND(f_expf(0..255))
ideal_atan = FLOOR(f_atan(0..255))
ideal_lhyp = ROUND(f_lhyp(0..255))
ideal_sinq = ROUND(f_sinq(0..255))
ideal_a2c = ROUND(f_a2c(0..255))
ideal_lsec = ROUND(f_lsec(0..127))
ideal_lsx = ROUND(f_lsx(0..127))

LOG_STEP = ROUND(-256*log2(PI/1024))    ; 2137.2, for lsec16: a step's angle, its log negated

\\ A bit a delta: a table's first entry, then a bit for each delta after it,
\\ over a base for each byte of bits. The first byte holds the (n - 1) MOD 8
\\ odd deltas, under a set bit; every other, 8. A byte whose deltas fit the
\\ one before's base keeps it, so the bases run monotonically.

FUNCTION pk_deltas(v) = v[1..]-v[..LEN(v)-2]

FUNCTION pk_groups(d, k, nb, b)
    IF b == nb
        r = {}
    ELIF b == 0
        r = CONCAT({d[0..<k]}, pk_groups(d, k, nb, 1))
    ELSE
        r = CONCAT({d[k+8*(b-1)..<k+8*b]}, pk_groups(d, k, nb, b+1))
    ENDIF
= r

FUNCTION pk_bases(gs, i, prev, has)
    IF i == LEN(gs)
        r = {}
    ELSE
        g = gs[i]
        IF LEN(g) == 0
            b = 0
        ELIF has AND prev <= MIN(g) AND MAX(g) <= prev+1
            b = prev
        ELSE
            b = MIN(g)
        ENDIF
        r = CONCAT(b, pk_bases(gs, i+1, b, LEN(g) > 0))
    ENDIF
= r

FUNCTION pk_bits(gs, bs, k, i)
    IF i == LEN(gs)
        r = {}
    ELSE
        g = gs[i]
        IF LEN(g) == 0
            bb = 0
        ELSE
            ASSERT MIN(g) >= bs[i] AND MAX(g) <= bs[i]+1, "a delta off its byte's base"
            bb = SUM((g > bs[i])*(1 << (0..<LEN(g))))
        ENDIF
        r = CONCAT(bb+(i == 0)*(1 << k), pk_bits(gs, bs, k, i+1))
    ENDIF
= r

\\ The first entry a byte of bits makes: the first byte's deltas make 1 to
\\ k, and byte b's the 8 after k + 8(b - 1).

FUNCTION pk_entry(k, b)
    IF b == 0
        e = 1
    ELSE
        e = k+8*(b-1)+1
    ENDIF
= e

\\ A table's packing, from its ideal values v: the deltas by byte, the
\\ bytes' bases, and the bytes of bits, stored last first.

FUNCTION pk_k(v) = (LEN(v)-1) MOD 8
FUNCTION pk_nb(v) = (LEN(v)-1) DIV 8+1
FUNCTION pk_gs(v) = pk_groups(pk_deltas(v), pk_k(v), pk_nb(v), 0)
FUNCTION pk_bs(v) = pk_bases(pk_gs(v), 0, 0, FALSE)
FUNCTION pk_packed(v) = REVERSE(pk_bits(pk_gs(v), pk_bs(v), pk_k(v), 0))

\\ Unpack table from its ideal values v, its bits PACKed at bits, as
\\ beebdoom does. X counts the bytes of bits down, and the set bit, carried
\\ round in C, empties each in turn. A byte's base comes from compares, not
\\ a table: the bases only run one way, so each step is 1 more for the bytes
\\ before it (falling: CPX on the byte) or the entries after it (rising: CPY
\\ on the entry). The compare also clears the carry from the sine's 255 to
\\ 256.

MACRO UNPACK table, v, bits
    k = pk_k(v)
    nb = pk_nb(v)
    bs = pk_bs(v)
    blo = MIN(bs)
    bhi = MAX(bs)
    falling = MIN(bs[..nb-2]-bs[1..]) >= 0
    ASSERT falling OR MAX(bs[..nb-2]-bs[1..]) <= 0, "UNPACK: the bases must run one way"
    ASSERT blo < bhi OR MAX(v) <= 255, "UNPACK: a wrap needs a compare to clear its carry"

    LDA #v[0]:LDY #0:LDX #nb-1
    CLC:BCC store                       ; (always)
    ZA_UNREACHABLE
.loop
    ADC #blo                            ; the delta's bit, over the least base
    FOR t = blo+1..<bhi+1
        IF falling
            CPX #nb-SUM((bs >= t)*1):ADC #0
        ELSE
            CPY #pk_entry(k, FIND((bs >= t)*1, 1)):ADC #0
        ENDIF
    NEXT
.store
    STA table,Y:INY
.next
    ROR bits,X:BNE loop                 ; the next delta's bit, or the set bit
    DEX:BPL next                        ; the set bit, in C, goes on
ENDMACRO

\\ A table's bits, packed from its ideal values v, for UNPACK, which shifts
\\ them out.

MACRO PACK v
    EQUB pk_packed(v)
ENDMACRO

\\ Make every table, as arith.c does.

.make_tables
{
    \\ the normalisers, an octave at a time: the bytes of bit length k
    \\ normalise to 128 on, in steps of 2^(8 - k)

    ZA_AUTO1 step                       ; local: 2^(8 - k)

    LDA #0:STA nrm:STA k8
    LDX #1:LDY #1
    LDA #128:STA step
.octave
    LDA #128
.bytes
    STA nrm,X
    PHA:TYA:STA k8,X:PLA
    INX
    CLC:ADC step
    BCC bytes
    INY
    LSR step
    CPX #0
    BNE octave

    \\ the tables of a bit a delta

    UNPACK logf, ideal_logf, bits_logf
    UNPACK expf, ideal_expf, bits_expf
    UNPACK atan, ideal_atan, bits_atan
    UNPACK lhyp, ideal_lhyp, bits_lhyp
    UNPACK sinq, ideal_sinq, bits_sinq
    UNPACK a2c, ideal_a2c, bits_a2c
    UNPACK lsec, ideal_lsec, bits_lsec
    UNPACK lsx, ideal_lsx, bits_lsx

    \\ lsec16 past 45 degrees, from logs: LOG_STEP - log2(2j + 1) + lsx[j] at
    \\ 255 - j, log2 of a byte as pt_log2_8 has it; under 45, high bytes of 0

    ZA_AUTO1 logfrac                    ; local: log2(2j + 1)'s fraction
    ZA_AUTO1 logk8                      ; local: its whole part + 1
    ZA_AUTO2 lsecv                      ; local: the entry

    LDY #127
.lsec16
    TYA:ASL A:ORA #1:TAX                ; 2j + 1
    LDA k8,X:STA logk8
    LDA nrm,X:ASL A:TAX
    LDA logf,X:STA logfrac
    TYA:EOR #&FF:TAX                    ; 255 - j
    SEC
    LDA #LO(LOG_STEP+&100):SBC logfrac:STA lsecv
    LDA #HI(LOG_STEP+&100):SBC logk8:STA lsecv+1
    CLC
    LDA lsecv:ADC lsx,Y:STA lsec16lo,X
    LDA lsecv+1:ADC #0:STA lsec16hi,X
    LDA #0:STA lsec16hi,Y
    DEY
    BPL lsec16

    \\ the quarter squares, x*x DIV 4 for x = 0..511, in one loop over two
    \\ pages (as starglobe's): sq1[x + 1] = sq1[x] + (x + 1) DIV 2, delta
    \\ stepped on even x. Then sq2[x] = sq1[255 - x], and sq1[x - 255] past
    \\ 255, X counting up as Y counts down

    ZA_AUTO2 quarter                    ; local: x*x DIV 4
    ZA_AUTO1 delta                      ; local: (x + 1) DIV 2

    LDX #0
    STX quarter:STX quarter+1
    STX delta
    LDY #2                              ; pages
.sq1
    LDA quarter+1
.sq1h
    STA sq1hi,X                         ; the operand's high byte steps on
    LDA quarter
.sq1l
    STA sq1lo,X                         ; likewise
    CLC:ADC delta:STA quarter
    BCC @+:INC quarter+1:.@
    TXA:LSR A:BCS @+:INC delta:.@       ; delta steps on even x
    INX
    BNE sq1
    INC sq1h+2
    INC sq1l+2
    DEY
    BNE sq1
    DEY                                 ; X = 0, Y = 255
.sq2
    LDA sq1lo,X:STA sq2lo,Y             ; sq2[255 - x] = sq1[x]
    LDA sq1hi,X:STA sq2hi,Y
    LDA sq1lo+1,X:STA sq2lo+&100,X      ; sq2[256 + x] = sq1[x + 1]
    LDA sq1hi+1,X:STA sq2hi+&100,X
    DEY
    INX
    BNE sq2

    \\ the multiply's pointers: each table's page, the low bytes 0 (X is)

    STX sq1loptr:STX sq1hiptr:STX sq2loptr:STX sq2hiptr
    LDA #HI(sq1lo):STA sq1loptr+1
    LDA #HI(sq1hi):STA sq1hiptr+1
    LDA #HI(sq2lo):STA sq2loptr+1
    LDA #HI(sq2hi):STA sq2hiptr+1

    \\ rpost: (POST_SCALE + d - 1) DIV d for d = 8i, i from RPOST_START,
    \\ which is 1 + RPOST_DIVIDEND DIV i: a byte divisor, so the remainder
    \\ (under i) lives in A, the carry out of ROL A its ninth bit, as beebdoom
    \\ divides. The quotient shifts in behind the dividend's low byte, and the
    \\ SEC, out of the last ROL, adds the 1

    ZA_AUTO1 divisor                    ; local: i
    ZA_AUTO1 quotient                   ; local: the dividend's low byte, then the quotient

    LDX #RPOST_START
.posts
    STX divisor
    LDA #LO(RPOST_DIVIDEND):STA quotient
    LDA #HI(RPOST_DIVIDEND)             ; the remainder: 19, under i
    LDY #8
    SEC
.divide
    ROL quotient                        ; the dividend's next bit out, the last quotient bit in
    ROL A
    BCS goes                            ; 256 or more: over i
    CMP divisor
    BCC under
.goes
    SBC divisor
    SEC                                 ; the quotient's bit
.under
    DEY
    BNE divide
    ROL quotient                        ; its last bit in, the SEC out
    LDA quotient:ADC #0
    STA rpost,X
    INX
    CPX #RPOST_END
    BNE posts

    \\ T's rows' pages, for the plotters (T's the one buffer): row y's is
    \\ T's plus y DIV 4, four rows to a page, 64 the junk row's

    LDX #SCREEN_HEIGHT
.trows
    TXA:LSR A:LSR A
    CLC:ADC #HI(T_ORG)
    STA trowhi,X
    DEX
    BPL trows
    RTS
}

\\ The tables' bits, for make_tables to unpack (and empty).

.bits_logf
    PACK ideal_logf
.bits_expf
    PACK ideal_expf
.bits_atan
    PACK ideal_atan
.bits_lhyp
    PACK ideal_lhyp
.bits_sinq
    PACK ideal_sinq
.bits_a2c
    PACK ideal_a2c
.bits_lsec
    PACK ideal_lsec
.bits_lsx
    PACK ideal_lsx
