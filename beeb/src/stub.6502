\ **************************************************************************
\ *
\ *     stub.6502 - the loader's entry (PLAN.md section 3.3)
\ *
\ **************************************************************************
\
\ With the OS still alive, flush its buffers. Then take the machine over:
\ no interrupts, the display set up as spritescale sets it (CRTC, ULA,
\ VIAs) showing buffer A with every colour black, so whatever the load
\ left there stays unseen, and the vectors pointed at the program. Last,
\ copy the payload down to &300 and start it. The copy goes upwards and
\ the destination lies &F00 below the source, so no byte is overwritten
\ before it is read, and the page-rounded overrun stops well short of
\ the stub.

{
    ZA_ENTRY
    LDA #15 : LDX #0 : JSR &FFF4    ; *FX15,0: flush every buffer (silences sound)
    SEI
    LDA #&7F
    STA &FE4E : STA &FE6E           ; no interrupts from either VIA
    STA &FE4D : STA &FE6D           ; and none pending
    STA &FE43                       ; keyboard port A: bit 7 an input
    LDA #&0F : STA &FE42            ; port B drives the addressable latch
    LDA #3 : STA &FE40              ; latch bit 3 low: keyboard auto-scan off
    LDA #&04 : STA &FE4C

    LDX #15                         ; every palette entry black: logical i
.black
    TXA                             ; to physical 0 (stored EOR 7)
    ASL A : ASL A : ASL A : ASL A
    ORA #7
    STA &FE21
    DEX : BPL black
    LDA #&C4 : STA &FE20
    LDX #13
.crtc
    STX &FE00
    LDA crtcregs,X : STA &FE01
    DEX : BPL crtc

    LDA #LO(irq) : STA &204 : LDA #HI(irq) : STA &205
    LDA #LO(trap) : STA &202 : LDA #HI(trap) : STA &203

    LDY #0
    LDX #HI(entry - payload + &FF)
.copy
    LDA payload,Y : STA CODE_ORG,Y
    INY : BNE copy
    INC copy + 2 : INC copy + 5
    DEX : BNE copy
    LDX #&FF : TXS
    JMP start

\ spritescale's CRTC set-up: 32 characters of 8 scanlines by 16 rows, a
\ 128 x 128 pixel MODE 5 screen, starting at buffer A
.crtcregs
    EQUB 63, 32, 45, &24, 38, 0, 16, 26, 0, 7, 32, 8, HI(BUF_A DIV 8), LO(BUF_A DIV 8)
}
