\ bss.6502 (test) - the harness's own state, after the release BSS

.spike_out SKIP 16                  ; the spike's results (spike.6502)

\ check S2 (s2.6502): the host's arguments...
.s2_fn SKIP 1                       ; the routine (S2_*)
.s2_mode SKIP 1                     ; 0 counter, 1 random; +&80 skip the call
.s2_start SKIP 4                    ; the first counter value, or the seed
.s2_count SKIP 4                    ; cases
\ ...the run's state...
.s2_left SKIP 4                     ; cases still to go
.s2_vec SKIP 2                      ; the driver
\ ...and the results
.s2_calls SKIP 4                    ; the cases used
.s2_out SKIP 2                      ; the CRC
.s2_last SKIP 4                     ; the last case's outputs

\ check S3 (s3.6502): the plots' patterns, two a plot
.s3_pat SKIP 256

\ check S4 (s4.6502): each pool's image CRC and plot microseconds
.s4_out SKIP 4 * S4_MAX

\ checks S5 and S5u (s5.6502): a replayed call's context, line, arguments and results
.rp_pool SKIP 1                     ; pool_last
.rp_cx SKIP 35
.rp_line SKIP 7
.rp_args SKIP 4
.rp_out SKIP 2
.rp_cam SKIP 9                      ; the record's CAM (for transform)
.rp_buf SKIP 40                     ; the arguments, as the record has them (make_line on)
.rp_res SKIP 41                     ; the results, likewise
.s5t_out SKIP 2 * S5T_MAX           ; check S5: each pose's CRC of its view vertices
