MAP_VERTS = LEN(map_vert_x)
MAP_CELLS = LEN(map_cell_first)
MAP_EDGES = LEN(map_edge_angle)
MAP_SIDES = LEN(map_side_v)
MAP_SPRITES = LEN(map_sprite_x)
MAP_ARTS = LEN(map_art_e) DIV 8
MAP_SHADES = LEN(map_shade_even)

\\ The tables. A portal's entry is the side after its twin, the side across it, where a walk
\\ through it begins; a wall's is 0, never read. An art's patterns are by art * 8 + colour
\\ code, 0 transparent; its data is by art_lo and art_hi. A shade's patterns are palette.c's,
\\ the even scanlines' and the odd's.

    FITPAGE MAP_VERTS
.vert_xlo        EQUB LO(map_vert_x)
    FITPAGE MAP_VERTS
.vert_xhi        EQUB HI(map_vert_x)
    FITPAGE MAP_VERTS
.vert_ylo        EQUB LO(map_vert_y)
    FITPAGE MAP_VERTS
.vert_yhi        EQUB HI(map_vert_y)

    FITPAGE MAP_CELLS+1
.cell_first      EQUB map_cell_first, MAP_SIDES
    FITPAGE MAP_CELLS
.cell_floorz     EQUB map_cell_floorz
    FITPAGE MAP_CELLS
.cell_ceilz      EQUB map_cell_ceilz
    FITPAGE MAP_CELLS
.cell_floor      EQUB map_cell_floor
    FITPAGE MAP_CELLS
.cell_ceil       EQUB map_cell_ceil
    FITPAGE MAP_CELLS
.cell_sprite     EQUB map_cell_sprite

    FITPAGE MAP_EDGES
.edge_angle      EQUB map_edge_angle
    FITPAGE MAP_EDGES
.edge_colour     EQUB map_edge_colour
    FITPAGE MAP_EDGES
.edge_len8       EQUB map_edge_len8

    FITPAGE MAP_SIDES
.side_v          EQUB map_side_v
    FITPAGE MAP_SIDES
.side_edge       EQUB map_side_edge
    FITPAGE MAP_SIDES
.side_adj        EQUB map_side_adj
    FITPAGE MAP_SIDES
.side_anghi      EQUB map_side_anghi
    FITPAGE MAP_SIDES
.side_entry      EQUB map_side_entry

    FITPAGE MAP_SPRITES
.sprite_xlo      EQUB LO(map_sprite_x)
    FITPAGE MAP_SPRITES
.sprite_xhi      EQUB HI(map_sprite_x)
    FITPAGE MAP_SPRITES
.sprite_ylo      EQUB LO(map_sprite_y)
    FITPAGE MAP_SPRITES
.sprite_yhi      EQUB HI(map_sprite_y)
    FITPAGE MAP_SPRITES
.sprite_art      EQUB map_sprite_art
    FITPAGE MAP_SPRITES
.sprite_lslo     EQUB LO(map_sprite_ls)
    FITPAGE MAP_SPRITES
.sprite_lshi     EQUB HI(map_sprite_ls)

    FITPAGE MAP_SHADES
.shade_even      EQUB map_shade_even
    FITPAGE MAP_SHADES
.shade_odd       EQUB map_shade_odd

    FITPAGE LEN(map_art_e)
.art_pate        EQUB map_art_e
    FITPAGE LEN(map_art_o)
.art_pato        EQUB map_art_o
    FITPAGE MAP_ARTS
.art_lo          EQUB LO({art0})
    FITPAGE MAP_ARTS
.art_hi          EQUB HI({art0})
    FITPAGE LEN(map_art0)
.art0            EQUB map_art0
