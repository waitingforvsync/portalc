\ **************************************************************************
\ *
\ *     scratch.6502 - the capture's own state (D13)
\ *
\ **************************************************************************
\
\ What only the capture uses, so nothing it holds lives past the plot. A
\ visit (render.c's pt_visit) is a field a table, by visit: VISITS of each,
\ a visit a cell at most (0 is the C's null visit, and the scratch record
\ for a cell walked over the same columns twice). Nine tables fill each of
\ A's junk rows and p_next fills the one above B: only the plotters write
\ them, overrunning into them after the capture's done with them. The
\ other eleven tables, cell_visit and the pending stack are the spill: it
\ shares its BSS with the sprite pass's own state, which only comes to
\ life after the plot (bss.6502's overlap), so it's set up afresh every
\ capture too (cell_visit is zeroed at its start).

VISITS = MAP_NUM_CELLS          ; visits a frame can have, the null one included

SECTION Junk0, org = JUNK0, guard = JUNK0 + &100    ; (labels over the Screens' junk rows)
.vs_cell SKIP VISITS            ; the cell
.vs_k   SKIP VISITS             ; the current edge, as a ring index
.vs_x   SKIP VISITS             ; where the next edge's span starts
.vs_xr  SKIP VISITS             ; the portal's right column; 0 until first walked
.vs_tcur SKIP VISITS            ; the top and bottom bounds: chains of pieces, each
.vs_bcur SKIP VISITS            ; cursor at or before column x
.vs_tmax SKIP VISITS            ; the bounds' conservative row extents
.vs_bmin SKIP VISITS
.vs_inst SKIP VISITS            ; the cell's sprite instance this frame, 0 = none
ENDSECTION

SECTION Junk1, org = JUNK1, guard = JUNK1 + &100
.vs_act SKIP PT_NUM_SLOTS * VISITS  ; the last piece of each of edge k's lines: a table a
                                    ; slot, vs_act + slot * VISITS (0 = none yet)
.vs0_xl SKIP VISITS             ; the current edge's start vertex (pt_vv): depth...
.vs0_xh SKIP VISITS
.vs0_yl SKIP VISITS             ; ...lateral...
.vs0_yh SKIP VISITS
.vs0_sx SKIP VISITS             ; ...column...
ENDSECTION

SECTION Junk2, org = JUNK2, guard = JUNK2 + &100
.p_next SKIP 256                ; each piece's next in its chain, 0 = the end (the plot and
                                ; the sprite pass read pieces, not chains)
ENDSECTION

SECTION Spill, org = overlap, guard = overlap_end   ; (over the sprite pass's own state)
.vs0_fl SKIP VISITS             ; ...flags...
.vs0_f  SKIP VISITS             ; ...and its depth's reciprocal
.vs0_e  SKIP VISITS
.vs1_xl SKIP VISITS             ; its end vertex, likewise
.vs1_xh SKIP VISITS
.vs1_yl SKIP VISITS
.vs1_yh SKIP VISITS
.vs1_sx SKIP VISITS
.vs1_fl SKIP VISITS
.vs1_f  SKIP VISITS
.vs1_e  SKIP VISITS
.cell_visit SKIP MAP_NUM_CELLS  ; each cell's visit, 0 = none yet
.pend   SKIP PT_MAX_PEND        ; the walked portals' instances, by nesting
.in_segt SKIP PT_MAX_INSTS      ; an instance's last segment so far, and the one before
.in_prev SKIP PT_MAX_INSTS      ; it in the draw order (the sprite pass only goes forward)
ENDSECTION
