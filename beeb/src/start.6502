\\ start.6502 - the engine, from sideways RAM: the main loop.

\\ Clear T and the screens and ready the map, then draw frame after frame into the buffer not on
\\ show, each shown at the vsync after it's done. It never returns.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     none

.start
{
    JSR clear_buffers
    JSR map_init

.frame
    JSR update_camera
    JSR capture

    \\ the last frame on show, so this one can draw over the buffer it left

.wait
    LDA request_swap:BNE wait

    JSR fill
    JSR sprites

    \\ show it at the next vsync, and clear T while that's pending: the unplot only touches T

    LDA #1:STA request_swap
    JSR unplot
    JMP frame
}
