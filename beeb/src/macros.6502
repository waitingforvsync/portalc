\\ macros.6502 - macros for any file.

\\ Start a table on the next page if it would cross into it: an indexed read across a page costs a
\\ cycle.
\\
\\ Inputs:
\\     size: the table's bytes
\\
\\ Outputs:
\\     P%: on to the next page, if need be

MACRO FITPAGE size
    IF (P% AND &FF)+size > &100
        ALIGN &100
    ENDIF
ENDMACRO

\\ FITPAGE from a base before the table, as table-8,Y reads one: the bytes from the base in one
\\ page, so no read crosses from the base's.
\\
\\ Inputs:
\\     offset: the base, from the table: 0 or less (-8 for table-8)
\\     size: the bytes from the base, the table's last included
\\
\\ Outputs:
\\     P%: on, if need be, to put the base at the next page's start

MACRO FITPAGE_FROM offset, size
    ASSERT offset <= 0 AND size > -offset AND size <= &100, "FITPAGE_FROM: base and table, a page"
    IF ((P%+offset) AND &FF)+size > &100
        SKIP &100-((P%+offset) AND &FF)
    ENDIF
ENDMACRO

\\ Check that the branch just assembled stays on its page when taken: across one, it costs a cycle.
\\ For the hot loops' branches.
\\
\\ Inputs:
\\     target: where it branches to
\\
\\ Outputs:
\\     none: an error if it crosses

MACRO SAME_PAGE target
    ASSERT HI(target) == HI(P%), "a hot branch crosses a page"
ENDMACRO
