\ **************************************************************************
\ *
\ *     hw.6502 - the vsync IRQ, the clock and the palette
\ *
\ **************************************************************************
\
\ The IRQ is spritescale's (acknowledge CA1, count), with the buffer swap
\ moved in (PLAN.md section 4.1). scrnbase is the page of the buffer being
\ drawn; the main loop sets swapreq when it's done, and the IRQ shows it,
\ writing R12 (scrnbase DIV 8) in the vertical blank, where the 6845
\ latches it for the frame about to start, so a swap can never tear. Then
\ it turns scrnbase to the other buffer, now free, and clears swapreq.
\ Test builds also keep a microsecond clock off the user VIA's T2.

\ State the IRQ shares with the main loop: single bytes, except the clock,
\ which is read with interrupts off. (ZA_INTERRUPT on irq keeps each of
\ these on a byte of its own.) Comments say who writes and who reads.
ZA_AUTO1 vsyncs                 ; IRQ writes: vsyncs counted, wrapping; main reads
ZA_AUTO1 swapreq                ; main sets 1 to post a swap, IRQ clears it once shown
ZA_AUTO1 scrnbase               ; the buffer to draw into, its first page: IRQ turns it at a swap
ZA_AUTO1 swapstamp              ; IRQ writes: vsyncs when the last swap was shown
IF HARNESS
    ZA_AUTO 4, usecs            ; IRQ writes: microseconds up to t2last; now reads
    ZA_AUTO2 t2last             ; IRQ writes: T2 when the clock last caught up; now reads
ENDIF

.irq
{
    ZA_INTERRUPT
    LDA #&02 : STA &FE4D            ; acknowledge vsync (CA1)
IF HARNESS
    ZA_AUTO1 hi, lo             ; local: T2 read consistently
    ZA_AUTO1 d0, d1             ; local: T2 counted since last time
    ; the clock: T2 counts down at 1MHz from &FFFF and on past zero; add
    ; what it has counted since last time (A only: the OS saved no more)
.t2read
    LDA &FE69 : STA hi
    LDA &FE68 : STA lo
    LDA &FE69 : CMP hi : BNE t2read   ; the high byte moved: read again
    SEC
    LDA t2last : SBC lo : STA d0
    LDA t2last + 1 : SBC hi : STA d1
    CLC
    LDA usecs : ADC d0 : STA usecs
    LDA usecs + 1 : ADC d1 : STA usecs + 1
    LDA usecs + 2 : ADC #0 : STA usecs + 2
    LDA usecs + 3 : ADC #0 : STA usecs + 3
    LDA lo : STA t2last
    LDA hi : STA t2last + 1
ENDIF
    INC vsyncs
    LDA swapreq : BEQ out
    LDA #12 : STA &FE00
    LDA scrnbase : LSR A : LSR A : LSR A : STA &FE01    ; show it (R13 is 0 for both)
    LDA scrnbase : EOR #(HI(BUF_A) EOR HI(BUF_B)) : STA scrnbase    ; and draw into the other
    LDA vsyncs : STA swapstamp
    LDA #0 : STA swapreq            ; the old front buffer is free
.out
    LDA &FC
    RTI
}

IF HARNESS
\\ The clock now: microseconds since start, read with interrupts off.
\\ out: now.t (4 bytes)
.now
{
    ZA_AUTO 4, t                ; out: microseconds since start
    ZA_AUTO1 hi, lo             ; local: T2 read consistently
    SEI
.t2read
    LDA &FE69 : STA hi
    LDA &FE68 : STA lo
    LDA &FE69 : CMP hi : BNE t2read
    SEC
    LDA t2last : SBC lo : STA t
    LDA t2last + 1 : SBC hi : STA t + 1
    CLC
    LDA usecs : ADC t : STA t
    LDA usecs + 1 : ADC t + 1 : STA t + 1
    LDA usecs + 2 : ADC #0 : STA t + 2
    LDA usecs + 3 : ADC #0 : STA t + 3
    CLI
    RTS
}
ENDIF

\ The screen colours: logical 0..3 are black, blue, red and green (the
\ ULA stores the physical colour EOR 7), as spritescale sets them.
physcols = {0, 4, 1, 2}
.paldata
    EQUB (0..15) * 16 + (physcols[(0..15) DIV 8 * 2 + (0..15) DIV 2 MOD 2] EOR 7)

\\ Zero whole pages [A, X) (X = 0 means up to &FFFF + 1).
.zero_pages
{
    ZA_AUTO2 p                  ; local: the page being zeroed (in: A, X)
    ZA_AUTO1 last               ; local: X, the page to stop at
    STA p + 1
    STX last
    LDA #0 : STA p
    TAY
.pg
    STA (p),Y
    INY : BNE pg
    INC p + 1
    LDX p + 1
    CPX last : BNE pg
    RTS
}

\\ BRK lands here through BRKV (best effort: the OS's BRK path runs first).
.trap
{
    ZA_INTERRUPT                    ; via BRKV: a BRK can land anywhere
    LDA #&FF : STA MB_ERR
IF HARNESS
    LDA MB_SEQ : STA MB_ACK         ; tell the host now
ENDIF
.spin
    JMP spin
}
