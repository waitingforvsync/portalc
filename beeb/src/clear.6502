\\ clear.6502 - clearing T and the screens: T must start each frame empty.

ASSERT LO(T_JUNK_TOP) == 0 AND T_JUNK_BOT+&100 == SCREEN_A, "T: whole pages, up to screen A"
ASSERT SCREEN_A+&1000 == SCREEN_B AND SCREEN_B+&1000 == &8000, "the screens: up to &8000"

\\ Clear T, its junk rows and both screens, then turn the display on.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     T_JUNK_TOP to &8000: all 0

.clear_buffers
{
    LDA #HI(T_JUNK_TOP):STA loop+2
    LDA #0:TAY
    LDX #HI(&8000-T_JUNK_TOP)           ; pages
.loop
    STA T_JUNK_TOP,Y
    INY
    BNE loop
    INC loop+2                          ; the operand's high byte
    DEX
    BNE loop

    \\ the display on

    LDA #8:STA &FE00                    ; CRTC R8
    LDA #&C0:STA &FE01                  ; display on, cursor off
    RTS
}
