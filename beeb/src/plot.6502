\ **************************************************************************
\ *
\ *     plot.6502 - the line plotters (render.c's plot; spec 8.1)
\ *
\ **************************************************************************
\
\ plot EORs every coloured piece of the pool into a buffer, from pool_last
\ down to 1 (EOR commutes, so the order is free). A piece is a line from
\ (x0, y0) to just before x1, its gradient a sign and a u7.8 magnitude in
\ rows a column, its colour the patterns ce and co. Each kind has its
\ plotter:
\
\   flat (g = 0)       one row: the end bytes masked, whole bytes between
\   shallow (|g| < 1)  whole bytes through the carry tree, the partial bytes
\                      at either end a pixel at a time
\   steep (|g| >= 1)   a pixel pair a column, then the gradient's whole rows
\                      and the fraction's carry
\
\ Rows round to nearest: a piece's fraction (p_yf) has the half in it
\ already, and the clip compared exactly these rows. A rising line keeps
\ 255 minus its fraction, so its borrows are carries, and it runs the
\ falling line's code moving up instead of down. Between steps C is always
\ clear: nothing re-clears it inside a loop.

ZA_AUTO1 pool_last              ; the pool's last piece, 0 = empty (the C's pool_num - 1)

\ The pixels from p to the byte's right end, and from its left end to p.
.mask_from
    EQUB &FF, &77, &33, &11
.mask_to
    EQUB &88, &CC, &EE, &FF

\ A row down from an even scanline to the next even one. Clobbers C.
MACRO DOWNE c
    INY : INY
    CPY #8 : BNE same
    LDY #0
    INC c + 1
.same
ENDMACRO

\ A row up from an even scanline to the row above's even one.
MACRO UPE c
    DEY : DEY
    BPL same
    LDY #6
    DEC c + 1
.same
ENDMACRO

\ A row on from the odd scanline ROW leaves: down a falling line, up a
\ rising one. C kept.
MACRO MOVE dir
    IF dir == 1
        DOWN c
    ELSE
        UP c
    ENDIF
ENDMACRO

\ plot's own from here: they work on its locals.

\ n pixels a column at a time from the cursor, under mask m, the row moving
\ on with each step's carry. C clear in and out, Y even.
MACRO PIXELS dir
.pixel
    ROW c, m, pe, po
    LDA f : ADC gm : STA f      ; the step's carry: the next column a row on
    BCC same
    MOVE dir
    BCS right                   ; (always: MOVE keeps C)
.same
    DEY                         ; back to the row's even scanline
.right
    LSR m : BCC on              ; the mask along the byte...
    LDA #&88 : STA m            ; ...and past its last pixel,
    LDA c : ADC #7 : STA c      ; the next block: + 8 with the carry, which it clears
.on
    DEC n : BNE pixel
ENDMACRO

\ n whole bytes from a byte's start (render.c's byte_down and byte_up, and
\ JOURNAL.md's sketch). The byte's three inner steps pick, carry by carry,
\ one of eight leaves with its masks as constants; the fourth is taken
\ before plotting, and its carry rides through ROW and MOVE to the tail.
\ Each step's carry-in is known, so a step with C set adds gm - 1. C clear
\ in and out, Y even.
MACRO BYTES dir
    BCC byte                    ; (always)
.tail                           ; Y on the last row's odd scanline, C the 4th step's carry
    BCS step
    DEY                         ; the next byte starts on this row
    LDA c : ADC #8 : STA c      ; the next block (C clear, and left clear)
    DEC n : BNE byte
    JMP done
.step
    MOVE dir                    ; the next byte starts a row on
    LDA c : ADC #7 : STA c      ; + 8 with the carry, which it clears
    DEC n : BNE byte
    JMP done
.byte                           ; C clear
    LDA f
    ADC gm : BCS t1             ; step 1's carry: pixel 1 is a row on
    ADC gm : BCS t01            ; step 2
    ADC gm : BCS c001           ; step 3
    ADC gm : STA f              ; 000; step 4
    ROW c, #&FF, pe, po
    JMP tail
.t1 JMP c1                      ; (out of branch range)
.t01 JMP c01
.c001
    ADC gmm1 : STA f            ; C set: + gm
    ROW c, #&EE, pe, po : MOVE dir : ROW c, #&11, pe, po
    JMP tail
.c01
    ADC gmm1 : BCS c011
    ADC gm : STA f              ; 010
    ROW c, #&CC, pe, po : MOVE dir : ROW c, #&33, pe, po
    JMP tail
.c011
    ADC gmm1 : STA f
    ROW c, #&CC, pe, po : MOVE dir : ROW c, #&22, pe, po : MOVE dir : ROW c, #&11, pe, po
    JMP tail
.c1
    ADC gmm1 : BCS t11
    ADC gm : BCS c101
    ADC gm : STA f              ; 100
    ROW c, #&88, pe, po : MOVE dir : ROW c, #&77, pe, po
    JMP tail
.t11 JMP c11
.c101
    ADC gmm1 : STA f
    ROW c, #&88, pe, po : MOVE dir : ROW c, #&66, pe, po : MOVE dir : ROW c, #&11, pe, po
    JMP tail
.c11
    ADC gmm1 : BCS c111
    ADC gm : STA f              ; 110
    ROW c, #&88, pe, po : MOVE dir : ROW c, #&44, pe, po : MOVE dir : ROW c, #&33, pe, po
    JMP tail
.c111
    ADC gmm1 : STA f
    ROW c, #&88, pe, po : MOVE dir : ROW c, #&44, pe, po : MOVE dir : ROW c, #&22, pe, po
    MOVE dir : ROW c, #&11, pe, po
    JMP tail
.done
ENDMACRO

\ A shallow line: the head's pixels to the first byte boundary, the whole
\ bytes, then the tail's pixels; n, nb and nt count them. C clear in.
MACRO SHALLOW dir
    LDA n : BEQ bytes
    PIXELS dir
.bytes
    LDA nb : BNE whole
    JMP tail                    ; (the tree is out of branch range)
.whole
    STA n
    BYTES dir
.tail
    LDA nt : BEQ done
    STA n
    PIXELS dir
.done
ENDMACRO

\ A steep line, n columns: a pixel pair, then gi whole rows and the
\ fraction's carry, the first from ROW's odd scanline. C clear in, Y even.
MACRO STEEP dir
.column
    ROW c, m, pe, po
    LDX gi                      ; the whole rows...
    LDA f : ADC gm : STA f
    BCC rows
    INX                         ; ...and the fraction's carry
.rows
    MOVE dir
    DEX : BEQ right
.more
    IF dir == 1
        DOWNE c
    ELSE
        UPE c
    ENDIF
    DEX : BNE more
.right
    LSR m : BCC on              ; a pixel right
    LDA #&88 : STA m
    LDA c : ADC #7 : STA c      ; C set by the LSR: + 8, and clear after
.on
    DEC n : BNE column
ENDMACRO

\\ Plot the pool into the buffer scrnbase names.
\\ in: pool_last and the pool. Clobbers everything.
.plot
{
    ZA_AUTO2 c                  ; local: the cursor
    ZA_AUTO1 i                  ; local: the piece
    ZA_AUTO1 x0, x1, gh         ; local: its columns and its gradient's sign and whole rows
    ZA_AUTO1 pe, po             ; local: its patterns
    ZA_AUTO1 f, gm, gmm1, gi    ; local: the row fraction, its step, step - 1, whole rows
    ZA_AUTO1 m, m1              ; local: a pixel's mask; a flat line's last byte's
    ZA_AUTO1 n, nb, nt          ; local: pixels (or bytes) to go; whole bytes; tail pixels
    LDX pool_last : BNE piece
    RTS
.next
    LDX i : DEX : BNE piece
    RTS
.piece
    STX i
    LDA p_ce,X : STA pe
    ORA p_co,X : BEQ next       ; no colour: a bound only
    LDA p_co,X : STA po
    LDA p_ghi,X : STA gh : BMI place    ; rising: always plotted
    LDA p_y0,X : CMP #64 : BCS next     ; on the bottom edge, not rising: all below
.place
    LDA p_yf,X : STA f          ; the row's fraction, as the clip had it
    LDA p_glo,X : STA gm
    LDA p_x1,X : STA x1
    LDA p_x0,X : STA x0
    AND #3 : TAY
    LDA pixmasks,Y : STA m
    LDA p_y0,X
    LDX x0
    AT c, scrnbase
    LDA gh : AND #&7F : BNE tosteep
    LDA gm : BNE shallow
    JMP flat
.tosteep
    JMP steep

.shallow
    LDX gm : DEX : STX gmm1
    LDA x0 : EOR #&FF : CLC : ADC #1 : AND #3 : STA n   ; the head: to the byte's end
    LDA x1 : SEC : SBC x0       ; pixels...
    SEC : SBC n : BCS split     ; ...after the head
    ADC n : STA n               ; fewer than the head: it's all head (C clear: A = pixels)
    LDA #0
.split
    STA nb
    AND #3 : STA nt             ; the tail's pixels
    LSR nb : LSR nb             ; the whole bytes
    CLC
    BIT gh : BPL fshallow
    JMP sshallow                ; (out of branch range)
.fshallow
    SHALLOW 1
    JMP next
.sshallow
    LDA f : EOR #&FF : STA f    ; 255 - f: the borrows as carries
    SHALLOW 0
    JMP next

.steep
    STA gi
    LDA x1 : SEC : SBC x0 : STA n   ; columns
    CLC
    BIT gh : BMI ssteep
    STEEP 1
    JMP next
.ssteep
    LDA f : EOR #&FF : STA f    ; 255 - f: the borrows as carries
    STEEP 0
    JMP next

.flat
    LDX x1 : DEX : STX x1       ; the last pixel
    TXA : AND #3 : TAX
    LDA mask_to,X : STA m1
    LDA x0 : AND #3 : TAX
    LDA mask_from,X : STA m
    LDA x0 : EOR x1 : AND #&FC : BNE wide
    LDA m : AND m1 : STA m      ; one byte
    ROW c, m, pe, po
    JMP next
.wide                           ; Y as the row's offset in its page, a byte a block
    LDA x1 : ASL A : AND #&F8 : STA nb  ; the last byte's block...
    TYA : ORA nb : STA nb       ; ...at the row's scanline
    TYA : CLC : ADC c : TAY     ; the first's
    LDA #0 : STA c
    ROW c, m, pe, po
    TYA : ADC #7 : TAY          ; (C clear) the next byte
    CPY nb : BCS last
.full
    ROW c, #&FF, pe, po
    TYA : ADC #7 : TAY
    CPY nb : BCC full           ; (C clear to go round)
.last
    ROW c, m1, pe, po
    JMP next
}
