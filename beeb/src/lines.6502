\ **************************************************************************
\ *
\ *     lines.6502 - vertices, side clips and lines (render.c; spec 7.2-7.8)
\ *
\ **************************************************************************
\
\ The frame's camera is fr_*. A view vertex (render.c's pt_vv) is x and y,
\ its column sx, the flags and its depth's reciprocal; transform leaves one
\ in tf_*. An edge's two vertices are ev_*[0] and [1], and its side-clipped
\ endpoints (pt_ep) ep_*[0] and [1]: two-entry arrays, so the near and far
\ endpoint, or v0 and v1, are picked by X. A height relative to the eye is
\ h_m and h_below. The caller sets the line's colour in l_ce and l_co.

VF_ANEG = &80                   ; a = x + y < 0: outside the left ray
VF_BNEG = &40                   ; b = x - y < 0: outside the right ray
VF_AZERO = &08                  ; exactly on the left ray
VF_BZERO = &04                  ; exactly on the right ray

ZA_AUTO2 fr_camx, fr_camy       ; the frame's camera, in world units
ZA_AUTO1 fr_angle, fr_eyez      ; its facing and its eye's height
ZA_AUTO2 tf_x, tf_y             ; transform's vertex: depth, lateral (s16)...
ZA_AUTO1 tf_sx, tf_flags        ; ...its column and VF_* flags...
ZA_AUTO1 tf_f, tf_e             ; ...and its depth's reciprocal
ZA_AUTO 2, ev_xl                ; the edge's vertices, v0 and v1: x...
ZA_AUTO 2, ev_xh
ZA_AUTO 2, ev_yl                ; ...y...
ZA_AUTO 2, ev_yh
ZA_AUTO 2, ev_sx                ; ...column, flags, reciprocal
ZA_AUTO 2, ev_flags
ZA_AUTO 2, ev_f
ZA_AUTO 2, ev_e
ZA_AUTO 2, ep_xl                ; the endpoints, e0 and e1: depth (u16)...
ZA_AUTO 2, ep_xh
ZA_AUTO 2, ep_yl                ; ...lateral (s16)...
ZA_AUTO 2, ep_yh
ZA_AUTO 2, ep_sx                ; ...column and reciprocal
ZA_AUTO 2, ep_f
ZA_AUTO 2, ep_e
ZA_AUTO1 h_m, h_below           ; a height relative to the eye: |z - eye|, and below it
ZA_AUTO1 el_sx0, el_sx1         ; the edge's columns, from its vertices
ZA_AUTO1 el_have                ; nonzero: ep_* made already
ZA_AUTO1 el_vis                 ; its visit

\ ---- the vertex transform (spec 3.2, 7.3) ----

\\ The world point wx, wy as the camera sees it, in tf_*.
\\ in: wx, wy.
.transform
{
    ZA_AUTO2 wx, wy             ; in
    ZA_AUTO2 t                  ; local: a ray sum, then x clamped to 1
    LDA wx : SEC : SBC fr_camx : STA rot.x
    LDA wx + 1 : SBC fr_camx + 1 : STA rot.x + 1
    LDA wy : SEC : SBC fr_camy : STA rot.y
    LDA wy + 1 : SBC fr_camy + 1 : STA rot.y + 1
    LDA fr_angle : JSR rot
    LDA rot.rx : STA tf_x
    LDA rot.rx + 1 : STA tf_x + 1
    LDA rot.ry : STA tf_y
    LDA rot.ry + 1 : STA tf_y + 1
    \ the ray sums' signs and zeros become the flags
    LDY #0
    LDA tf_x : CLC : ADC tf_y : STA t
    LDA tf_x + 1 : ADC tf_y + 1 : BPL apos
    LDY #VF_ANEG
    BNE bsum                    ; (always)
.apos
    ORA t : BNE bsum
    LDY #VF_AZERO
.bsum
    LDA tf_x : SEC : SBC tf_y : STA t
    LDA tf_x + 1 : SBC tf_y + 1 : BPL bpos
    TYA : ORA #VF_BNEG : TAY
    JMP seams
.bpos
    ORA t : BNE seams
    TYA : ORA #VF_BZERO : TAY
.seams                          ; zero on a ray's backward extension: behind
    TYA : AND #VF_ANEG OR VF_BZERO : CMP #VF_ANEG OR VF_BZERO : BNE @+
    TYA : ORA #VF_BNEG : TAY
.@  TYA : AND #VF_BNEG OR VF_AZERO : CMP #VF_BNEG OR VF_AZERO : BNE @+
    TYA : ORA #VF_ANEG : TAY
.@  STY tf_flags
    LDA #64 : STA tf_sx
    LDA #0 : STA tf_f : STA tf_e
    TYA : AND #VF_ANEG OR VF_BNEG : BNE done    ; outside: column and reciprocal undefined
    LDA tf_x : STA t            ; inside, so x >= 0; the eye vertex takes depth 1
    LDA tf_x + 1 : STA t + 1
    ORA t : BNE @+
    INC t
.@  RECIP16 t
    STA tf_f : STX tf_e
    LDA tf_flags : AND #VF_AZERO : BEQ @+
    LDA #0 : STA tf_sx          ; exactly on a ray: the exact column
    RTS
.@  LDA tf_flags : AND #VF_BZERO : BEQ @+
    LDA #128 : STA tf_sx
    RTS
.@  LDA tf_y : STA project_col.y    ; (x > 0 here)
    LDA tf_y + 1 : STA project_col.y + 1
    LDA tf_f : STA project_col.f
    LDA tf_e : STA project_col.e
    JSR project_col
    STA tf_sx
.done
    RTS
}

\\ A behind vertex's column, mirrored through the camera: project(-y, -x).
\\ in: cv. out: A.
.col_behind
{
    ZA_AUTO2 nx                 ; local: -x
    LDA #0 : SEC : SBC cv_x : STA nx
    LDA #0 : SBC cv_x + 1 : STA nx + 1
    LDA #0 : SEC : SBC cv_y : STA project_col.y
    LDA #0 : SBC cv_y + 1 : STA project_col.y + 1
    RECIP16 nx
    STA project_col.f : STX project_col.e
    JMP project_col
}

\\ Is the vertex's column strictly right of column A? The same projection
\\ as the span columns, so the walk and the spans agree.
\\ in: cv, A = c. out: C set if so.
.col_gt
{
    ZA_AUTO1 c                  ; local
    STA c
    BIT cv_flags : BMI aneg : BVS yes   ; outside right
    LDA c : CMP cv_sx           ; inside: sx > c?
    JMP flip
.aneg
    BVC no                      ; outside left
    JSR col_behind              ; behind: the mirror's column < c
    CMP c
.flip                           ; C was c >= sx (or col >= c): turn it round
    BCS no
.yes
    SEC
    RTS
.no
    CLC
    RTS
}

\\ Is the vertex's column at or right of column A? in: cv, A = c. out: C set if so.
.col_ge
{
    ZA_AUTO1 c                  ; local
    STA c
    BIT cv_flags : BMI aneg : BVS yes
    LDA cv_sx : CMP c           ; inside: sx >= c
    RTS
.aneg
    BVC no
    JSR col_behind              ; behind: the mirror's column <= c
    CMP c : BEQ yes : BCS no
.yes
    SEC
    RTS
.no
    CLC
    RTS
}
ZA_AUTO2 cv_x, cv_y             ; the vertex col_gt and col_ge test: depth, lateral...
ZA_AUTO1 cv_sx, cv_flags        ; ...column, flags

\ ---- frustum side clips (spec 7.6) ----

\\ Endpoint X where vertex X is, at column A: depth at least 1, and an
\\ outside vertex (an edge's far end no clip claimed) its own reciprocal.
.ep_unclipped
{
    STA ep_sx,X : ZA_INDEXEDBY 0..1
    LDA ev_yl,X : ZA_INDEXEDBY 0..1
    STA ep_yl,X : ZA_INDEXEDBY 0..1
    LDA ev_yh,X : ZA_INDEXEDBY 0..1
    STA ep_yh,X : ZA_INDEXEDBY 0..1
    LDA ev_xh,X : ZA_INDEXEDBY 0..1
    BMI one                     ; x < 1: 1
    BNE ok
    LDA ev_xl,X : ZA_INDEXEDBY 0..1
    BNE ok
.one
    LDA #1 : STA ep_xl,X : ZA_INDEXEDBY 0..1
    LDA #0 : STA ep_xh,X : ZA_INDEXEDBY 0..1
    JMP rx
.ok
    LDA ev_xl,X : ZA_INDEXEDBY 0..1
    STA ep_xl,X : ZA_INDEXEDBY 0..1
    LDA ev_xh,X : ZA_INDEXEDBY 0..1
    STA ep_xh,X : ZA_INDEXEDBY 0..1
.rx
    LDA ev_flags,X : ZA_INDEXEDBY 0..1
    AND #VF_ANEG OR VF_BNEG : BNE own
    LDA ev_f,X : ZA_INDEXEDBY 0..1
    STA ep_f,X : ZA_INDEXEDBY 0..1
    LDA ev_e,X : ZA_INDEXEDBY 0..1
    STA ep_e,X : ZA_INDEXEDBY 0..1
    RTS
.own
    JMP ep_recip
}

\\ Endpoint X's reciprocal, from its depth.
.ep_recip
{
    ZA_AUTO2 n                  ; local
    ZA_AUTO1 k                  ; local: X
    STX k
    LDA ep_xl,X : ZA_INDEXEDBY 0..1
    STA n
    LDA ep_xh,X : ZA_INDEXEDBY 0..1
    STA n + 1
    RECIP16 n
    LDY k
    STA ep_f,Y : ZA_INDEXEDBY 0..1
    TXA : STA ep_e,Y : ZA_INDEXEDBY 0..1
    LDX k
    RTS
}

\\ Endpoint X's depth from a lerp's result, at least 1: from lerp16.r.
.ep_depth
{
    LDA lerp16.r + 1 : BMI one
    BNE ok
    LDA lerp16.r : BNE ok
.one
    LDA #1 : STA ep_xl,X : ZA_INDEXEDBY 0..1
    LDA #0 : STA ep_xh,X : ZA_INDEXEDBY 0..1
    RTS
.ok
    LDA lerp16.r : STA ep_xl,X : ZA_INDEXEDBY 0..1
    LDA lerp16.r + 1 : STA ep_xh,X : ZA_INDEXEDBY 0..1
    RTS
}

\\ e0 where the edge crosses the left ray (v0 outside it, v1 not): t from
\\ the ray sums, the depth lerped. On the left ray y = -x and the column is 0.
.clip_left
{
    LDA #0 : SEC : SBC ev_xl : STA div_t.num    ; -(x0 + y0): one subtract chain from 0
    LDA #0 : SBC ev_xh : STA div_t.num + 1
    LDA div_t.num : SEC : SBC ev_yl : STA div_t.num
    LDA div_t.num + 1 : SBC ev_yh : STA div_t.num + 1
    LDA ev_xl + 1 : CLC : ADC ev_yl + 1 : STA div_t.den     ; + (x1 + y1)
    LDA ev_xh + 1 : ADC ev_yh + 1 : STA div_t.den + 1
    LDA div_t.den : CLC : ADC div_t.num : STA div_t.den
    LDA div_t.den + 1 : ADC div_t.num + 1 : STA div_t.den + 1
    JSR div_t
    PHA
    LDA ev_xl : STA lerp16.va
    LDA ev_xh : STA lerp16.va + 1
    LDA ev_xl + 1 : STA lerp16.vb
    LDA ev_xh + 1 : STA lerp16.vb + 1
    PLA : JSR lerp16
    LDX #0 : JSR ep_depth
    LDA #0 : SEC : SBC ep_xl : STA ep_yl        ; y = -x
    LDA #0 : SBC ep_xh : STA ep_yh
    LDA #0 : STA ep_sx
    LDX #0 : JMP ep_recip
}

\\ e1 where the edge crosses the right ray (v1 outside it): t from b0 (e0's
\\ x - y) and v1's, the depth lerped from e0's. On the right ray y = x and
\\ the column is 128. in: b0.
.clip_right
{
    ZA_AUTO2 b0                 ; in
    LDA ev_yl + 1 : SEC : SBC ev_xl + 1 : STA div_t.den     ; -(x1 - y1) = y1 - x1
    LDA ev_yh + 1 : SBC ev_xh + 1 : STA div_t.den + 1
    LDA div_t.den : CLC : ADC b0 : STA div_t.den
    LDA div_t.den + 1 : ADC b0 + 1 : STA div_t.den + 1
    LDA b0 : STA div_t.num
    LDA b0 + 1 : STA div_t.num + 1
    JSR div_t
    PHA
    LDA ep_xl : STA lerp16.va
    LDA ep_xh : STA lerp16.va + 1
    LDA ev_xl + 1 : STA lerp16.vb
    LDA ev_xh + 1 : STA lerp16.vb + 1
    PLA : JSR lerp16
    LDX #1 : JSR ep_depth
    LDA ep_xl + 1 : STA ep_yl + 1               ; y = x
    LDA ep_xh + 1 : STA ep_yh + 1
    LDA #128 : STA ep_sx + 1
    LDX #1 : JMP ep_recip
}

\ ---- line generation (spec 7.7) ----

\\ The screen row of height h at endpoint X's depth: the centre plus or
\\ minus the projected offset. out: A.
.row_from
{
    LDY h_m
    LDA ep_f,X : ZA_INDEXEDBY 0..1
    PHA
    LDA ep_e,X : ZA_INDEXEDBY 0..1
    TAX
    PLA
    JSR project_rowd
    LDX h_below : BEQ above
    CLC : ADC #32
    RTS
.above
    EOR #&FF : SEC : ADC #32    ; 32 - q
    RTS
}

\\ The edge's line at height h from its endpoints, pre-clipped to the
\\ screen: the part nearer than x = 16 * h.m projects past the screen's top
\\ or bottom (h's side), so the line stops where it reaches that edge. Empty
\\ (x0 = x1) when both endpoints are that near. in: ep_*, h, l_ce and l_co.
\\ out: the line.
.make_line
{
    ZA_AUTO2 d                  ; local: the clip depth, 16 * h.m
    ZA_AUTO1 edge, near         ; local: the screen edge's row; which endpoint is near
    ZA_AUTO1 n0, sy0            ; local: e0 near; its row
    ZA_AUTO2 sxq, dxq           ; local: the clip point's column (u8.8); the gradient's run
    ZA_AUTO1 syf, cs            ; local: the far endpoint's row; the clip column
    ZA_AUTO1 sign, fr           ; local: the gradient's sign; the clip column's fraction
    ZA_AUTO2 off, y0q           ; local: the start row's offset, and the start row (u8.8)
    LDA h_m : STA d
    LDA #0 : STA d + 1
    ASL d : ROL d + 1 : ASL d : ROL d + 1 : ASL d : ROL d + 1 : ASL d : ROL d + 1
    LDA #0 : STA edge
    STA l_y0 : STA l_g : STA l_g + 1
    LDA h_below : BEQ @+
    LDA #64 : STA edge
.@  LDA ep_sx : STA l_x0 : STA l_x1
    LDA ep_xl : CMP d : LDA ep_xh : SBC d + 1   ; near0 = e0.x < d
    LDA #0 : ROL A : EOR #1 : STA n0
    LDA ep_xl + 1 : CMP d : LDA ep_xh + 1 : SBC d + 1   ; near1, in C (clear: near)
    BCS far1
    LDA n0 : BEQ near1only
    RTS                         ; both near: empty
.far1
    LDA n0 : BEQ both
    LDA #0 : STA near           ; e0 near
    JMP clip
.near1only
    LDA #1 : STA near
    JMP clip

.both                           ; neither near: the line between their rows
    LDX #0 : JSR row_from
    STA sy0 : STA l_y0
    LDX #1 : JSR row_from       ; sy1
    LDX ep_sx + 1 : STX l_x1
    LDY #0                      ; the sign
    SEC : SBC sy0 : BCS @+
    EOR #&FF : ADC #1           ; sy0 - sy1 (C clear)
    LDY #&80
.@  STY sign
    PHA
    LDA ep_sx + 1 : SEC : SBC ep_sx : TAY   ; dx
    PLA : JSR grad_mag
    LDA grad_mag.q : STA l_g
    LDA grad_mag.q + 1 : JMP signed

.clip                           ; exactly one near: clip the edge at depth d
    LDX near
    LDA d : SEC : SBC ep_xl,X : ZA_INDEXEDBY 0..1
    STA div_t.num
    LDA d + 1 : SBC ep_xh,X : ZA_INDEXEDBY 0..1
    STA div_t.num + 1
    TXA : EOR #1 : TAY          ; Y: the far one
    LDA ep_xl,Y : ZA_INDEXEDBY 0..1
    SEC
    SBC ep_xl,X : ZA_INDEXEDBY 0..1
    STA div_t.den
    LDA ep_xh,Y : ZA_INDEXEDBY 0..1
    SBC ep_xh,X : ZA_INDEXEDBY 0..1
    STA div_t.den + 1
    JSR div_t
    PHA
    LDX near
    LDA ep_yl,X : ZA_INDEXEDBY 0..1
    STA lerp16.va
    LDA ep_yh,X : ZA_INDEXEDBY 0..1
    STA lerp16.va + 1
    TXA : EOR #1 : TAX
    LDA ep_yl,X : ZA_INDEXEDBY 0..1
    STA lerp16.vb
    LDA ep_yh,X : ZA_INDEXEDBY 0..1
    STA lerp16.vb + 1
    PLA : JSR lerp16            ; ys
    LDA lerp16.r : STA project_col_q8.y
    LDA lerp16.r + 1 : STA project_col_q8.y + 1
    LDA d : STA project_col_q8.d
    LDA d + 1 : STA project_col_q8.d + 1
    JSR project_col_q8
    LDA project_col_q8.q : STA sxq
    LDA project_col_q8.q + 1 : STA sxq + 1
    LDA near : EOR #1 : TAX
    JSR row_from : STA syf
    LDA sxq : CLC : ADC #255    ; cs = ceil(sxq), within [e0.sx, e1.sx]
    LDA sxq + 1 : ADC #0
    CMP ep_sx : BCS @+
    LDA ep_sx
.@  CMP ep_sx + 1 : BCC @+
    LDA ep_sx + 1
.@  STA cs
    LDA near : BEQ near0
    JMP near1                   ; (out of branch range)

.near0                          ; e0 near: the line starts where it comes on screen
    LDA cs : CMP ep_sx + 1 : BCC @+
    RTS                         ; all of it off the screen
.@  LDA #0 : SEC : SBC sxq : STA dxq        ; e1.sx * 256 - sxq
    LDA ep_sx + 1 : SBC sxq + 1 : STA dxq + 1
    LDA #0 : SEC : SBC sxq : STA fr         ; (cs * 256 - sxq)'s low byte
    LDA dxq : STA gradq8_mag.dx
    LDA dxq + 1 : STA gradq8_mag.dx + 1
    LDA syf : SEC : SBC edge : BCC rising
    JSR gradq8_mag              ; syf >= edge: falling
    LDA fr : SETMUL
    MULU16_FRAC gradq8_mag.q, off
    LDA #128 : CLC : ADC off : STA y0q      ; base + off (at most 16,512 + 32,639:
    LDA edge : ADC off + 1 : STA y0q + 1    ; the C's clamp on a carry is dead)
    LDY #0
    JMP anchor
.rising
    EOR #&FF : ADC #1           ; edge - syf (C clear)
    JSR gradq8_mag
    LDA fr : SETMUL
    MULU16_FRAC gradq8_mag.q, off
    LDA #128 : SEC : SBC off : STA y0q      ; base - off, stopping at 0
    LDA edge : SBC off + 1 : BCS @+
    LDA #0
.@  STA y0q + 1
    LDY #&80
.anchor
    STY sign
    LDA cs : STA l_x0
    LDA ep_sx + 1 : STA l_x1
    LDA y0q + 1 : CMP #65 : BCC @+          ; the nearest row, on screen or at its edge
    LDA #64
.@  STA l_y0
    LDA gradq8_mag.q : STA l_g
    LDA gradq8_mag.q + 1 : JMP signed

.near1                          ; e1 near: the line stops where it goes off
    LDA ep_sx : CMP cs : BCC @+
    RTS
.@  LDA sxq : SEC : SBC #0 : STA gradq8_mag.dx  ; sxq - e0.sx * 256
    LDA sxq + 1 : SBC ep_sx : STA gradq8_mag.dx + 1
    LDA cs : STA l_x1
    LDA syf : STA l_y0
    LDY #0
    LDA edge : SEC : SBC syf : BCS @+       ; edge >= syf: falling
    EOR #&FF : ADC #1           ; syf - edge (C clear)
    LDY #&80
.@  STY sign
    JSR gradq8_mag
    LDA gradq8_mag.q : STA l_g
    LDA gradq8_mag.q + 1

.signed                         ; A = the magnitude's high byte: the sign joins a nonzero one
    STA l_g + 1
    ORA l_g : BEQ @+
    LDA l_g + 1 : ORA sign : STA l_g + 1
.@  RTS
}

\\ An edge's line in slot A at height h: a line with an active piece is
\\ already on the screen, so its piece runs on to the edge's end; only a
\\ line without one is made, side-clipping the endpoints first (once for
\\ all the edge's lines). in: A = slot, h, l_ce and l_co, the el_* and
\\ ev_* state. out: the line.
.edge_line
{
    ZA_AUTO1 slot, t            ; local: the slot, then slot * 8
    STA slot
    ASL A : ASL A : ASL A : STA t   ; slot * 24 + the visit
    ASL A : CLC : ADC t
    CLC : ADC el_vis : TAX
    LDY vis_act,X : BEQ made
    LDA p_x0,Y : STA l_x0       ; carried on: the piece's start, to the edge's end
    LDA el_sx1 : STA l_x1
    LDA p_y0,Y : STA l_y0
    LDA p_glo,Y : STA l_g
    LDA p_ghi,Y : STA l_g + 1
    RTS
.made
    LDA el_have : BNE make
    \ the side clip: the endpoints the lines are made from (an edge starting
    \ past the right ray never gets here: process_edge finds it no columns,
    \ so render.c's arm for it is dead, D10)
    BIT ev_flags : BPL @+
    JSR clip_left               ; v0 outside the left ray
    LDA ep_xl : ASL A : STA clip_right.b0       ; on the left ray b = 2x
    LDA ep_xh : ROL A : STA clip_right.b0 + 1
    JMP e1
.@  LDX #0 : LDA ev_sx
    JSR ep_unclipped
    LDA ev_xl : SEC : SBC ev_yl : STA clip_right.b0     ; b = x - y
    LDA ev_xh : SBC ev_yh : STA clip_right.b0 + 1
.e1
    BIT ev_flags + 1 : BVC @+
    JSR clip_right              ; v1 outside the right ray
    JMP have
.@  LDX #1 : LDA el_sx1
    JSR ep_unclipped
.have
    LDA #1 : STA el_have
.make
    JMP make_line
}
