\ **************************************************************************
\ *
\ *     layout.6502 - the memory map (PLAN.md section 2)
\ *
\ **************************************************************************
\
\ Once the IRQ routine is installed the OS is off: no OS calls at all, so
\ everything from &300 up is ours.
\
\   &300-&EFF    fixed tables (Phase 1); the NMI handler at &D00
\   &F00-...     code and data, up to CODE_GUARD
\   BSS_ORG      the per-frame state (release: &5100-&56FF; harness: inside
\                the screen buffer not under test)
\   &5700        junk character row above buffer A
\   &5800        buffer A (4K)
\   &6800        junk character row below A
\   &6900-&6EFF  spare: never plotted, filled, cleared or shown; six of the
\                pool's eight pages (D13)
\   &6F00        junk character row above B
\   &7000        buffer B (4K)
\   &8000        B's junk row below is the paged ROM: stores go nowhere
\
\ The junk rows are scratch for what the capture alone uses (most of the
\ visits' tables, and the pool's p_next): only the plotters write them,
\ and by then the capture's done with it (D13). The rest of it shares BSS
\ with the sprite pass's own state, which only starts after the plot.
\
\ Both buffers start on a multiple of &800, so the CRTC's start address
\ (the address DIV 8) has a low byte of 0: R13 stays 0 and a swap only
\ writes R12, the page DIV 8.
\
\ Page 2 keeps &200-&205 (BRKV, IRQ1V) and never writes &27E-&29B (kept
\ across BREAK); test builds talk to the host through a mailbox at
\ &2F0-&2FF.

CODE_ORG = &300
TABLES_END = &F00
NMI_ADDR = &D00                 ; the 6502's NMI vector enters RAM here

\ MAP (from the Makefile, -D MAP=n): 0 the demo scene, 7 the demo scene
\ with seven sprites, 9 the stress map. (A default here via DEFINED doesn't
\ settle: from the second pass on the symbol counts as defined.)

SCREENS_ORG = &5700
BUF_A = &5800
BUF_B = &7000
SPARE_ORG = &6900
SPARE_END = &6F00
SCREENS_END = &8000
JUNK0 = BUF_A - &100            ; the junk rows: above A...
JUNK1 = BUF_A + &1000           ; ...below it...
JUNK2 = BUF_B - &100            ; ...and above B

IF HARNESS
    CODE_GUARD = SCREENS_ORG    ; a harness image may reach the screens
    IF TESTBUF == 0
        BSS_ORG = BUF_B         ; buffer A is the one under test
    ELSE
        BSS_ORG = BUF_A
    ENDIF
    BSS_END = BSS_ORG + &1000
ELSE
    BSS_ORG = &5100             ; (D13: the rest is in the spare and the junk rows)
    CODE_GUARD = BSS_ORG
    BSS_END = SCREENS_ORG
ENDIF

\ The mailbox (test builds, PLAN.md section 5.2): the host pokes the
\ inputs and then cmd..seq in one request, and polls ack.
MB = &2F0
MB_MAGIC = MB + 0               ; 'P' 'C' '1', written last by start
MB_CMD = MB + 3
MB_ARG = MB + 4                 ; four argument bytes
MB_SEQ = MB + 8                 ; the host's command number, from 1
MB_ACK = MB + 9                 ; = seq once the command is done
MB_ERR = MB + 10                ; 0 = ok, else a TRAP code; &FF = BRK
MB_USECS = MB + 11              ; four bytes: a command's elapsed microseconds

MACRO TRAP code                 ; test builds: stop with an error code (mailbox.6502)
    LDA #code : STA MB_ERR
    JMP trapstop
ENDMACRO
