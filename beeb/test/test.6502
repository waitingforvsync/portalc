\\ test/test.6502 - make test's checks, which the loader runs in its -D TEST=TRUE build. They
\\ leave their answers at the top of the sideways RAM bank, for host/test_build.py to compare.

TEST_RESULTS = &A000

SECTION TestResults, org = TEST_RESULTS, guard = SWRAM_END, virtual = TRUE
ENDSECTION

INCLUDE "arith.6502"
INCLUDE "vcache.6502"

SECTION TestResults
.t_done     SKIP 1                      ; &A5 once every check's answers are written
ENDSECTION

\\ Run every check.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     TestResults: the answers, t_done last

.test
{
    LDA #0:STA t_done
    JSR test_arith
    JSR test_vcache
    LDA #&A5:STA t_done
    RTS
}

ASSERT P% <= TEST_RESULTS, "test: the code runs into its answers"
