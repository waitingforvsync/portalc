\\ constants.6502 - the engine's constants, as the C has them.

SCREEN_HEIGHT = 64                      ; canvas rows, two scanlines each (mode5.h)
MAX_VERTS = 64                          ; the map's caps (map.h's PT_MAX_): size tables by these
MAX_CELLS = 32
MAX_VCACHE = 63                         ; vcache.h's PT_MAX_VCACHE: with entry 0, four tables a page
IN_FWD = 1                              ; the input bits (camera.h's PT_IN_)
IN_BACK = 2
IN_LEFT = 4                             ; strafe
IN_RIGHT = 8
IN_TURNL = 16
IN_TURNR = 32
CAM_RADIUS = 40                         ; the camera's circle, in units (camera.h)
POST_NEAR = 256                         ; d2 under this: on top of a post, left alone
POST_SCALE = 1.25*2^15                  ; a post's 1/d2: its quarter's overcorrection, and q15
