\\ test/capture.6502 - make test's check of the capture: its setup, root walk and the eye's cell's
\\ sides from places in each cell, made-up lines, and HEIGHT_OF, for host/test_build.py.

INCLUDE "places.6502"

LINES_HEIGHT = 17*256+31                ; the made-up lines' height's log (captureref's)

SECTION TestResults
.t_capture1 SKIP PLACES                 ; the capture's Fletcher sums, by the camera's place
.t_capture2 SKIP PLACES
.t_height1  SKIP &100                   ; HEIGHT_OF's, by the eye's height
.t_height2  SKIP &100
.t_lines1   SKIP &100                   ; the made-up lines', by the start's place on the grid
.t_lines2   SKIP &100
ENDSECTION

\\ From each place, at every angle: the capture's setup and root walk, then the eye's cell walked
\\ as the walk walks it. Too many answers to keep, so each place's go into a pair of sums; then
\\ every height from every eye height, and the made-up lines.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     t_capture1, t_capture2: the capture's sums, by the camera's place
\\     t_height1, t_height2: HEIGHT_OF's, by the eye's height
\\     t_lines1, t_lines2: the made-up lines', by the start's place on the grid

.test_capture
{
    ZA_AUTO1 place                      ; local: the camera's place
    ZA_AUTO1 sum1                       ; local: the sum of the answers' bytes
    ZA_AUTO1 sum2                       ; local: and the sum of the sums

    JSR map_init                        ; the vertex cache and visits empty
    LDA #0:STA place
.position
    LDX place
    LDA t_placecell,X:STA camcell
    LDA t_placexlo,X:STA camx
    LDA t_placexhi,X:STA camx+1
    LDA t_placeylo,X:STA camy
    LDA t_placeyhi,X:STA camy+1
    JSR vcache_reset
    LDA #0:STA camangle:STA camangle+1:STA sum1:STA sum2
.angle
    JSR capture_root
    JSR forget_visits                   ; as a frame does after its walk

    \\ the walk, its visit, the eye's height, the counts, and where each byte column's fill stops

    FOR v = {walk_vi, span_x0, walk_tmax, walk_bmin, walk_split_angle, walk_split_angle+1}
        LDA v:FLETCHER sum1, sum2
    NEXT
    FOR v = {walk_u0, walk_u0+1}
        LDA v:FLETCHER sum1, sum2
    NEXT
    FOR v = {walk_u1, walk_u1+1, walk_c0, walk_c1}
        LDA v:FLETCHER sum1, sum2
    NEXT
    LDX walk_vi
    FOR t = {visit_cell, visit_side, visit_xr, visit_kept, visit_hclo, visit_hchi, visit_hflo}
        LDA t,X:FLETCHER sum1, sum2
    NEXT
    LDA visit_hfhi,X:FLETCHER sum1, sum2
    FOR v = {eye_z, num_visits, num_kept, num_recs}
        LDA v:FLETCHER sum1, sum2
    NEXT
    LDX #0
.ends
    LDA toggle_end,X:FLETCHER sum1, sum2
    INX
    CPX #SCREEN_WIDTH/4
    BNE ends

    \\ the eye's cell, a side at a time until one ends at or past the portal's right column: each
    \\ side, its ends' screen angles and columns, and if it has columns its ends as its lines see
    \\ them and its lines at the cell's ceiling and floor and the eye's height

.step
    LDX walk_vi
    LDA visit_side,X:FLETCHER sum1, sum2
    FOR v = {walk_u0, walk_u0+1, walk_u1, walk_u1+1, walk_c0, walk_c1}
        LDA v:FLETCHER sum1, sum2
    NEXT
    LDA walk_c0:CMP walk_c1:BCC columns
    JMP walked                          ; no columns
.columns
    JSR edge_ends
    FOR v = {logdepth0, logdepth0+1, logdepth1, logdepth1+1, logcolumns, logcolumns+1}
        LDA v:FLETCHER sum1, sum2
    NEXT
    LDY walk_vi
    LDX visit_hclo,Y:LDA visit_hchi,Y
    JSR make_line
    LINE_SUMS sum1, sum2
    LDY walk_vi
    LDX visit_hflo,Y:LDA visit_hfhi,Y
    JSR make_line
    LINE_SUMS sum1, sum2
    LDX #0:LDA #&80                     ; the eye's height: below, 0
    JSR make_line
    LINE_SUMS sum1, sum2
.walked
    LDX walk_vi
    LDA walk_c1:CMP visit_xr,X
    BCS turned                          ; the last side
    JSR side_next
    JMP step

.turned
    CLC:LDA camangle:ADC #4             ; the next of the C's 256ths
    STA camangle
    LDA camangle+1:ADC #0:AND #3:STA camangle+1
    ORA camangle
    BEQ angles                          ; round to 0: all 256
    JMP angle
.angles
    LDX place
    LDA sum1:STA t_capture1,X
    LDA sum2:STA t_capture2,X
    INC place
    LDA place:CMP #PLACES
    BEQ heights
    JMP position

    \\ every height from every eye height: the log's low byte, then its high and the side

    ZA_AUTO1 z                          ; local: the height

.heights
    LDA #0:STA eye_z
.eye
    LDA #0:STA z:STA sum1:STA sum2
.height
    LDA z
    HEIGHT_OF
    PHA
    TXA:FLETCHER sum1, sum2
    PLA:FLETCHER sum1, sum2
    INC z
    BNE height
    LDX eye_z
    LDA sum1:STA t_height1,X
    LDA sum2:STA t_height2,X
    INC eye_z
    BNE eye

    \\ made-up lines, for the paths the walk never takes, as captureref makes them: the ends'
    \\ depths' logs on a grid from -512 in steps of 32, the start's by row and the end's by column,
    \\ at a height whose log is 31 on from a multiple of 32, so the grid meets 13 * 256 - 1, the
    \\ last offset on the screen. The column also picks the side's columns, 1 to 128, and whether
    \\ the height's below the eye

    ZA_AUTO1 row                        ; local: the start's place on the grid
    ZA_AUTO1 column                     ; local: the end's

    LDA #LO(-512):STA logdepth0
    LDA #HI(-512):STA logdepth0+1
    LDA #0:STA row:STA walk_c0
.lines
    LDA #LO(-512):STA logdepth1
    LDA #HI(-512):STA logdepth1+1
    LDA #0:STA column:STA sum1:STA sum2
.line
    LDA column:LSR A:TAX:INX:STX walk_c1
    LOG2_8                              ; A: the fraction, Y: the whole part
    STA logcolumns:STY logcolumns+1
    LDA column:LSR A                    ; C: below
    LDA #0:ROR A
    ORA #HI(LINES_HEIGHT):LDX #LO(LINES_HEIGHT)
    JSR make_line
    LINE_SUMS sum1, sum2
    CLC:LDA logdepth1:ADC #32:STA logdepth1
    LDA logdepth1+1:ADC #0:STA logdepth1+1
    INC column
    BEQ row_done
    JMP line
.row_done
    LDX row
    LDA sum1:STA t_lines1,X
    LDA sum2:STA t_lines2,X
    CLC:LDA logdepth0:ADC #32:STA logdepth0
    LDA logdepth0+1:ADC #0:STA logdepth0+1
    INC row
    BEQ lined
    JMP lines
.lined
    RTS
}
