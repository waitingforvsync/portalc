\\ capture.6502 - the capture's setup and the walk's parts: visits, sides, their ends and lines.
\\ The walk itself is walk.6502's. It only touches T, so it needn't wait for the buffer.

\\ How far a line's offset from the screen's middle row runs to its top or bottom edge, and its
\\ log's high byte; and the middle row, as a line's rows have it.

EDGE_OFFSET = SCREEN_HEIGHT DIV 2*256   ; 32 rows, u8.8
EDGE_LOG = 13                           ; 2^13 = 32 * 256
LINE_MIDDLE = EDGE_OFFSET+128           ; 32 rows down, u8.8, the rounding half in
ASSERT 1 << EDGE_LOG == EDGE_OFFSET, "the capture: the screen's edge's log"

\\ The frame's view and counts, and the walk in progress: shared by the capture's routines.

ZA_AUTO2 viewleft                       ; the view's left edge, 10 bits: screen angles' zero
ZA_AUTO1 eye_z                          ; the eye's height, in the map's 8-unit z steps
ZA_AUTO1 num_visits                     ; visits made, the null one included
ZA_AUTO1 num_kept                       ; kept lines' entries taken, the null one included
ZA_AUTO1 walk_vi                        ; the walk's visit
ZA_AUTO1 span_x0                        ; its side's span of the portal, [x0, x1): x0 where the
ZA_AUTO1 span_x1                        ; last span ended, and so the next one starts
ZA_AUTO1 walk_tmax                      ; the bounds' extents over its portal: the lowest top row
ZA_AUTO1 walk_bmin                      ; and the highest bottom row
ZA_AUTO2 walk_split_angle               ; its window: screen angles at or past this are a turn less
ZA_AUTO2 walk_u0                        ; its side's start's screen angle
ZA_AUTO2 walk_u1                        ; and its end's
ZA_AUTO1 walk_e0                        ; the start's vertex cache entry
ZA_AUTO1 walk_e1                        ; and the end's
ZA_AUTO1 walk_c0                        ; the start's column
ZA_AUTO1 walk_c1                        ; and the end's

\\ The walk's side's ends as its lines see them (edge_ends).

ZA_AUTO2 logdepth0                      ; 256 log2 of the start's depth, in whole units
ZA_AUTO2 logdepth1                      ; and the end's
ZA_AUTO2 logcolumns                     ; 256 log2 of the side's columns, walk_c1 - walk_c0

\\ The side's line at a height (make_line), before it's clipped.

ZA_AUTO1 line_x0                        ; its columns on the screen, [x0, x1): none if x0 = x1
ZA_AUTO1 line_x1
ZA_AUTO2 line_y                         ; its row at x0, u8.8, the rounding half in
ZA_AUTO2 line_grad                      ; its gradient: bit 15 the sign, then u7.8 rows a column
ZA_AUTO1 line_endy                      ; the row at its end: its last rows can be one past it
ZA_AUTO1 line_below                     ; &80: below the eye, beyond the screen's bottom; 0: top

\\ Each cell's visit, 0 for none: all 0 between captures, as each visit clears its own.

SECTION Persist
    FITPAGE MAX_CELLS
.cell_visit SKIP MAX_CELLS
ENDSECTION

\\ The visits, numbered from 1 (entry 0's bytes are unused): what a cell's later visit needs.

SECTION Capture
    FITPAGE MAX_VISITS+1
.visit_cell SKIP MAX_VISITS+1           ; the cell
    FITPAGE MAX_VISITS+1
.visit_side SKIP MAX_VISITS+1           ; the side its last walk stopped on
    FITPAGE MAX_VISITS+1
.visit_xr   SKIP MAX_VISITS+1           ; the right column of the portal last walked: 0 until then
    FITPAGE MAX_VISITS+1
.visit_kept SKIP MAX_VISITS+1           ; its side's kept lines' entry, 0 for none
    FITPAGE MAX_VISITS+1
.visit_hclo SKIP MAX_VISITS+1           ; the ceiling as its lines see it: the log's low byte
    FITPAGE MAX_VISITS+1
.visit_hchi SKIP MAX_VISITS+1           ; and high, bit 7 set if it's below the eye
    FITPAGE MAX_VISITS+1
.visit_hflo SKIP MAX_VISITS+1           ; the floor's
    FITPAGE MAX_VISITS+1
.visit_hfhi SKIP MAX_VISITS+1
    FITPAGE MAX_VISITS+1
.visit_split_anglelo SKIP MAX_VISITS+1  ; its window's split angle, made at its first visit
    FITPAGE MAX_VISITS+1
.visit_split_anglehi SKIP MAX_VISITS+1
ENDSECTION

\\ The frame's setup and its root walk (pt_render_root): the counts and the view readied, and the
\\ camera's cell's visit made, the whole screen wide, its walk begun on the side the view starts on.
\\
\\ Inputs:
\\     camx, camy, camangle, camcell: the camera
\\
\\ Outputs:
\\     viewleft, eye_z: the view
\\     num_visits, num_kept, num_recs, toggle_end: the counts, no visits but the root's
\\     walk_vi and the walk: the root walk, begun
\\     the root visit: its side, window and right column
\\     A, X, Y: corrupted

.capture_root
{
    \\ the view, the eye's height and the counts: no visits, records or kept lines yet, and each
    \\ byte column toggled at row 0 at most, as lines off the top toggle it unrecorded

    VIEW_LEFT
    LDX camcell
    LDA cell_floorz,X:SEC:SBC #CAM_HEIGHT:STA eye_z
    LDA #1:STA num_visits:STA num_kept
    LDX #SCREEN_WIDTH/16-1              ; a quarter of the byte columns
.ends
    STA toggle_end,X
    STA toggle_end+SCREEN_WIDTH/16,X
    STA toggle_end+SCREEN_WIDTH/8,X
    STA toggle_end+SCREEN_WIDTH*3/16,X
    DEX
    BPL ends
    LDA #0:STA num_recs

    \\ the root visit, the camera's cell's, the whole screen wide

    LDX camcell
    JSR visit_of
    STX walk_vi
    LDA #SCREEN_WIDTH:STA visit_xr,X

    \\ the root side, where the walk begins: the side the view's left edge lies on, the first whose
    \\ end's screen angle is below its start's, measured from viewleft + 1 (pt_render_root_side),
    \\ and the last if it's none before it. The next side's start is a side's end

    ZA_AUTO1 ringend                    ; local: the next cell's first side
    ZA_AUTO2 startangle                 ; local: the side's start's screen angle, from viewleft + 1
    ZA_AUTO2 endangle                   ; local: and its end's

    LDX camcell
    LDA cell_first+1,X:STA ringend
    LDY cell_first,X
    LDX side_v,Y
    VCACHE_VERT_TO_X
    CLC                                 ; (the - 1)
    LDA vc_anglo,X:SBC viewleft:STA startangle
    LDA vc_anghi,X:SBC viewleft+1:AND #3
    STA startangle+1
.side
    INY
    CPY ringend:BEQ found               ; the last side: it's the one
    LDX side_v,Y
    VCACHE_VERT_TO_X
    CLC
    LDA vc_anglo,X:SBC viewleft:STA endangle
    LDA vc_anghi,X:SBC viewleft+1:AND #3
    STA endangle+1
    CMP startangle+1:BCC found          ; the high byte below the start's
    BNE on
    LDA endangle:CMP startangle:BCC found
.on
    LDA endangle:STA startangle
    LDA endangle+1:STA startangle+1
    BCS side                            ; (always: C set by the compares)
    ZA_UNREACHABLE
.found
    DEY                                 ; the side
    LDX walk_vi
    TYA:STA visit_side,X

    \\ the root walk: from column 0, between the screen's edges, its window split at the side's
    \\ start, one on from its screen angle from viewleft + 1

    LDA #0:STA span_x0:STA walk_tmax
    LDA #SCREEN_HEIGHT:STA walk_bmin
    CLC
    LDA startangle:ADC #1:STA walk_split_angle
    STA visit_split_anglelo,X
    LDA startangle+1:ADC #0:STA walk_split_angle+1
    STA visit_split_anglehi,X
    JMP side_start
}

\\ The visit cache emptied, while the visits are still here: each clears its own cell's.
\\
\\ Inputs:
\\     num_visits, visit_cell: the visits made
\\
\\ Outputs:
\\     cell_visit: all 0
\\     A, X, Y: corrupted

.forget_visits
{
    LDX num_visits
    DEX                                 ; the last visit made
    BEQ done
    LDA #0
.forget
    LDY visit_cell,X:STA cell_visit,Y
    DEX
    BNE forget
.done
    RTS
}

\\ Begin the walk on a side (side_start): its start's screen angle in the window, its vertex cache
\\ entry and its column; then its end (side_end).
\\
\\ Inputs:
\\     Y: the side
\\     walk_vi, walk_split_angle: the walk's visit, and its window's split
\\     viewleft: the view's left edge
\\
\\ Outputs:
\\     walk_u0, walk_e0, walk_c0: the start's screen angle, vertex cache entry and column
\\     walk_u1, walk_e1, walk_c1: the end's (side_end)
\\     A, X, Y: corrupted

.side_start
{
    LDX side_v,Y
    VERT_TO_SCREEN_ANGLE walk_u0
    STX walk_e0
    SCREEN_ANGLE_TO_COLUMN walk_u0
    STA walk_c0
    JMP side_end
}

\\ On to the walk's next side clockwise (side_next): its start is the last one's end. Any lines kept
\\ were the last side's.
\\
\\ Inputs:
\\     walk_vi and the walk: on a side that doesn't end a turn on
\\
\\ Outputs:
\\     visit_side, visit_kept: the next side, and none kept
\\     walk_u0, walk_e0, walk_c0: its start, the last side's end
\\     walk_u1, walk_e1, walk_c1: its end (side_end)
\\     A, X, Y: corrupted

.side_next
{
    LDX walk_vi
    LDA #0:STA visit_kept,X
    LDY visit_side,X
    LDA visit_cell,X:TAX
    RING_NEXT
    LDX walk_vi
    TYA:STA visit_side,X
    LDA walk_u1:STA walk_u0
    LDA walk_u1+1:STA walk_u0+1
    LDA walk_e1:STA walk_e0
    LDA walk_c1:STA walk_c0             ; then on into side_end, Y the side
}

\\ The walk's side's end, the next side's start (side_end): its screen angle, where it is in the
\\ window, or a turn on if that's half a turn or more left of the start; and its column.
\\
\\ Inputs:
\\     Y: the side
\\     walk_vi, walk_u0, walk_split_angle: the walk's visit, its side's start, its window's split
\\     viewleft: the view's left edge
\\
\\ Outputs:
\\     walk_u1, walk_e1, walk_c1: the end's screen angle, vertex cache entry and column
\\     A, X, Y: corrupted

.side_end
{
    LDX walk_vi
    LDA visit_cell,X:TAX
    RING_NEXT                           ; the next side: its start is the end
    LDX side_v,Y
    VERT_TO_SCREEN_ANGLE walk_u1
    STX walk_e1
    LDA walk_u0:CMP walk_u1
    LDA walk_u0+1:SBC walk_u1+1         ; the start less the end's high byte, signed
    BMI column                          ; the end's right of the start: where it is
    CMP #2:BCC column                   ; under half a turn left of it: facing away
    LDA walk_u1+1:ADC #3:STA walk_u1+1  ; (C set) a turn on: the eye's cell's last side
.column
    SCREEN_ANGLE_TO_COLUMN walk_u1
    STA walk_c1
    RTS
}

\\ The walk's side's ends as its lines see them (edge_ends): the logs of their depths, and of the
\\ side's columns. The side must have columns.
\\
\\ Inputs:
\\     walk_vi and the walk: its side, and its ends' screen angles, entries and columns
\\     viewleft: the view's left edge
\\
\\ Outputs:
\\     logdepth0, logdepth1: 256 log2 of the start's and end's depths, in whole units
\\     logcolumns: 256 log2 of the side's columns
\\     A, X, Y: corrupted

.edge_ends
{
    \\ the columns' log, and an end in view: its distance's log less its view angle's log secant

    SEC:LDA walk_c1:SBC walk_c0:TAX
    LOG2_8
    STA logcolumns:STY logcolumns+1
    LDA walk_u0+1:BMI start             ; the start's left of the view
    LDA walk_u0
    LOG_SECANT
    LDY walk_e0
    SEC
    LDA vc_logdistlo,Y:SBC lsec,X:STA logdepth0
    LDA vc_logdisthi,Y:SBC #0:STA logdepth0+1
.start
    LDA walk_u1+1:BNE out               ; the end's right of the view
    LDA walk_u1
    LOG_SECANT
    LDY walk_e1
    SEC
    LDA vc_logdistlo,Y:SBC lsec,X:STA logdepth1
    LDA vc_logdisthi,Y:SBC #0:STA logdepth1+1
    LDA walk_u0+1:BMI out
    RTS                                 ; both in view

    \\ an end out of view, in front or behind: where the side's line crosses the view's edge's
    \\ ray (Doom's clipper). The end in view (or the start, if neither is) is the line's distance
    \\ from the eye over |sin| of its angle from the line, that over |sin| of the ray's angle from
    \\ the line is the distance along the ray, and cos 45 degrees (-128 in the log) makes it a depth

    ZA_AUTO2 direction                  ; local: the side's world angle
    ZA_AUTO2 bearing                    ; local: the end's angle from it
    ZA_AUTO2 logline                    ; local: the log of the line's distance, less 128
    ZA_AUTO2 logsine                    ; local: the bearing's log sine, negated, + 128
    ZA_AUTO2 ray                        ; local: the left edge's ray's angle from the side's, less 1

.out
    LDX walk_vi:LDY visit_side,X
    LDX side_edge,Y
    LDA edge_angle,X:STA direction
    LDA side_anghi,Y:STA direction+1
    LDY walk_e0                         ; the start, unless the end's in view
    LDA walk_u1+1:BNE bear
    LDY walk_e1
.bear
    SEC
    LDA vc_anglo,Y:SBC direction:STA bearing
    LDA vc_anghi,Y:SBC direction+1:STA bearing+1
    LDA vc_logdistlo,Y:STA logline
    LDA vc_logdisthi,Y:STA logline+1
    LDX bearing:LDA bearing+1
    LOG_SINE
    TXA:TAY                             ; Y: the bearing's
    SEC
    LDA bearing:SBC #1:TAX
    LDA bearing+1:SBC #0
    LOG_SINE                            ; X: the step before's
    SEC                                 ; + 1: the C halves the sum negated, rounding down
    LDA lsec16lo,X:ADC lsec16lo,Y:STA logsine
    LDA lsec16hi,X:ADC lsec16hi,Y
    ADC #1                              ; + 256: halved, the 128 off (C clear)
    LSR A:ROR logsine
    STA logsine+1
    SEC
    LDA logline:SBC logsine:STA logline
    LDA logline+1:SBC logsine+1:STA logline+1
    CLC                                 ; (the - 1)
    LDA viewleft:SBC direction:STA ray
    LDA viewleft+1:SBC direction+1:STA ray+1
    LDA walk_u0+1:BPL end               ; the start's in view
    LDX ray:LDA ray+1
    LOG_SINE
    CLC
    LDA logline:ADC lsec16lo,X:STA logdepth0
    LDA logline+1:ADC lsec16hi,X:STA logdepth0+1
.end
    LDA walk_u1+1:BEQ done              ; the end's in view
    LDX ray:LDA ray+1:EOR #1            ; the right edge's ray: a quarter turn on
    LOG_SINE
    CLC
    LDA logline:ADC lsec16lo,X:STA logdepth1
    LDA logline+1:ADC lsec16hi,X:STA logdepth1+1
.done
    RTS
}

\\ The walk's side's line at a height (make_line): its columns on the screen and its rows, from its
\\ ends' depths. An end too near, past the screen's edge, cuts it where it reaches the edge.
\\
\\ Inputs:
\\     X, A: the height, as the visits hold it: the log's low byte, then its high, below in bit 7
\\     walk_c0, walk_c1: the side's columns
\\     logdepth0, logdepth1, logcolumns: its ends (edge_ends)
\\
\\ Outputs:
\\     line_x0, line_x1: the line's columns, none if they're the same
\\     line_y, line_grad, line_endy: its rows, if it has columns
\\     line_below: the height's side
\\     A, X, Y: corrupted

.make_line
{
    ZA_AUTO2 logoffset0                 ; local: the start's offset's log (l0)
    ZA_AUTO2 logoffset1                 ; local: and the end's (l1)
    ZA_AUTO1 near                       ; local: bit 7 the end's too near, bit 6 the start's
    ZA_AUTO2 offset0                    ; local: the start's offset from the middle row (o0)
    ZA_AUTO2 offset1                    ; local: and the end's (o1)
    ZA_AUTO2 rise                       ; local: their difference, unsigned (dr)
    ZA_AUTO1 sign                       ; local: &80 if the rows go up along the line
    ZA_AUTO2 loggrad                    ; local: the gradient's log, an end too near (lg)

    TAY
    AND #&80:STA line_below
    LDA walk_c0:STA line_x0:STA line_x1 ; no columns, until it has some
    TYA:AND #&7F:BNE log                ; the log's high byte: 17 on, or 0 at the eye's height

    \\ at the eye's height: flat, on the middle row

    LDA walk_c1:STA line_x1
    LDA #LO(LINE_MIDDLE):STA line_y
    LDA #HI(LINE_MIDDLE):STA line_y+1:STA line_endy
    LDA #0:STA line_grad:STA line_grad+1
    RTS

    \\ the ends' offsets from the middle row, u8.8: 2^(the height's log less the depth's). An end
    \\ whose offset's log reaches 13 * 256, 32 rows, is too near: past the screen's edge

.log
    TAY
    TXA:SEC:SBC logdepth0:STA logoffset0
    TYA:SBC logdepth0+1:STA logoffset0+1
    CLC:BMI far0                        ; (CLC keeps N)
    CMP #EDGE_LOG
.far0
    ROR near                            ; bit 7: the start's too near
    TXA:SEC:SBC logdepth1:STA logoffset1
    TYA:SBC logdepth1+1:STA logoffset1+1
    CLC:BMI far1
    CMP #EDGE_LOG
.far1
    ROR near:BPL offsets                ; bit 7: the end's, and bit 6 the start's
    BIT near:BVC offsets
    RTS                                 ; both too near: none

    \\ an end on the screen: its offset's under 32 rows, or 0 under 0. One too near can saturate

.offsets
    BIT near:BVC start_on
    LDX logoffset0:LDA logoffset0+1
    JSR exp2_sat
    JMP start_offset
.start_on
    LDX logoffset0:LDY logoffset0+1:BPL start_exp
    LDA #0:TAY
    BEQ start_offset                    ; (always)
    ZA_UNREACHABLE
.start_exp
    EXP2_16 EDGE_LOG
.start_offset
    STA offset0:STY offset0+1
    BIT near:BPL end_on
    LDX logoffset1:LDA logoffset1+1
    JSR exp2_sat
    JMP end_offset
.end_on
    LDX logoffset1:LDY logoffset1+1:BPL end_exp
    LDA #0:TAY
    BEQ end_offset                      ; (always)
    ZA_UNREACHABLE
.end_exp
    EXP2_16 EDGE_LOG
.end_offset
    STA offset1:STY offset1+1

    \\ the rows run away from the middle as the offset grows, down below the eye and up above it:
    \\ the offsets' subtract's borrow is the gradient's sign

    SEC:SBC offset0:STA rise
    TYA:SBC offset0+1
    BCS ahead                           ; the end's offset at or past the start's
    TAX                                 ; the start's less the end's (C clear)
    LDA rise:EOR #&FF:ADC #1:STA rise
    TXA:EOR #&FF:ADC #0:STA rise+1
    LDA line_below:STA sign             ; a shrinking offset goes up below the eye
    JMP gradient
.ahead
    STA rise+1
    LDA line_below:EOR #&80:STA sign    ; and a growing one above it

    \\ both ends on the screen: each offset is under 32 rows, and so is their difference, a byte in
    \\ eighths of a row, rounded, which takes a byte's log; 5 * 256 takes eighths back to 256ths

.gradient
    BIT near:BMI near_end
    BVC both
.near_end
    JMP nearend
.both
    CLC
    LDA rise:ADC #16:STA rise           ; + a sixteenth: rounded
    LDA rise+1:ADC #0                   ; the high byte, up to 32
    CMP #HI(EDGE_OFFSET):BCS most       ; 32 rows on: 256 eighths, kept to 255
    ASL rise:ROL A
    ASL rise:ROL A
    ASL rise:ROL A                      ; the eighths: the high byte, x 8
    TAX:BNE eighths
    TAY                                 ; under a sixteenth all along: flat
    BEQ grad                            ; (always)
    ZA_UNREACHABLE
.most
    LDX #255
.eighths
    LOG2_8                              ; A: the fraction, Y: the whole part
    SEC:SBC logcolumns:TAX
    TYA:SBC logcolumns+1
    CLC:ADC #5
    JSR exp2_sat                        ; under 32 rows a column: it never saturates
.grad
    STA line_grad:STY line_grad+1
    ORA line_grad+1:BEQ graded          ; 0: no sign (pt_g_make)
    TYA:ORA sign:STA line_grad+1
.graded

    \\ both ends on the screen: the line has all the side's columns

    BIT near:BMI cut
    BVS cut
    LDA walk_c1:STA line_x1
    OFFSET_ROW offset0
    STX line_y:STA line_y+1
    OFFSET_ROW offset1
    STA line_endy
    RTS

    \\ one end too near: the far end's columns towards where the line crosses the screen's edge,
    \\ ceil(the distance) of them counting its own (CMP #1 on the low byte, ADC #0 into the high).
    \\ The far end's distance from the edge is under 32 rows, a byte in eighths of a row, rounded
    \\ (at least one), with a byte's log: 5 * 256 back to 256ths, and 8 * 256 for the count's
    \\ fraction, less the gradient's log. The last column counted is still on the screen

    ZA_AUTO1 count                      ; local: the columns counted (cnt)
    ZA_AUTO1 togo                       ; local: the far end's distance from the edge's low byte
    ZA_AUTO1 back                       ; local: the columns back from the end, the start too near

.cut
    SEC:LDA walk_c1:SBC walk_c0
    STA count                           ; at most all the side's columns (dc)
    BIT near:BVS startnear
    SEC
    LDA #LO(EDGE_OFFSET+16):SBC offset0:STA togo
    LDA #HI(EDGE_OFFSET+16):SBC offset0+1
    JMP distance
.startnear
    SEC
    LDA #LO(EDGE_OFFSET+16):SBC offset1:STA togo
    LDA #HI(EDGE_OFFSET+16):SBC offset1+1
.distance
    CMP #HI(EDGE_OFFSET):BCS farthest   ; 32 rows on: 256 eighths, kept to 255
    ASL togo:ROL A
    ASL togo:ROL A
    ASL togo:ROL A                      ; the eighths: the high byte, x 8
    TAX
    BNE counting                        ; (always: at least one)
    ZA_UNREACHABLE
.farthest
    LDX #255
.counting
    LOG2_8                              ; A: the fraction, Y: the whole part
    SEC:SBC loggrad:TAX
    TYA:SBC loggrad+1
    CLC:ADC #13
    JSR exp2_sat                        ; the columns, u8.8
    CPY count:BCS counted               ; all the side's
    CMP #1                              ; C: a fraction
    TYA:ADC #0:STA count
.counted
    LDA count:BNE some
    RTS                                 ; none
.some
    BIT near:BVS backwards

    \\ the end too near: from the start, cnt columns, and the row at the last

    OFFSET_ROW offset0
    STX line_y:STA line_y+1
    STX row_move.row:STA row_move.row+1
    CLC:LDA walk_c0:ADC count:STA line_x1
    LDX count:DEX:TXA
    SEC                                 ; forwards
    JSR row_move
    LDA row_move.row+1:STA line_endy
    RTS

    \\ the start too near: back from the end, cnt - 1 columns, from the row g (cnt - 1) nearer the
    \\ screen's edge; just the end's own column is none

.backwards
    LDX count:DEX:BEQ none
    STX back
    OFFSET_ROW offset1
    STA line_endy
    STX row_move.row:STA row_move.row+1
    SEC:LDA walk_c1:SBC back:STA line_x0
    LDA walk_c1:STA line_x1
    LDA back
    CLC                                 ; back
    JSR row_move
    LDA row_move.row:STA line_y
    LDA row_move.row+1:STA line_y+1
.none
    RTS

    \\ an end too near: its offset's 32 rows or more, hundreds even, and the clip finds where the
    \\ line crosses the screen's edge from the gradient: from the difference in 16 bits, and past
    \\ 256 rows, where the offset saturates, in whole rows (it's then 224 of them at least)

    ZA_AUTO2 rows0                      ; local: the start's offset in whole rows (w0)
    ZA_AUTO2 apart                      ; local: the ends' offsets' difference in them (dw)

.nearend
    LDA offset0:AND offset0+1:CMP #&FF:BEQ saturated
    LDA offset1:AND offset1+1:CMP #&FF:BEQ saturated
    LDA rise:LDX rise+1
    LOG2_16 16                          ; A: the fraction, X: the whole part
    SEC:SBC logcolumns:STA loggrad
    TXA:SBC logcolumns+1:STA loggrad+1
    JMP capped
.saturated
    LDX logoffset0:LDA logoffset0+1
    SEC:SBC #8                          ; less 8 * 256: in whole rows
    JSR exp2_sat
    STA rows0:STY rows0+1
    LDX logoffset1:LDA logoffset1+1
    SEC:SBC #8
    JSR exp2_sat
    SEC:SBC rows0:STA apart
    TYA:SBC rows0+1:STA apart+1
    BCS ordered
    LDA apart:EOR #&FF:ADC #1:STA apart ; (C clear) the start's less the end's
    LDA apart+1:EOR #&FF:ADC #0:STA apart+1
.ordered
    LDA apart:LDX apart+1
    LOG2_16 16                          ; A: the fraction, X: the whole part
    SEC:SBC logcolumns:STA loggrad
    TXA:SBC logcolumns+1
    CLC:ADC #8:STA loggrad+1            ; 8 * 256: whole rows back to 256ths
.capped
    LDX loggrad:LDA loggrad+1
    JSR exp2_sat
    CPY #&80:BCC near_grad
    LDA #&FF:LDY #&7F                   ; kept to &7FFF, under the sign's bit
.near_grad
    JMP grad
}

\\ 2^(l / 256) (render.c's exp2_sat): 0 under 0, and &FFFF from 16 * 256 on.
\\
\\ Inputs:
\\     X: l's low byte
\\     A: its high byte, signed
\\
\\ Outputs:
\\     A: the low byte
\\     Y: the high byte
\\     X: preserved

.exp2_sat
{
    TAY:BMI none                        ; under 0
    CPY #16:BCS full                    ; 16 * 256 on
    EXP2_16 16
    RTS
.none
    LDA #0:TAY
    RTS
.full
    LDA #&FF:TAY
    RTS
}

\\ A row moved along the line by some columns (row_move), forwards or back. The C checks it stays
\\ on the screen, rows 0 to 64; this doesn't.
\\
\\ Inputs:
\\     A: the columns
\\     C: set to move forwards (rightwards), clear to move back
\\     row: the row, u8.8
\\     line_grad: the line's gradient
\\
\\ Outputs:
\\     row: moved
\\     A, X, Y: corrupted

.row_move
{
    ZA_AUTO2 row                        ; in/out: the row
    ZA_AUTO1 way                        ; local: bit 7 set to add
    ZA_AUTO2 move                       ; local: the gradient times the columns

    ROR way                             ; bit 7: forwards
    MULTIPLIER                          ; by the columns
    LDA line_grad+1:EOR way:STA way     ; forwards on a falling line, or back on a rising one: add
    LDA line_grad+1:AND #&7F:TAY
    MULTIPLY                            ; X: the whole part's product's low byte
    STX move+1
    LDY line_grad
    MULTIPLY                            ; X, A: the fraction's product
    STX move
    CLC:ADC move+1:STA move+1           ; 16 bits, as the row stays on the screen
    BIT way:BPL subtract
    CLC
    LDA row:ADC move:STA row
    LDA row+1:ADC move+1:STA row+1
    RTS
.subtract
    SEC
    LDA row:SBC move:STA row
    LDA row+1:SBC move+1:STA row+1
    RTS
}

\\ Cell X's visit, made if this capture has none for it yet (visit_of): the next, with the cell's
\\ heights as its lines see them.
\\
\\ Inputs:
\\     X: the cell
\\     eye_z: the eye's height
\\
\\ Outputs:
\\     X: its visit

.visit_of
{
    LDA cell_visit,X:BEQ make           ; not met yet
    TAX
    RTS
.make
    LDY num_visits                      ; the new visit, counted at the end
    TYA:STA cell_visit,X
    TXA:STA visit_cell,Y
    LDA #0:STA visit_side,Y:STA visit_xr,Y:STA visit_kept,Y
    LDA cell_ceilz,X
    HEIGHT_OF
    LDY num_visits
    STA visit_hchi,Y
    TXA:STA visit_hclo,Y
    LDX visit_cell,Y                    ; the cell again
    LDA cell_floorz,X
    HEIGHT_OF
    LDY num_visits
    STA visit_hfhi,Y
    TXA:STA visit_hflo,Y
    LDX num_visits
    INC num_visits
    RTS
}
