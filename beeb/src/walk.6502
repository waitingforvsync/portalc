\ **************************************************************************
\ *
\ *     walk.6502 - the capture walk (render.c; spec 7.4, 7.5, 7.8)
\ *
\ **************************************************************************
\
\ A cell's visit is a field a table (scratch.6502), shared by every later
\ visit of the cell that frame. Visits of one cell run in increasing x and
\ never nest, so the visit holds the portal being walked as well as the
\ ring cursor: where the next edge's span starts (vs_x), the portal's end
\ (vs_xr), and its bounds' cursors and row extents. The walk recurses on
\ the visit alone: a descent pushes it, its edges left and the call's
\ pending count round the JSR (D15), and a visit's last child is a tail
\ call, a JMP.

ZA_AUTO1 fr_cell                ; the camera's cell
ZA_AUTO1 num_visits             ; the visits so far, plus 1 (0 is the null visit)
ZA_AUTO1 depth                  ; the walk's nesting: the root visit's is 1
ZA_AUTO1 capsp                  ; S inside capture, for an overflow to unwind to (D9)

\ ---- visits ----

\\ Transform map vertex X: tf_*.
.tf_vertex
{
    LDA vx_lo,X : SEC : SBC fr_camx : STA rot.x     ; (transform's first step)
    LDA vx_hi,X : SBC fr_camx + 1 : STA rot.x + 1
    LDA vy_lo,X : SEC : SBC fr_camy : STA rot.y
    LDA vy_hi,X : SBC fr_camy + 1 : STA rot.y + 1
    JMP transform.rel
}

\\ Visit Y's end vertex from tf_*. Keeps X and Y.
.vs_set1
{
    LDA tf_x : STA vs1_xl,Y
    LDA tf_x + 1 : STA vs1_xh,Y
    LDA tf_y : STA vs1_yl,Y
    LDA tf_y + 1 : STA vs1_yh,Y
    LDA tf_sx : STA vs1_sx,Y
    LDA tf_flags : STA vs1_fl,Y
    LDA tf_f : STA vs1_f,Y
    LDA tf_e : STA vs1_e,Y
    RTS
}

\\ Visit Y's end vertex becomes its start. Keeps X and Y.
.vs_shift
{
    LDA vs1_xl,Y : STA vs0_xl,Y
    LDA vs1_xh,Y : STA vs0_xh,Y
    LDA vs1_yl,Y : STA vs0_yl,Y
    LDA vs1_yh,Y : STA vs0_yh,Y
    LDA vs1_sx,Y : STA vs0_sx,Y
    LDA vs1_fl,Y : STA vs0_fl,Y
    LDA vs1_f,Y : STA vs0_f,Y
    LDA vs1_e,Y : STA vs0_e,Y
    RTS
}

\\ Visit Y's end vertex, transformed: that of the edge after its cursor's,
\\ in cell X. Keeps X and Y.
.vs_next1
{
    ZA_AUTO1 vs, c              ; local
    STY vs : STX c
    LDA vs_k,Y : CLC : ADC #1   ; the ring's next edge...
    CMP c_num,X : BCC @+
    LDA #&FF                    ; (wrapped: C is set, so the add makes it 0)
.@  ADC c_first,X : TAX
    LDA e_v0,X : TAX            ; ...its start vertex
    JSR tf_vertex
    LDY vs
    JSR vs_set1
    LDX c
    RTS
}

\\ Cell X's visit, made on first need: when an edge into it is first
\\ clipped, so that the clip can build its bounds there. A new one has no
\\ active pieces and isn't walked yet (vs_xr 0); its cursor, vertices,
\\ columns and sprite instance are set when it's entered. The tables hold
\\ a visit a cell, and a cell has a visit at most, so they never fill.
\\ out: Y = the visit. Keeps X.
.visit_of
{
    LDY cell_visit,X : BNE done
    LDY num_visits
    INC num_visits
    TXA : STA vs_cell,Y
    TYA : STA cell_visit,X
    LDA #0 : STA vs_xr,Y
    FOR s = 0 ..< PT_NUM_SLOTS
        STA vs_act + s * VISITS,Y
    NEXT
.done
    RTS
}

\\ Move visit Y's cursor (cell X) to the next edge: its end vertex becomes
\\ the start, and that edge's lines start afresh. Keeps X and Y.
.visit_advance
{
    LDA vs_k,Y : CLC : ADC #1   ; the ring's next edge
    CMP c_num,X : BCC @+
    LDA #0
.@  STA vs_k,Y
    JSR vs_shift
    JSR vs_next1
    LDA #0
    FOR s = 0 ..< PT_NUM_SLOTS
        STA vs_act + s * VISITS,Y
    NEXT
    RTS
}

\\ Enter visit vi over [xl, xr) through edge ei of the cell before, its
\\ bounds already in place: the cursor goes to the cell's first edge (spec
\\ 7.4), the first whose end vertex is strictly right of xl. A first walk
\\ searches from P, the portal's start vertex (ev_*[0]), whose edge is the
\\ twin's ring successor, and projects the cell's sprite. A later one
\\ resumes from the edge its last walk ended on (every earlier edge ends
\\ left of that walk's xr, which is at or left of xl), with that edge's
\\ vertices and its lines' last pieces in hand. (render.c's degenerate-ring
\\ guard is dead, D10.) in: vi, ei, xl, xr, ev_*[0]. out: A = vi.
.enter
{
    ZA_AUTO1 vi, ei, xl, xr     ; in
    LDY vi : LDX vs_cell,Y
    LDA vs_xr,Y : BNE seek      ; walked before: from where it ended
    LDY ei
    LDA e_twin,Y                ; first: the twin's ring index...
    SEC : SBC c_first,X
    CLC : ADC #1                ; ...and its successor's
    CMP c_num,X : BCC @+
    LDA #0
.@  LDY vi : STA vs_k,Y
    LDA ev_xl : STA vs0_xl,Y    ; v0 = P
    LDA ev_xh : STA vs0_xh,Y
    LDA ev_yl : STA vs0_yl,Y
    LDA ev_yh : STA vs0_yh,Y
    LDA ev_sx : STA vs0_sx,Y
    LDA ev_flags : STA vs0_fl,Y
    LDA ev_f : STA vs0_f,Y
    LDA ev_e : STA vs0_e,Y
    JSR vs_next1
.seek                           ; to the first edge ending strictly right of xl
    LDY vi : LDA xl : JSR col_gt : BCS found
    LDY vi : LDX vs_cell,Y
    JSR visit_advance
    JMP seek
.found
    LDY vi
    LDA vs_xr,Y : BNE walked
    LDX vs_cell,Y : JSR inst_new    ; a first walk: the cell's sprite
    LDY vi : STA vs_inst,Y
.walked
    LDA xl : STA vs_x,Y
    LDA xr : STA vs_xr,Y
    TYA
    RTS
}

\ ---- one edge of the walk (spec 7.8) ----

\\ Process visit vi's current edge, the one its cursor is on: its lines,
\\ and the child through it, if any, entered. A line with a piece on this
\\ edge already is in screen space (edge_line); only a line not yet made
\\ on it is projected. in: vi. out: A = the child's visit, 0 for none.
.process_edge
{
    ZA_AUTO1 vi                 ; in
    ZA_AUTO1 ca, ei, xa, xb     ; local: the cell, the edge, and its span
    ZA_AUTO1 adj, ci, bv        ; local: the cell beyond, its visit, and the visit its
                                ; bounds are built in (0, scratch: walked over these columns)
    ZA_AUTO1 wle, wlo           ; local: the wall's colour
    ZA_AUTO1 cae, cao, cfe, cfo ; local: this cell's ceiling and floor colours
    ZA_AUTO1 bce, bco, bfe, bfo ; local: the cell beyond's
    ZA_AUTO1 ol, orr            ; local: the child's columns
    LDY vi : STY el_vis
    LDX vs_cell,Y : STX ca
    LDA vs_k,Y : CLC : ADC c_first,X : STA ei
    LDA vs0_sx,Y : STA ev_sx    ; the edge's vertices, as far as its span needs
    LDA vs0_fl,Y : STA ev_flags
    LDA vs1_sx,Y : STA ev_sx + 1
    LDA vs1_fl,Y : STA ev_flags + 1

    \ 1. the column span, from the vertices' flags and columns. None for an
    \ edge wholly left of the left ray, or starting past the right ray (its
    \ sx0 of 128 is xa, at or past xb: render.c's arm for that start is
    \ folded in here), or starting on that ray and ending past it.
    BIT ev_flags : BMI aneg : BVS none
    LDA ev_flags : AND #VF_BZERO : BEQ @+
    BIT ev_flags + 1 : BVS none
.@  LDA ev_sx
    JMP sx0
.none
    LDA #0
    RTS
.aneg
    LDA ev_flags + 1 : AND #VF_ANEG OR VF_AZERO : BNE none
    \ (A = 0: the start's column)
.sx0
    STA el_sx0
    CMP vs_x,Y : BCS @+         ; xa: from where the last span ended, at least
    LDA vs_x,Y
.@  STA xa
    BIT ev_flags + 1 : BVS right
    BMI left
    LDA ev_sx + 1
    JMP sx1
.right
    LDA #128
    BNE sx1                     ; (always)
.left
    LDA #0
.sx1
    STA el_sx1
    CMP vs_xr,Y : BCC @+        ; xb: to the portal's end, at most
    LDA vs_xr,Y
.@  STA xb
    CMP xa : BEQ none : BCC none
    STA vs_x,Y
    LDX vs_tcur,Y : LDA xa : JSR piece_at   ; the bounds' pieces at xa (chains only
    LDY vi : TXA : STA vs_tcur,Y            ; ever gain pieces, never lose them)
    LDX vs_bcur,Y : LDA xa : JSR piece_at
    LDY vi : TXA : STA vs_bcur,Y
    LDA #0 : STA el_have
    LDA vs0_xl,Y : STA ev_xl    ; the start vertex whole: the child's P, if any
    LDA vs0_xh,Y : STA ev_xh
    LDA vs0_yl,Y : STA ev_yl
    LDA vs0_yh,Y : STA ev_yh
    LDA vs0_f,Y : STA ev_f
    LDA vs0_e,Y : STA ev_e
    LDX ei
    LDA e_colour,X : BNE drawn

    \ 2. a soft edge is level both ways and has no lines: it hands the bounds
    \ on as they are. A cell already walked over these columns can only be a
    \ rounding mishap with the eye on a vertex: it isn't entered again.
    LDA e_adj,X : TAX
    JSR visit_of
    LDA vs_xr,Y : CMP xa : BEQ @+ : BCC @+
    LDA #0                      ; (not entered)
    RTS
.@  LDX vi
    LDA vs_tcur,X : STA vs_tcur,Y
    LDA vs_bcur,X : STA vs_bcur,Y
    LDA vs_tmax,X : STA vs_tmax,Y
    LDA vs_bmin,X : STA vs_bmin,Y
    STY enter.vi
    LDA ei : STA enter.ei
    LDA xa : STA enter.xl
    LDA xb : STA enter.xr
    JMP enter

.drawn
    LDY vi                      ; the end vertex whole, for the lines
    LDX vs1_xl,Y : STX ev_xl + 1
    LDX vs1_xh,Y : STX ev_xh + 1
    LDX vs1_yl,Y : STX ev_yl + 1
    LDX vs1_yh,Y : STX ev_yh + 1
    LDX vs1_f,Y : STX ev_f + 1
    LDX vs1_e,Y : STX ev_e + 1
    LDX vs_tmax,Y : STX cx_tmax ; every line of the edge clips against the bounds' extents
    LDX vs_bmin,Y : STX cx_bmin ; (the ceiling line's, against its bottom's, once it's built)
    TAY                         ; the wall's shade, plus 1
    LDA shade_e - 1,Y : STA wle
    LDA shade_o - 1,Y : STA wlo
    LDX ca
    LDY c_ceil,X
    LDA shade_e,Y : STA cae
    LDA shade_o,Y : STA cao
    LDY c_floor,X
    LDA shade_e,Y : STA cfe
    LDA shade_o,Y : STA cfo
    LDA #ST_NONE : STA cx_shut
    LDX ei
    LDY e_adj,X : BNE portal

    \ 3. a solid wall: its ceiling line and floor line, merges only
    LDX ca : LDA c_ceilz,X : JSR set_h
    LDA cae : EOR wle : STA l_ce
    LDA cao : EOR wlo : STA l_co
    LDA #PT_SLOT_CEIL : JSR plain
    LDX ca : LDA c_floorz,X : JSR set_h
    LDA wle : EOR cfe : STA l_ce
    LDA wlo : EOR cfo : STA l_co
    LDA #PT_SLOT_FLOOR : JSR plain
    LDA #0
    RTS

.portal
    STY adj
    LDX c_ceil,Y
    LDA shade_e,X : STA bce
    LDA shade_o,X : STA bco
    LDX c_floor,Y
    LDA shade_e,X : STA bfe
    LDA shade_o,X : STA bfo

    \ 3. the lines forming no bound go first: merges only, against the
    \ bounds intact. Where the two cells' ceilings (or floors) are level,
    \ the line there forms no bound either: everything seen past it is
    \ farther, so on the screen it's below a level ceiling's line and above
    \ a level floor's, and the child just keeps the parent's bound on that
    \ side. The line is then only a change of colour, and isn't even made
    \ if the shades match too.
    LDX ca
    LDA c_ceilz,X : CMP c_ceilz,Y : BCS @+
    JSR set_h                   ; a lintel down to the cell beyond's ceiling
    LDA cae : EOR wle : STA l_ce
    LDA cao : EOR wlo : STA l_co
    LDA #PT_SLOT_CEIL : JSR plain
    JMP floors
.@  BNE floors                  ; (the cell beyond's ceiling higher: its line's a bound)
    LDA cae : EOR bce : STA l_ce    ; level: a change of colour, if any
    LDA cao : EOR bco : STA l_co
    ORA l_ce : BEQ floors
    LDA c_ceilz,X : JSR set_h
    LDA #PT_SLOT_CEIL_BOUND : JSR plain
.floors
    LDX ca : LDY adj
    LDA c_floorz,Y : CMP c_floorz,X : BCS @+
    LDA c_floorz,X : JSR set_h  ; a riser up to the cell beyond's floor
    LDA wle : EOR cfe : STA l_ce
    LDA wlo : EOR cfo : STA l_co
    LDA #PT_SLOT_FLOOR : JSR plain
    JMP bounds
.@  BNE bounds                  ; (the cell beyond's floor lower: its line's a bound)
    LDA bfe : EOR cfe : STA l_ce    ; level: a change of colour, if any
    LDA bfo : EOR cfo : STA l_co
    ORA l_ce : BEQ bounds
    LDA c_floorz,X : JSR set_h
    LDA #PT_SLOT_FLOOR_BOUND : JSR plain

    \ 4. the lines forming the child's bounds, built into its visit (visit
    \ 0, scratch, for a cell already walked over these columns: the eye on
    \ a vertex). The floor line goes first, building the child's bottom
    \ against the parent's two bounds; it closes the child where it's above
    \ the top. The ceiling line then builds the top against the parent's
    \ top and the child's bottom, over the columns the floor line left
    \ open: where that one closed the child, the ceiling line's above the
    \ top as well, and merges with nothing evaluated. A level side has no
    \ line: the child shares the parent's bound there.
.bounds
    LDX adj : JSR visit_of
    STY ci
    LDA vs_xr,Y : CMP xa : BEQ @+ : BCC @+
    LDY #0
.@  STY bv
    LDA bce : EOR bfe : STA cx_cbfbe
    LDA bco : EOR bfo : STA cx_cbfbo
    LDA bv : STA cx_child
    LDA xa : STA ol
    LDA xb : STA orr
    LDX ca : LDY adj
    LDA c_floorz,Y : CMP c_floorz,X : BNE floorline
    LDX vi : LDY bv             ; level: the parent's bottom
    LDA vs_bcur,X : STA vs_bcur,Y
    LDA vs_bmin,X : STA vs_bmin,Y
    JMP ceiling
.floorline
    BCS lower
    JSR set_h                   ; a riser: at the cell beyond's floor (A = it)
    LDA bfe : EOR wle : STA l_ce
    LDA bfo : EOR wlo : STA l_co
    JMP fset
.lower
    LDA c_floorz,X : JSR set_h  ; lower beyond: at this cell's floor
    LDA bfe : EOR cfe : STA l_ce
    LDA bfo : EOR cfo : STA l_co
.fset
    LDY bv
    LDA #0 : STA vs_bcur,Y
    LDA #PT_SCREEN_HEIGHT : STA vs_bmin,Y
    LDA #ST_ABOVE : STA cx_shut
    JSR fresh
    LDA #PT_SLOT_FLOOR_BOUND : JSR edge_line
    LDA xa : STA clip_line.c
    LDA xb : STA clip_line.c1
    JSR clip_line
    JSR run_end
    LDA cx_ol : LDX cx_orr
    CMP cx_orr : BCC @+
    LDA xb : TAX                ; nothing left open
.@  STA ol : STX orr
.ceiling
    LDX ca : LDY adj
    LDA c_ceilz,X : CMP c_ceilz,Y : BNE ceilline
    LDX vi : LDY bv             ; level: the parent's top
    LDA vs_tcur,X : STA vs_tcur,Y
    LDA vs_tmax,X : STA vs_tmax,Y
    JMP child
.ceilline
    BCS higher
    LDA c_ceilz,Y : JSR set_h   ; a lintel: at the cell beyond's ceiling
    LDA wle : EOR bce : STA l_ce
    LDA wlo : EOR bco : STA l_co
    JMP cset
.higher
    JSR set_h                   ; higher beyond: at this cell's ceiling (A = it)
    LDA cae : EOR bce : STA l_ce
    LDA cao : EOR bco : STA l_co
.cset
    LDY bv
    LDA #0 : STA vs_tcur,Y : STA vs_tmax,Y
    LDA #ST_NONE : STA cx_shut
    JSR fresh
    LDY bv : LDA vs_bcur,Y : STA cx_p + 1       ; against the child's bottom
    LDA vs_bmin,Y : STA cx_bmin
    LDA #PT_SLOT_CEIL_BOUND : JSR edge_line
    LDA xa : STA merge_above.c
    LDA ol : STA merge_above.c1
    JSR merge_above
    LDA ol : CMP orr : BCS @+
    STA clip_line.c
    LDA orr : STA clip_line.c1
    LDA #ST_BELOW : STA cx_shut
    JSR clip_line
    JSR run_end
    LDA #ST_NONE : STA cx_shut
.@  LDA orr : STA merge_above.c
    LDA xb : STA merge_above.c1
    JSR merge_above
    LDA cx_ol : STA ol
    LDA cx_orr : STA orr

    \ 5. the child: the run of columns the two lines left open
.child
    LDA ol : CMP orr : BCS closed
    LDA bv : BNE into
    LDA ol : STA close_columns.l    ; walked over these columns already: closed
    LDA orr : STA close_columns.rr  ; after the fact
    LDA cx_cbfbe : STA close_columns.cbe
    LDA cx_cbfbo : STA close_columns.cbo
    LDX vs_bcur
    JSR close_columns
.closed
    LDA #0
    RTS
.into
    STA enter.vi
    LDA ei : STA enter.ei
    LDA ol : STA enter.xl
    LDA orr : STA enter.xr
    JMP enter

\ One of the edge's lines forming no bound, in slot A at height h in
\ colour l_ce, l_co: clipped from the bounds' cursors at the span's start,
\ merges only.
.plain
    LDY vi
    LDX vs_tcur,Y : STX cx_p
    LDX vs_bcur,Y : STX cx_p + 1
    LDX #0 : STX cx_own
    JSR edge_line               ; (and its active piece)
    LDA xa : STA clip_line.c
    LDA xb : STA clip_line.c1
    JMP clip_line

\ A bound-forming line's clip, afresh: from the parent's cursors (the
\ ceiling line's bottom is the child's, after), nothing built or open yet.
.fresh
    LDY vi
    LDA vs_tcur,Y : STA cx_p
    LDA vs_bcur,Y : STA cx_p + 1
    LDA #0
    STA cx_tail : STA cx_own
    STA cx_rl : STA cx_rr : STA cx_ol : STA cx_orr
    RTS
}

\\ The height A from the eye (render.c's rel_h): h_m, h_below.
.set_h
{
    SEC : SBC fr_eyez : BCS below
    EOR #&FF : ADC #1           ; above the eye: eye - z (C clear)
    STA h_m
    LDA #0 : STA h_below
    RTS
.below
    STA h_m
    LDA #1 : STA h_below
    RTS
}

\ ---- the frame (spec 7.1, 7.4, 7.5) ----

\\ The transform of edge A's start vertex: tf_*.
.tf_edge
{
    TAX
    LDA e_v0,X : TAX
    JMP tf_vertex
}

\\ Find the camera cell's root edge, where the ray sum a goes from <= 0 to
\\ > 0, and begin the cell's visit on it (it's never revisited: every ray
\\ starts in it), walking the root portal, the whole screen. The search is
\\ guarded: with the eye on the cell's boundary the rounded sums can read
\\ one-sided, and root_exact decides instead. (The root bounds are the
\\ caller's, in the visit's vs_tcur and vs_bcur.)
.root_visit
{
    ZA_AUTO1 n, guard           ; local: the edge, the tries left
    ZA_AUTO1 first, last        ; local: the cell's ring
    LDX fr_cell
    JSR visit_of                ; (visit 1)
    LDA c_num,X : STA guard
    LDA c_first,X : STA first : STA n
    CLC : ADC guard : STA last
    DEC last
    LDA n : JSR tf_edge
.search                         ; to a vertex with a <= 0...
    LDA tf_flags : AND #VF_ANEG OR VF_AZERO : BNE found
    LDA guard : BEQ exact
    DEC guard
    JSR succ : STA n
    JSR tf_edge
    JMP search
.found
    LDY #1 : JSR vs_set1 : JSR vs_shift
    LDX fr_cell : LDA c_num,X : STA guard
.forward                        ; ...then on to the first ending at a > 0
    JSR succ : JSR tf_edge
    LDY #1 : JSR vs_set1
    LDA tf_flags : AND #VF_ANEG OR VF_AZERO : BEQ rooted
    JSR vs_shift
    JSR succ : STA n
    LDA guard : BEQ exact
    DEC guard
    JMP forward
.exact
    JSR root_exact : STA n
    JSR tf_edge
    LDY #1 : JSR vs_set1 : JSR vs_shift
    JSR succ : JSR tf_edge
    LDY #1 : JSR vs_set1
.rooted
    LDA n : SEC : SBC first : STA vs_k + 1
    LDA #0 : STA vs_x + 1 : STA vs_tmax + 1
    LDA #128 : STA vs_xr + 1
    LDA #PT_SCREEN_HEIGHT : STA vs_bmin + 1
    LDX fr_cell : JSR inst_new
    STA vs_inst + 1
    RTS

\ A = n's ring successor.
.succ
    LDA n : CMP last : BCS wrap
    ADC #1                      ; (C clear)
    RTS
.wrap
    LDA first
    RTS
}

\\ The exact retry behind root_visit (cold: boundary poses only). The
\\ exact ray sums a = rx k1 + ry k2 are linear in the world offsets, so on a
\\ convex ring they go from a < 0 to a >= 0 exactly once: the root edge is
\\ the one ending there. (render.c's eye-vertex fallback is dead in these
\\ maps, D10.) out: A = the edge.
.root_exact
{
    ZA_AUTO1 k, prev            ; local: the ring position; last a < 0 (bit 7)
    ZA_AUTO 4, sum              ; local: a
    LDA fr_angle : JSR ray_basis
    LDA #0 : STA k : STA prev
.vertex
    LDX fr_cell
    LDA k : CMP c_num,X : BCC @+
    IF HARNESS
        BEQ wrap
        TRAP 6                  ; no transition: the dead fallback
    ENDIF
.wrap
    LDA #0
.@  CLC : ADC c_first,X : TAX
    LDY e_v0,X
    LDA vx_lo,Y : SEC : SBC fr_camx : STA muls16.m
    LDA vx_hi,Y : SBC fr_camx + 1 : STA muls16.m + 1
    LDA ray_basis.k1 : STA muls16.k
    LDA ray_basis.k1 + 1 : STA muls16.k + 1
    TYA : PHA
    JSR muls16
    LDX #3
.keep
    LDA muls16.p,X : ZA_INDEXEDBY 0..3
    STA sum,X : ZA_INDEXEDBY 0..3
    DEX : BPL keep
    PLA : TAY
    LDA vy_lo,Y : SEC : SBC fr_camy : STA muls16.m
    LDA vy_hi,Y : SBC fr_camy + 1 : STA muls16.m + 1
    LDA ray_basis.k2 : STA muls16.k
    LDA ray_basis.k2 + 1 : STA muls16.k + 1
    JSR muls16
    CLC
    FOR i = 0 ..< 4
        LDA sum + i : ADC muls16.p + i : STA sum + i
    NEXT
    BMI below                   ; (A = the top byte)
    BIT prev : BMI found        ; a >= 0 after a < 0
.below
    STA prev
    INC k
    JMP vertex
.found
    LDX fr_cell
    LDA k : CLC : ADC c_first,X
    SEC : SBC #1
    RTS
}

\\ p = m * k, signed 16 by 16 bits to 32 (root_exact's sums).
.muls16
{
    ZA_AUTO2 m, k               ; in (both made magnitudes)
    ZA_AUTO 4, p                ; out
    ZA_AUTO1 neg                ; local: the product's sign, bit 7
    LDA m + 1 : EOR k + 1 : STA neg
    LDA m + 1 : BPL @+
    LDA #0 : SEC : SBC m : STA m
    LDA #0 : SBC m + 1 : STA m + 1
.@  LDA k + 1 : BPL @+
    LDA #0 : SEC : SBC k : STA k
    LDA #0 : SBC k + 1 : STA k + 1
.@  LDA k : SETMUL              ; |m| * |k|.lo...
    LDY m : MULX : STX p : STA p + 1
    LDY m + 1 : MULX : STA p + 2
    TXA : CLC : ADC p + 1 : STA p + 1
    LDA #0 : ADC p + 2 : STA p + 2
    LDA #0 : STA p + 3
    LDA k + 1 : SETMUL          ; ...+ |m| * |k|.hi, a byte up
    LDY m : MULX
    PHA : TXA
    CLC : ADC p + 1 : STA p + 1
    PLA : ADC p + 2 : STA p + 2
    LDA #0 : ADC p + 3 : STA p + 3
    LDY m + 1 : MULX
    PHA : TXA
    CLC : ADC p + 2 : STA p + 2
    PLA : ADC p + 3 : STA p + 3
    BIT neg : BPL done
    SEC
    FOR i = 0 ..< 4
        LDA #0 : SBC p + i : STA p + i
    NEXT
.done
    RTS
}

\\ Walk visit A (spec 7.5): each edge of its cell from the one its cursor's
\\ on, until an edge ends at or right of xr. A child through an earlier
\\ edge is walked one level down, the visit, its edges left and the
\\ pending count pushed round the JSR (D15), and the visit carries on from
\\ its own column when it returns; the last edge's child is walked here, a
\\ tail call, so the depth grows only with portals nested along a line of
\\ sight. Past the depth cap a child's columns are closed instead. A ring
\\ with no closing column (rooted at a zero vertex) ends when its steps
\\ run out.
.walk
{
    ZA_AUTO1 vi, steps, last    ; local: the visit; the edges left; this one ends at or past xr
    ZA_AUTO1 pend               ; local: the pending count at entry (this call's portals
    STA vi                      ; leave theirs above it)
    LDA num_pend : STA pend
.visit
    LDA vi : JSR seg_record
    LDY vi : LDX vs_cell,Y
    LDY c_num,X : INY : STY steps
.edge
    LDA steps : BNE @+
    JMP issue                   ; the steps ran out
.@  DEC steps
    LDY vi : LDA vs_xr,Y : JSR col_ge
    LDA #0 : ROL A : STA last
    LDA vi : STA process_edge.vi
    JSR process_edge
    LDX last : BEQ notlast
    TAX : BNE tail
    JMP issue                   ; the last edge, no child
.tail
    STA vi                      ; the tail call
    JMP visit
.notlast
    TAX : BEQ advance
    LDX depth : CPX #PT_MAX_DEPTH : BCS cap
    TAX
    LDA vi : PHA                ; descend
    LDA steps : PHA
    LDA pend : PHA
    INC depth
    TXA : JSR walk
    DEC depth
    PLA : STA pend
    PLA : STA steps
    PLA : STA vi
.advance
    LDY vi : LDX vs_cell,Y
    JSR visit_advance
    JMP edge
.cap                            ; past the cap: the child's ceiling EOR floor, flat
    TAY
    LDX vs_cell,Y
    LDA vs_x,Y : STA close_columns.l
    LDA vs_xr,Y : STA close_columns.rr
    LDA vs_bcur,Y : PHA
    LDY c_ceil,X
    LDA shade_e,Y : STA close_columns.cbe
    LDA shade_o,Y : STA close_columns.cbo
    LDY c_floor,X
    LDA shade_e,Y : EOR close_columns.cbe : STA close_columns.cbe
    LDA shade_o,Y : EOR close_columns.cbo : STA close_columns.cbo
    PLA : TAX
    JSR close_columns
    JMP advance
.issue                          ; every portal of this call pops here, the tail
    LDA pend                    ; call's innermost first
    JMP inst_issue
}

\\ The frame's capture: the root bounds, then the walk from the root visit.
\\ in: fr_camx, fr_camy, fr_angle, fr_cell. out: C set if a capacity
\\ overflowed and the frame was dropped (D9).
.capture
{
    TSX : STX capsp
    LDA #0                      ; no visits yet (cell_visit shares its memory with the
    LDX #MAP_NUM_CELLS - 1      ; sprite pass's state: the last frame's was there)
.clear
    STA cell_visit,X
    DEX : BPL clear
    STA order_head : STA order_tail : STA num_pend
    LDA #1 : STA num_insts : STA seg_next
    LDX fr_cell
    LDA c_floorz,X : SEC : SBC #PT_CAM_HEIGHT : STA fr_eyez
    IF HARNESS
        LDA ovf_pool            ; the abort check's way to overflow (0 otherwise)
    ELSE
        LDA #0
    ENDIF
    STA pool_last
    LDA #1 : STA num_visits : STA depth
    \ the root bounds: a plotted top, seeding the fill with the cell's
    \ ceiling, and a dummy bottom off the screen, both on their rows' middles
    LDY c_ceil,X
    POOL_NEW : STX vs_tcur + 1
    LDA shade_e,Y : STA p_ce,X
    LDA shade_o,Y : STA p_co,X
    LDA #0 : STA p_y0,X
    STA p_x0,X : STA p_glo,X : STA p_ghi,X : STA p_next,X
    LDA #128 : STA p_x1,X : STA p_yf,X
    POOL_NEW : STX vs_bcur + 1
    LDA #0 : STA p_ce,X : STA p_co,X
    STA p_x0,X : STA p_glo,X : STA p_ghi,X : STA p_next,X
    LDA #128 : STA p_x1,X : STA p_yf,X
    LDA #PT_SCREEN_HEIGHT : STA p_y0,X
    JSR root_visit
    LDA #1 : JSR walk
    CLC
    RTS
}

\\ A capacity overflow inside capture (OVERFLOW): unwind to it, count it,
\\ and drop the frame. out: C set.
.capture_abort
{
    LDX capsp : TXS
    INC aborts
    SEC
    RTS
}
