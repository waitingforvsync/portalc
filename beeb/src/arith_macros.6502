\\ arith_macros.6502 - the arithmetic macros: arith.c's logs, exps and polar forms.
\\ A log is 256 log2: a fraction byte and a whole part, from the loader's tables.

\\ 256 log2 b, as pt_log2_8.
\\
\\ Inputs:
\\     X: b, 1 to 255
\\
\\ Outputs:
\\     A: the fraction
\\     Y: the whole part
\\     X: preserved

MACRO LOG2_8
    LDY nrm,X:LDA logf,Y                ; the bits under b's leading one: exact
    LDY k8,X:DEY                        ; b's bit length, less 1
ENDMACRO

\\ 256 log2 x, as pt_log2, for x under 2^bits: the bound picks how the low byte is shifted.
\\
\\ Inputs:
\\     bits: x's bound, 9 to 16 (a byte's log is LOG2_8's)
\\     A: x's low byte
\\     X: x's high byte, loaded last, so Z is set if it's 0 (x >= 1)
\\
\\ Outputs:
\\     A: the fraction
\\     X: the whole part
\\     Y: corrupted

MACRO LOG2_16 bits
    ASSERT bits >= 9 AND bits <= 16, "LOG2_16: x under 2^9 to 2^16 (a byte's is LOG2_8's)"

    BNE big
    TAY                                 ; under 256: the low byte's log
    LDX k8,Y
    LDA nrm,Y:TAY:LDA logf,Y
    DEX:BPL done                        ; (always: 0 to 7)
    ZA_UNREACHABLE
.big
    IF bits == 9
        TAY:LDX #8:LDA logf,Y           ; the high byte is 1: the low byte is the rest, exactly
    ELSE

        \\ the low byte shifted down k - 1, k the high byte's bit length: C, the last bit out

        IF bits == 10
            CPX #2:BCC join             ; k = 1: none, C clear
            LSR A                       ; k = 2
        ELIF bits == 11
            CPX #2:BCC join             ; k = 1: none, C clear
            CPX #4:BCC one              ; k = 2
            LSR A                       ; k = 3
.one
            LSR A
        ELIF bits == 12
            CPX #4:BCS three            ; k = 3 or 4
            CPX #2:BCC join             ; k = 1: none, C clear
            BCS one                     ; k = 2 (always)
            ZA_UNREACHABLE
.three
            CPX #8:BCC two              ; k = 3
            LSR A                       ; k = 4
.two
            LSR A
.one
            LSR A
        ELSE

            \\ k from 1 up, a compare each; at 16 bits, past k = 2, k = 6 on split off

            CPX #2:BCC join             ; k = 1: none, C clear
            CPX #4:BCC one              ; k = 2
            IF bits == 16
                CPX #32:BCS high        ; k = 6 on
            ENDIF
            CPX #8:BCC two              ; k = 3
            CPX #16:BCC three           ; k = 4
            IF bits == 13
                BCS four                ; k = 5 (always)
                ZA_UNREACHABLE
            ELIF bits == 14
                CPX #32:BCC four        ; k = 5, else 6
                BCS five                ; (always)
                ZA_UNREACHABLE
            ELIF bits == 15
                CPX #32:BCC four        ; k = 5
                CPX #64:BCC five        ; k = 6, else 7
                BCS six                 ; (always)
                ZA_UNREACHABLE
            ELSE
                BCS four                ; k = 5 (always)
                ZA_UNREACHABLE
.high
                CPX #64:BCC five        ; k = 6
                CPX #128:BCC six        ; k = 7, else 8
            ENDIF
            IF bits == 16
.seven
                LSR A
            ENDIF
            IF bits >= 15
.six
                LSR A
            ENDIF
            IF bits >= 14
.five
                LSR A
            ENDIF
.four
            LSR A
.three
            LSR A
.two
            LSR A
.one
            LSR A
        ENDIF

        \\ the rest of x under its leading one, rounded, and k

.join
        ORA nrm,X:ADC #0                ; a carry out is the next octave's 0
        TAY
        LDA k8,X:ADC #7:TAX             ; 7 + k, and that carry
        LDA logf,Y
    ENDIF
.done
ENDMACRO

\\ 2^(l / 256), as pt_exp2, for l under 8 * 256: a byte, or 256.
\\
\\ Inputs:
\\     X: l's low byte
\\     Y: l's high byte, 0 to 7
\\
\\ Outputs:
\\     A: the byte
\\     C: set if it's 256, with A 0
\\     X, Y: preserved

MACRO EXP2_8
    STY skip+1                          ; 7 - Y shifts: the run's first Y skipped
    LDA expf,X:SEC:ROR A                ; 1.f halved, its 1 from C
.skip
    BMI run                             ; (always: bit 7 is set) self-modified
.run
    LSR A:LSR A:LSR A:LSR A:LSR A:LSR A:LSR A
    ADC #0                              ; rounded by the last bit out
ENDMACRO

\\ The polar form of point X from the camera, as pt_vcache_vert makes it: pt_polar_of of its
\\ offset from the middle of the camera's whole-unit square, in half units, its log less 256.
\\
\\ Inputs:
\\     index: the answer's index, in zero page
\\     xlo, xhi, ylo, yhi: the points' coordinate tables
\\     anglo, anghi, logdistlo, logdisthi: the tables the answer goes in
\\     X: the point
\\     camx, camy: the camera, in whole units
\\
\\ Outputs:
\\     anglo,Y: the world angle's step within its quadrant
\\     anghi,Y: the quadrant
\\     logdistlo,Y, logdisthi,Y: 256 log2 of the distance, in whole units (pt_polar's lr)
\\     Y: the index
\\     A, X: corrupted

MACRO POLAR index, xlo, xhi, ylo, yhi, anglo, anghi, logdistlo, logdisthi
    ZA_AUTO1 quadrant                   ; local: 0 to 3
    ZA_AUTO1 flip                       ; local: &FF to flip atan's byte: steep and odd differ
    ZA_AUTO2 major                      ; local: the major component, in half units
    ZA_AUTO2 minor                      ; local: and the minor
    ZA_AUTO2 logmajor                   ; local: the major's log

    \\ x's offset, as d = v - cam - 1, the C's being 2d + 1 (never 0): its magnitude is 2d + 1,
    \\ or 2(d EOR &FFFF) + 1 for d < 0. Into major, for now

    ZA_AUTO1 xsign                      ; local: x's sign, in bit 7

    CLC
    LDA xlo,X:SBC camx:TAY
    LDA xhi,X:SBC camx+1:STA xsign
    BPL xpos
    EOR #&FF:STA major+1
    TYA:EOR #&FF
    SEC:BCS xmag                        ; (always)
    ZA_UNREACHABLE
.xpos
    STA major+1
    TYA:SEC
.xmag
    ROL A:STA major:ROL major+1         ; C clear: major+1 was under &80

    \\ y's, into minor, and the quadrant from the signs: bit 1 y's, bit 0 x's EOR y's (odd)

    LDA ylo,X:SBC camy:TAY              ; (C clear: the - 1)
    LDA yhi,X:SBC camy+1:TAX
    ASL A                               ; C: y's sign
    TXA:EOR xsign
    ROL A:ROL A:AND #3:STA quadrant
    LSR A                               ; C: odd
    LDA #0:SBC #0:STA flip              ; &FF if even: the flip if steep
    TXA:BPL ypos
    EOR #&FF:STA minor+1
    TYA:EOR #&FF
    SEC:BCS ymag                        ; (always)
    ZA_UNREACHABLE
.ypos
    STA minor+1
    TYA:SEC
.ymag
    ROL A:STA minor:ROL minor+1         ; C clear, as for x

    \\ steep, uy > ux: then y's is the major

    SBC major                           ; minor - major - 1
    LDA minor+1:SBC major+1             ; C: steep
    BCS steep
    LDA flip:EOR #&FF:STA flip          ; not steep: the flip if odd
    BCC logs                            ; (always)
    ZA_UNREACHABLE
.steep
    LDA major:LDX minor:STA minor:STX major
    LDA major+1:LDX minor+1:STA minor+1:STX major+1

    \\ the logs: l, the minor's less the major's, + 8 * 256, is a byte exp's, as the minor's never
    \\ the larger

.logs
    ZA_AUTO1 logminorhi                 ; local: the minor's log's whole part

    LDA major:LDX major+1
    LOG2_16 MAP_OFFSET_BITS
    STA logmajor:STX logmajor+1
    LDA minor:LDX minor+1
    LOG2_16 MAP_OFFSET_BITS
    STX logminorhi
    SEC:SBC logmajor:TAX                ; l's low byte
    LDA logminorhi:SBC logmajor+1       ; and its high, less 8
    BEQ equal                           ; l = 8 * 256: the logs are the same
    CMP #&F8:BCS ratio
    LDX #0:BEQ answer                   ; l < 0: r = 0 (always)
    ZA_UNREACHABLE

    \\ equal: 45 degrees, atan's 128, and lhyp's

.equal
    LDY index
    LDA #128:CLC:ADC logmajor           ; logmajor + 128 - 256
    STA logdistlo,Y
    LDA logmajor+1:ADC #&FF:STA logdisthi,Y
    LDA #128:BNE angle                  ; (always)
    ZA_UNREACHABLE

    \\ r, 256 * minor / major, and the answer from atan and lhyp

.ratio
    AND #7:TAY
    EXP2_8
    BCS equal                           ; 256
    TAX
.answer
    LDY index
    LDA lhyp,X:CLC:ADC logmajor         ; logmajor + lh - 256
    STA logdistlo,Y
    LDA logmajor+1:ADC #&FF:STA logdisthi,Y
    LDA atan,X
.angle
    EOR flip:STA anglo,Y
    LDA quadrant:STA anghi,Y
ENDMACRO

\\ The view angle's log secant for an in-view screen angle u (pt_log_secant of u - 128): where in
\\ lsec it is. A distance's log less it is the depth's.
\\
\\ Inputs:
\\     A: u, 0 to 255
\\
\\ Outputs:
\\     X: the place in lsec of 256 log2 sec, at the middle of u's step
\\     A: corrupted

MACRO LOG_SECANT
    EOR #&80                            ; the view angle, u - 128
    BPL right                           ; right of straight ahead: itself
    EOR #&FF                            ; left of it: its middle is |v| - 0.5 on, ~v
.right
    TAX
ENDMACRO

\\ A 10-bit angle a's log sine, negated (pt_log_sine): where in lsec16 it is. Only a's low 9 bits
\\ count, as sin over the half turn mirrors about the right angle.
\\
\\ Inputs:
\\     X: a's low byte
\\     A: its high byte
\\
\\ Outputs:
\\     X: the place in lsec16 of -256 log2 |sin a|, at the middle of a's step
\\     A: corrupted

MACRO LOG_SINE
    LSR A                               ; bit 8 into C
    TXA
    BCS second                          ; 256 to 511: cos of a - 256, there
    EOR #&FF                            ; 0 to 255: cos of 255 - a
.second
    TAX
ENDMACRO

\\ 2^(l / 256), as pt_exp2, for l under bits * 256: below 8 * 256, EXP2_8's byte, or 256; from
\\ there, 1.f shifted up exactly, k = n - 8 times, the bound picking how.
\\
\\ Inputs:
\\     bits: the result's bound, 2^9 to 2^16
\\     X: l's low byte
\\     Y: its high byte, n, under bits
\\
\\ Outputs:
\\     A: the low byte
\\     Y: the high byte
\\     X: preserved

MACRO EXP2_16 bits
    ASSERT bits >= 9 AND bits <= 16, "EXP2_16: a result under 2^9 to 2^16 (a byte's is EXP2_8's)"
    ZA_AUTO1 high                       ; local: 1.f's high byte, shifted up

    CPY #8:BCS big
    EXP2_8                              ; A: the byte, C: 256 (with A 0)
    LDY #0
    BCC done
    INY
    BNE done                            ; (always)
    ZA_UNREACHABLE
.big
    IF bits == 9
        LDA expf,X:LDY #1               ; n = 8: no shift
    ELIF bits <= 13

        \\ a compare for each k, from the most: then a pair of shifts for each

        LDA #1:STA high                 ; 1.f's 1
        LDA expf,X
        IF bits == 13
            CPY #12:BCS four
        ENDIF
        IF bits >= 12
            CPY #11:BCS three
        ENDIF
        IF bits >= 11
            CPY #10:BCS two
        ENDIF
        CPY #9:BCS one
        BCC shifted                     ; (always) k = 0: none
        ZA_UNREACHABLE
        IF bits == 13
.four
            ASL A:ROL high
        ENDIF
        IF bits >= 12
.three
            ASL A:ROL high
        ENDIF
        IF bits >= 11
.two
            ASL A:ROL high
        ENDIF
.one
        ASL A:ROL high
.shifted
        LDY high
    ELSE

        \\ into a run of seven pairs of shifts at the k-th from its end (exp2_skip's), self-modified

        LDA exp2_skip-8,Y:STA skip+1
        LDA #1:STA high                 ; 1.f's 1
        LDA expf,X
.skip
        BCS run                         ; (always: C set) self-modified
.run
        FOR i = 1..7
            ASL A:ROL high
        NEXT
        LDY high
    ENDIF
.done
ENDMACRO

\\ Ready the multiply by a (pt_mulu8's quarter squares): the pointers at a in sq1, and at 255 - a
\\ in sq2, so (ptr),Y reads sq1[a + Y] and sq2[255 - a + Y].
\\
\\ Inputs:
\\     A: a
\\
\\ Outputs:
\\     sq1loptr to sq2hiptr: at a
\\     A: corrupted

MACRO MULTIPLIER
    STA sq1loptr:STA sq1hiptr
    EOR #&FF
    STA sq2loptr:STA sq2hiptr
ENDMACRO

\\ a * Y (pt_mulu8): (a + Y)^2 / 4 - (a - Y)^2 / 4, for the a MULTIPLIER readied.
\\
\\ Inputs:
\\     Y: the other byte
\\     sq1loptr to sq2hiptr: at a
\\
\\ Outputs:
\\     X: the product's low byte
\\     A: its high byte
\\     Y: preserved

MACRO MULTIPLY
    LDA (sq1loptr),Y:SEC:SBC (sq2loptr),Y
    TAX
    LDA (sq1hiptr),Y:SBC (sq2hiptr),Y
ENDMACRO

\\ The step from which a quadrant's sine rounds to 1 (arith.h's PT_SIN_ONE): sinq's 256s from it.

SIN_ONE = 256-SUM(ROUND(256*SIN((0..255)*(PI/512))) == 256)

\\ A 10-bit angle's sine (or cosine), as pt_mul_sin's sin_mag has it: its magnitude at scale 256,
\\ from sinq at j, or at 256 - j where it runs down from 1 (quadrants 1 and 3; for a cosine 0, 2).
\\
\\ Inputs:
\\     angle: the angle
\\     cosine: TRUE for its cosine (its sine a quarter turn on)
\\
\\ Outputs:
\\     A: the magnitude, unless it's 1
\\     C: set if it's 1 (256)
\\     X: corrupted
\\     Y: preserved

MACRO SINE angle, cosine
    LDA angle+1:LSR A:LDA angle
    IF cosine
        BCC falling                     ; the quadrant a quarter turn on: odd
    ELSE
        BCS falling
    ENDIF
    CMP #SIN_ONE:BCS done               ; from it on, 1
    TAX:LDA sinq,X                      ; (C clear)
    BCC done                            ; (always)
    ZA_UNREACHABLE
.falling
    CMP #256-SIN_ONE+1:BCC one          ; under it, 1
    EOR #&FF:TAX:LDA sinq+1,X           ; 256 - j
    CLC
    BCC done                            ; (always)
    ZA_UNREACHABLE
.one
    SEC
.done
ENDMACRO

\\ v times a 10-bit angle's sine or cosine (pt_mul_sin, pt_mul_cos): |v| times the magnitude, the
\\ low byte's product rounded (mulu16_frac_round), then signed by v's sign and the angle's.
\\
\\ Inputs:
\\     v: the value, signed, never -32768
\\     angle: the angle
\\     product: where the product goes
\\     cosine: TRUE for the cosine
\\
\\ Outputs:
\\     product: v sin angle (or cos), signed
\\     v: corrupted (its magnitude)
\\     A, X, Y: corrupted

MACRO MULTIPLY_SINE v, angle, product, cosine
    ZA_AUTO1 sign                       ; local: bit 7 the product's

    LDA angle+1
    IF cosine
        LSR A:EOR angle+1               ; the quadrant a quarter turn on's high bit: its two bits'
    ELSE                                ; EOR
        LSR A
    ENDIF
    LSR A                               ; C: the lower half turn
    LDA #0:ROR A
    EOR v+1:STA sign
    LDA v+1:BPL positive
    LDA #0:SEC:SBC v:STA v
    LDA #0:SBC v+1:STA v+1
.positive
    SINE angle, cosine
    BCC fraction
    LDA v:STA product                   ; times 1
    LDA v+1:STA product+1
    JMP signed
.fraction
    MULTIPLIER
    LDY v:MULTIPLY
    STA product                         ; the low byte's product's high byte
    TXA:ASL A                           ; C: its low byte's top bit, the rounding
    LDA product:ADC #0:STA product
    LDY v+1:MULTIPLY
    STA product+1
    TXA:CLC:ADC product:STA product
    LDA product+1:ADC #0:STA product+1
.signed
    BIT sign:BPL done
    LDA #0:SEC:SBC product:STA product
    LDA #0:SBC product+1:STA product+1
.done
ENDMACRO

\\ n whole units times a 10-bit angle's sine or cosine, in 256ths: pt_mul_sin of n shifted up 8,
\\ exactly n times the magnitude, as the low byte's product is 0.
\\
\\ Inputs:
\\     n: the units, under 128
\\     angle: the angle
\\     product: where the product goes
\\     cosine: TRUE for the cosine
\\
\\ Outputs:
\\     product: n sin angle (or cos), s.8
\\     A, X, Y: corrupted

MACRO UNITS_SINE n, angle, product, cosine
    SINE angle, cosine
    BCC fraction
    LDA #0:STA product                  ; times 1
    LDA n:STA product+1
    JMP signed
.fraction
    MULTIPLIER
    LDY n:MULTIPLY
    STX product:STA product+1
.signed
    LDA angle+1
    IF cosine
        LSR A:EOR angle+1               ; bit 0: the quadrant a quarter turn on's high bit
        AND #1
    ELSE
        AND #2                          ; the quadrant's high bit
    ENDIF
    BEQ done                            ; the upper half turn
    LDA #0:SEC:SBC product:STA product
    LDA #0:SBC product+1:STA product+1
.done
ENDMACRO

\\ The component of (ux, uy) along a 10-bit angle (pt_dot_dir): ux cos angle + uy sin angle.
\\
\\ Inputs:
\\     ux, uy: the vector, each under 2^14 either way
\\     angle: the angle
\\     sum: where the component goes
\\
\\ Outputs:
\\     sum: the component, signed
\\     ux, uy: corrupted (their magnitudes)
\\     A, X, Y: corrupted

MACRO DOT_DIRECTION ux, uy, angle, sum
    ZA_AUTO2 along                      ; local: uy's part

    MULTIPLY_SINE ux, angle, sum, TRUE
    MULTIPLY_SINE uy, angle, along, FALSE
    CLC
    LDA sum:ADC along:STA sum
    LDA sum+1:ADC along+1:STA sum+1
ENDMACRO

\\ A value times a fraction f (pt_mulu16_frac): (value f) >> 8, exact, the low byte's product's low
\\ byte dropped.
\\
\\ Inputs:
\\     value: 16 bits
\\     f: the fraction, 256ths
\\     product: where the product goes
\\
\\ Outputs:
\\     product: (value f) >> 8
\\     A, X, Y: corrupted

MACRO MULTIPLY_FRACTION value, f, product
    LDA f:MULTIPLIER
    LDY value:MULTIPLY
    STA product                         ; the low byte's product's high byte
    LDY value+1:MULTIPLY
    STA product+1
    TXA:CLC:ADC product:STA product
    LDA product+1:ADC #0:STA product+1
ENDMACRO
