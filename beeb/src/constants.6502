\\ constants.6502 - the engine's constants, as the C has them.

SCREEN_WIDTH = 128                      ; canvas columns (mode5.h)
SCREEN_HEIGHT = 64                      ; canvas rows, two scanlines each
MAX_VERTS = 64                          ; the map's caps (map.h's PT_MAX_): size tables by these
MAX_CELLS = 32
MAX_VISITS = 31                         ; render.h's PT_MAX_VISITS: with entry 0, 8 tables a page
IF DEFINED(depth_cap)                   ; a check's lower cap (test/walk3_portal.6502), so it's met
    MAX_DEPTH = depth_cap
ELSE
    MAX_DEPTH = 16                      ; render.h's PT_MAX_DEPTH: portals nested along a sightline
ENDIF
MAX_KEPT = 8                            ; render.h's PT_MAX_KEPT: sides' lines kept, entry 0 null
CAM_HEIGHT = 10                         ; the eye above its cell's floor, in z steps (render.h)
MAX_VCACHE = 63                         ; vcache.h's PT_MAX_VCACHE: with entry 0, four tables a page
MAX_RECS = 128                          ; render.h's PT_MAX_RECS: runs plotted in a frame
MAX_SPRITES = 8                         ; map.h's PT_MAX_SPRITES: with sprite 0, none
MAX_INSTANCES = MAX_SPRITES             ; render.h's PT_MAX_INSTS: sprites seen, entry 0 null
CLIP_POOL = 768                         ; render.h's PT_CLIP_POOL: the sprites' clip rows' bytes
SPRITE_NEAR_L = 5*256                   ; render.h's PT_SPRITE_NEAR_L: nearer, a sprite's not drawn
IN_FWD = 1                              ; the input bits (camera.h's PT_IN_)
IN_BACK = 2
IN_LEFT = 4                             ; strafe
IN_RIGHT = 8
IN_TURNL = 16
IN_TURNR = 32
CAM_RADIUS = 40                         ; the camera's circle, in units (camera.h)
CAM_TURN_SPEED = 4                      ; its turn a tick, in 1024ths (camera.h)
CAM_MOVE_SPEED = 3                      ; its move a tick, in units (camera.h)
CAM_MAX_TICKS = 4                       ; a tick call's at most (camera.h)
POST_NEAR = 256                         ; d2 under this: on top of a post, left alone
POST_SCALE = 1.25*2^15                  ; a post's 1/d2: its quarter's overcorrection, and q15
