\\ test/arith.6502 - make test's check of the arithmetic macros: LOG2_8, LOG2_16, EXP2_8, POLAR, the
\\ sines' multiplies and MULTIPLY_FRACTION, over every input or sums of them, for host/test_build.py.

TEST_CAM = &1000                        ; POLAR's camera, both ways

\\ POLAR's points, x and y alike, as offsets from the camera: near, every one from -128 to 127,
\\ and far, a grid out to the bound (the longest half-unit offset 2^bits - 1)

FAR_STEP = 1 << (MAP_OFFSET_BITS - 8)
near_x = TEST_CAM - 128 + (0..255)
far_x = TEST_CAM - (1 << (MAP_OFFSET_BITS - 1)) + 1 + FAR_STEP*(0..255)

SECTION TestResults
.t_log8f    SKIP &100                   ; LOG2_8's fraction, by b
.t_log8w    SKIP &100                   ; and whole part
.t_log16s1  SKIP &200                   ; LOG2_16's Fletcher sums: bound b's by x's high byte,
.t_log16s2  SKIP &200                   ; from 2^(b - 8) - 2
.t_exp1     SKIP 8                      ; EXP2_8's Fletcher sums, by l's high byte
.t_exp2     SKIP 8
.t_pnear1   SKIP &100                   ; POLAR's Fletcher sums near, by y's index
.t_pnear2   SKIP &100
.t_pfar1    SKIP &100                   ; and far
.t_pfar2    SKIP &100
.t_bits     SKIP 1                      ; MAP_OFFSET_BITS, the far grid's bound
.t_usin1    SKIP &100                   ; UNITS_SINE's sums, by angle DIV 4
.t_usin2    SKIP &100
.t_ucos1    SKIP &100                   ; and its cosine's
.t_ucos2    SKIP &100
.t_msin1    SKIP &100                   ; MULTIPLY_SINE's
.t_msin2    SKIP &100
.t_mcos1    SKIP &100
.t_mcos2    SKIP &100
.t_dot1     SKIP &100                   ; DOT_DIRECTION's
.t_dot2     SKIP &100
.t_frac1    SKIP &100                   ; MULTIPLY_FRACTION's, by the fraction
.t_frac2    SKIP &100
ENDSECTION

SECTION Frame                           ; POLAR's workspace: the loader's, before the engine's
.t_pylo       SKIP &100                 ; a row's y, at every point
.t_pyhi       SKIP &100
.t_palo       SKIP &100                 ; a row's answers
.t_pahi       SKIP &100
.t_plogdistlo SKIP &100
.t_plogdisthi SKIP &100
ENDSECTION

\\ Run each macro over every input it takes, and store the answers.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     t_log8f to t_frac2: the answers

.test_arith
{
    \\ LOG2_8

    LDX #1
.log8
    LOG2_8
    STA t_log8f,X
    TYA:STA t_log8w,X
    INX
    BNE log8

    \\ LOG2_16, at every bound

    FOR b = 9..16
        TEST_LOG2_16 b
    NEXT

    \\ EXP2_8, a high byte at a time, in Y, which it keeps: each one's answers into a pair of sums,
    \\ the byte, then the carry

    ZA_AUTO1 sum1                       ; local: the sum of the answers' bytes
    ZA_AUTO1 sum2                       ; local: and the sum of the sums

    LDY #0
.erow
    LDA #0:STA sum1:STA sum2
    LDX #0
.ecol
    EXP2_8
    PHP                                 ; C: 256
    FLETCHER sum1, sum2
    PLP
    LDA #0:ROL A
    FLETCHER sum1, sum2
    INX
    BNE ecol
    LDA sum1:STA t_exp1,Y
    LDA sum2:STA t_exp2,Y
    INY:CPY #8
    BNE erow

    \\ POLAR, near and far

    LDA #LO(TEST_CAM):STA camx:STA camy
    LDA #HI(TEST_CAM):STA camx+1:STA camy+1
    TEST_POLAR t_nearxlo, t_nearxhi, t_pnear1, t_pnear2
    TEST_POLAR t_farxlo, t_farxhi, t_pfar1, t_pfar2
    LDA #MAP_OFFSET_BITS:STA t_bits

    \\ the sines' multiplies, and MULTIPLY_FRACTION

    TEST_SINE 0, FALSE, t_usin1, t_usin2
    TEST_SINE 0, TRUE, t_ucos1, t_ucos2
    TEST_SINE 1, FALSE, t_msin1, t_msin2
    TEST_SINE 1, TRUE, t_mcos1, t_mcos2
    TEST_SINE 2, FALSE, t_dot1, t_dot2
    TEST_FRACTION t_frac1, t_frac2
    RTS
}

    FITPAGE &100
.t_nearxlo  EQUB LO(near_x)
    FITPAGE &100
.t_nearxhi  EQUB HI(near_x)
    FITPAGE &100
.t_farxlo   EQUB LO(far_x)
    FITPAGE &100
.t_farxhi   EQUB HI(far_x)
