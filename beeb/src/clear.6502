\\ clear.6502 - clearing T and the screens: T must start each frame empty.

ASSERT LO(T_ORG) == 0 AND T_JUNK+&100 == SCREEN_A AND SCREEN_A+&1000 == SCREEN_B AND SCREEN_B+&1000 == &8000, "T and the screens are whole pages, running on to &8000"

\\ Clear T, its junk row and both screens: whole pages, T_ORG to &8000, the
\\ STA's operand stepping on, self-modified, from T's page.

.clear_buffers
{
    LDA #HI(T_ORG):STA loop+2
    LDA #0:TAY
    LDX #HI(&8000-T_ORG)                ; pages
.loop
    STA T_ORG,Y
    INY
    BNE loop
    INC loop+2                          ; the operand's high byte
    DEX
    BNE loop

    \\ Enable screen display
    
    LDA #8:STA &FE00
    LDA #&C0:STA &FE01
    RTS
}
