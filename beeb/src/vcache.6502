\\ vcache.6502 - the vertex cache: vertices' polar forms from the camera, made as they're needed.
\\ It keeps no position, so the camera resets it whenever camx or camy changes.

ASSERT MAX_VCACHE < 256, "the vertex cache: an entry's number is a byte"
ASSERT MAX_VERTS <= 256, "the vertex cache: a vertex's number is a byte"

ZA_AUTO1 vc_num                         ; the last entry made: 0 when empty

\\ The entries are numbered from 1: entry 0's bytes are unused.

SECTION Persist
    FITPAGE MAX_VERTS
.vc_slot      SKIP MAX_VERTS            ; each vertex's entry, 0 for none
    FITPAGE MAX_VCACHE+1
.vc_vert      SKIP MAX_VCACHE+1         ; each entry's vertex
    FITPAGE MAX_VCACHE+1
.vc_anglo     SKIP MAX_VCACHE+1         ; its world angle: the step within the quadrant
    FITPAGE MAX_VCACHE+1
.vc_anghi     SKIP MAX_VCACHE+1         ; and the quadrant, 0 to 3
    FITPAGE MAX_VCACHE+1
.vc_logdistlo SKIP MAX_VCACHE+1         ; 256 log2 of its distance, in whole units (pt_polar's lr)
    FITPAGE MAX_VCACHE+1
.vc_logdisthi SKIP MAX_VCACHE+1
ENDSECTION

\\ Empty the cache, clearing only the slots its entries hold.
\\
\\ Inputs:
\\     vc_num: the entries
\\
\\ Outputs:
\\     vc_num: 0

.vcache_reset
{
    LDX vc_num:BEQ done
    LDA #0
.loop
    LDY vc_vert,X:STA vc_slot,Y
    DEX
    BNE loop
    STX vc_num
.done
    RTS
}

\\ Make vertex X's entry: the next one, linked both ways, with its polar form from the camera.
\\
\\ Inputs:
\\     X: the vertex
\\     camx, camy: the camera
\\
\\ Outputs:
\\     A: its entry
\\     Y: preserved
\\     X: corrupted

.vcache_make
{
    ZA_AUTO1 ysave                      ; local: the caller's Y

    STY ysave
    INC vc_num:LDY vc_num
    TXA:STA vc_vert,Y
    TYA:STA vc_slot,X
    POLAR vc_num, vert_xlo, vert_xhi, vert_ylo, vert_yhi, vc_anglo, vc_anghi, vc_logdistlo, vc_logdisthi
    TYA                                 ; the entry
    LDY ysave
    RTS
}

\\ The cell the camera's in, from the one it was in (pt_vcache_locate): across each portal side its
\\ vertices' angles say it's crossed, a cell at a time (8 at most, as the C asserts; none counted).
\\
\\ Inputs:
\\     camcell: the cell it was in
\\     camx, camy: where it is, the vertex cache emptied since it moved
\\
\\ Outputs:
\\     camcell: the cell it's in
\\     A, X, Y: corrupted

.vcache_locate
{
    ZA_AUTO1 side                       ; local: the side
    ZA_AUTO1 adjacent                   ; local: the cell across it
    ZA_AUTO2 start                      ; local: its start's angle, then the angle to its end

.pass
    LDX camcell
    LDY cell_first,X
.each_side
    LDA side_adj,Y:BEQ next             ; a wall
    STA adjacent
    STY side
    LDX side_v,Y
    VCACHE_VERT_TO_X
    LDA vc_anglo,X:STA start
    LDA vc_anghi,X:STA start+1
    LDX camcell
    RING_NEXT
    LDX side_v,Y
    VCACHE_VERT_TO_X
    SEC
    LDA vc_anglo,X:SBC start:STA start
    LDA vc_anghi,X:SBC start+1:AND #3   ; the angle to the end: 10 bits
    CMP #2:BCC kept                     ; under a half turn: inside, its vertices clockwise
    BNE crossed                         ; over
    LDA start:BNE crossed
    LDA adjacent:CMP camcell:BCS kept   ; on it: the lower-numbered cell's
.crossed
    LDA adjacent:STA camcell
    BNE pass                            ; (always: a cell across is never 0)
    ZA_UNREACHABLE
.kept
    LDY side
    LDX camcell
.next
    INY
    TYA:CMP cell_first+1,X:BNE each_side
    RTS
}
