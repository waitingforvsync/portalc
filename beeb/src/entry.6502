\\ entry.6502 - the loader, PORTAL's entry point: it takes the machine over, copies the payloads
\\ to where they run, makes the tables and starts the engine.

\\ The loader lies above all it writes, and T's clear wipes it. Sideways RAM's image, lowest, may
\\ lie under main RAM's code, so it goes first; main RAM's loads above where it runs.

ASSERT entry >= T_JUNK_TOP, "the loader starts at T's top junk row or higher"
ASSERT maincode_image >= MAINCODE_ORG, "main RAM's code must load above where it runs"

\\ Copy whole pages forwards, the operands' high bytes stepped on, self-modified (it runs once).
\\
\\ Inputs:
\\     src, dst: from and to
\\     pages: 1 to 255
\\
\\ Outputs:
\\     X, Y: 0
\\     A: corrupted

MACRO COPY src, dst, pages
    ASSERT pages >= 1 AND pages <= &FF, "COPY: 1 to 255 pages"
    LDX #pages
    LDY #0
.loop
    LDA src,Y
    STA dst,Y
    INY
    BNE loop
    INC loop+2                          ; src's high byte
    INC loop+5                          ; dst's
    DEX
    BNE loop
ENDMACRO

\\ Take the machine over, page in the sideways RAM bank !BOOT found, set up the screen, copy the
\\ payloads out, make the tables, and start.
\\
\\ Inputs:
\\     BOOT_BANK: the bank
\\
\\ Outputs:
\\     none: it goes on to start

.entry
{
    ZA_ENTRY

    CLD
    CLI

    \\ the OS readied for its shutdown

    ZA_AUTO2 osbyte                     ; local: the MOS's default vectors

    LDA &FFB7:STA osbyte
    LDA &FFB8:STA osbyte+1
    LDY #10
    LDA (osbyte),Y:STA &20A:INY         ; BYTEV: OSBYTE's default
    LDA (osbyte),Y:STA &20B

    LDA #16:LDX #0:JSR &FFF4            ; *FX16,0: the ADC off
    LDA #143:LDX #12:LDY #255:JSR &FFF4 ; claim the NMIs
    LDA #140:LDX #0:JSR &FFF4           ; *TAPE, for safety
    LDA #19:JSR &FFF4                   ; wait for vsync, before the CRTC changes

    \\ the machine: no OS from here on, and no interrupts but strays

    SEI
    LDX #&FF:TXS
    LDA #&7F:STA &FE4E                  ; system VIA: every interrupt off
    STA &FE6E                           ; user VIA: likewise
    STA &FE43                           ; system VIA port A: the keyboard
    LDA #&0F:STA &FE42                  ; port B's low half: the addressable latch
    LDA #3:STA &FE40                    ; latch bit 3 low: we scan the keyboard
    LDA #&00:STA &FE4C                  ; PCR: CA1 vsync, CA2 keyboard
    LDA #LO(irq):STA &204               ; IRQ1V
    LDA #HI(irq):STA &205

    \\ sideways RAM: the bank !BOOT found, paged in for good (no OS to tell)

    LDA BOOT_BANK:STA &FE30             ; ROMSEL

    \\ the screen: a shrunken MODE 5, 128 by 128 at SCREEN_A, KBRG

    LDX #13
.crtc
    STX &FE00:LDA crtcregs,X:STA &FE01  ; CRTC register X
    DEX
    BPL crtc
    LDA #&C4:STA &FE20                  ; video ULA: MODE 5's
    LDX #15
.pal
    LDA paldata,X:STA &FE21             ; video ULA: the palette
    DEX
    BPL pal

    \\ the payloads, to where they run: sideways RAM's first

    COPY swramcode_image, SWRAM_ORG, (maincode_image-swramcode_image+&FF) DIV &100
    COPY maincode_image, MAINCODE_ORG, (entry-maincode_image+&FF) DIV &100

    \\ the tables

    JSR make_tables
    IF DEFINED(TEST)
        JSR test                        ; make test's build: check the macros
    ENDIF

    \\ the camera, where the map starts it

    LDA #LO(CAM_START_X):STA camx
    LDA #HI(CAM_START_X):STA camx+1
    LDA #LO(CAM_START_Y):STA camy
    LDA #HI(CAM_START_Y):STA camy+1
    LDA #0:STA camxf:STA camyf
    LDA #CAM_START_ANGLE:STA camangle
    LDA #CAM_START_CELL:STA camcell

    \\ the interrupt's state, and the vsync's interrupt on: go

    LDA #HI(SCREEN_B):STA base          ; to draw into: R12 and R13 show SCREEN_A
    LDA #0:STA request_swap:STA framectr:STA keys
    LDA #&82:STA &FE4E                  ; system VIA: CA1 (vsync) on
    CLI
    JMP start
}

.crtcregs
    EQUB 63, 32, 45, &24, 38, 0, 16, 26, &F0, 7, 32, 8, HI(SCREEN_A DIV 8), LO(SCREEN_A DIV 8)

physcols = {0, 4, 1, 2}                 ; black, blue, red, green
.paldata
    EQUB (0..15)*16 + (physcols[(0..15) DIV 8*2 + (0..15) DIV 2 MOD 2] EOR 7)
