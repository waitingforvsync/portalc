\ **************************************************************************
\ *
\ *     main.6502 - start, and the main loop
\ *
\ **************************************************************************

\\ The copy's destination (PLAN.md section 3.3, start): zero what the
\\ program owns, set the real palette, start the clock (test builds), show
\\ buffer A with B at the back, enable the vsync interrupt and go.
.start
{
    CLD
    LDA #0
    LDX #15
.mb
    STA MB,X                        ; the mailbox (and the OS's old OSFILE block)
    DEX : BPL mb

    ; the per-frame state and the screens, junk rows included
IF BSS_ORG < SCREENS_ORG
    LDA #HI(BSS_ORG)
ELSE
    LDA #HI(SCREENS_ORG)
ENDIF
    LDX #HI(SCREENS_END)
    JSR zero_pages

    LDX #15
.pal
    LDA paldata,X : STA &FE21
    DEX : BPL pal

    JSR arith_init
IF HARNESS
    JSR crc_init                    ; the checks' CRC tables
    ; the clock: T2 one-shot (so it just counts on), from &FFFF
    LDA &FE6B : AND #&DF : STA &FE6B
    LDA #&FF
    STA &FE68 : STA &FE69
    STA t2last : STA t2last + 1
    LDA #0
    STA usecs : STA usecs + 1 : STA usecs + 2 : STA usecs + 3
ENDIF

    LDA #0
    STA vsyncs : STA swapreq : STA swapstamp
    LDA #HI(BUF_B) : STA scrnbase   ; the stub shows A: draw into B

    LDA #&7F : STA &FE4D            ; nothing pending
    LDA #&82 : STA &FE4E            ; vsync (CA1) only
    CLI

IF HARNESS
    LDA #'1' : STA MB_MAGIC + 2     ; the magic, last of all
    LDA #'C' : STA MB_MAGIC + 1
    LDA #'P' : STA MB_MAGIC
    JMP mailbox
ELSE
    JMP mainloop
ENDIF
}

IF NOT(HARNESS)
\\ Phase 7's demo (Rich): the camera fixed, turning an angle unit a vsync
\\ (its angle at each capture is the vsync count, on from the start's).
\\ Capture needs neither buffer, so it doesn't wait for one: a frame is
\\ posted as soon as it's filled, and the next one's capture runs while the
\\ swap is pending. Only the clear waits, for the vsync that frees the back
\\ buffer. Phase 9 replaces it with the real loop.
\\
\\ On maps 0 and 7 the start looks down the passage with the boulder bang
\\ in the middle of it, so the camera stands 136 to the start's right, in
\\ the next cell: as close as it gets to see the passage past the boulder.
\\ Elsewhere (map 1's second room, map 9) it's the map's start.
IF MAP == 0 OR MAP == 7
    DEMO_X = 1756
    DEMO_Y = 1400
    DEMO_CELL = 6
ELSE
    DEMO_X = MAP_START_X
    DEMO_Y = MAP_START_Y
    DEMO_CELL = MAP_START_CELL
ENDIF
.mainloop
{
    ZA_AUTO1 frame                  ; local: frames drawn
    LDA #0 : STA frame
    LDA #LO(DEMO_X) : STA fr_camx
    LDA #HI(DEMO_X) : STA fr_camx + 1
    LDA #LO(DEMO_Y) : STA fr_camy
    LDA #HI(DEMO_Y) : STA fr_camy + 1
    LDA #DEMO_CELL : STA fr_cell
.loop
    LDA vsyncs : CLC : ADC #MAP_START_ANGLE : STA fr_angle
    JSR capture : BCS loop          ; dropped on an overflow: on to the next
.wait
    LDA swapreq : BNE wait          ; the last frame shown, and scrnbase turned
    JSR clear
    JSR plot
    JSR sprite_pass
    JSR fill
    LDA #1 : STA swapreq            ; shown at the next vsync...
    INC frame
    JMP loop                        ; ...while the next frame captures
}
ENDIF
