\ **************************************************************************
\ *
\ *     tables.6502 - the fixed tables at &300-&EFF (PLAN.md section 2.1)
\ *
\ **************************************************************************
\
\ Built at assembly time, byte-identical to arith.c's (the S1 check):
\
\   &300  sq1lo   quarter squares: sq1[i] = i*i DIV 4, i = 0..511, so
\   &500  sq1hi   a*b = sq1[a+b] - sq2[a-b+255]; page aligned, so a zero
\   &700  sq2lo   page pointer whose low byte is the multiplier reaches
\   &900  sq2hi   any entry with (zp),Y
\   &B00  sine    sin of [0, pi) in u0.8, 128 entries (exported: the C
\                 rounds a floating sine)
\   &B80  recipf  round(2^16 / n) - 256 for n = 128..255; recipf_n - 128
\                 is &B00, so it's indexed by n itself
\   &C00  k8      a byte's bit length, 8 - lz(b)
\   &D00  nrm     b << lz(b), the byte shifted up until bit 7 is set
\   &E00  sbyte   8 - lz(b), one less for a power of two (the reciprocal
\                 of 128 is kept as f = 0 at one shift less)
\
\ The 6502's NMI vector enters RAM at &D00. nrm's entry 0 is never read,
\ so it holds &40, an RTI: a stray NMI just returns.

FUNCTION qsq(x) = (x * x) DIV 4

FUNCTION lz(b)
    IF b >= 128
        r = 0
    ELSE
        r = 1 + lz(b * 2)
    ENDIF
= r

FUNCTION recipf(n) = ((65536 + n DIV 2) DIV n - 256) AND 255

.sq1lo  EQUB LO(qsq(0..511))
.sq1hi  EQUB HI(qsq(0..511))
.sq2lo  EQUB LO(qsq((0..511) - 255))
.sq2hi  EQUB HI(qsq((0..511) - 255))

.sine
    INCLUDE "../data/sine.6502"
.recipf_n
    EQUB recipf(128..255)

.k8
    EQUB 0
    FOR b = 1..255 : EQUB 8 - lz(b) : NEXT
.nrm
    EQUB &40                        ; entry 0, never read: the NMI handler's RTI
    FOR b = 1..255 : EQUB b << lz(b) : NEXT
.sbyte
    EQUB 0
    FOR b = 1..255 : EQUB 8 - lz(b) - (b << lz(b) == 128) : NEXT
.tables_end

ASSERT sq1lo == &300 AND sq1hi == &500 AND sq2lo == &700 AND sq2hi == &900
ASSERT sine == &B00 AND recipf_n == &B80 AND k8 == &C00 AND nrm == NMI_ADDR AND sbyte == &E00
ASSERT tables_end == TABLES_END
ASSERT recipf(128) == 0 AND recipf(255) == 1 AND lz(1) == 7
