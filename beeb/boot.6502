\ boot.6502 - !BOOT: machine code at &400 (as spritescale's), which silences
\ the beep, prints the title and *RUNs PORTAL.

SECTION Boot, filename = "!BOOT", org = &400, load = &FFFF0400
    LDA #15 : LDX #0 : JSR &FFF4    ; *FX15,0: flush the buffers
    LDX #0
.@  LDA message,X
    JSR &FFE3                       ; OSASCI
    INX
    CMP #0
    BNE @-
    LDX #LO(cmd)
    LDY #HI(cmd)
    JMP &FFF7                       ; OSCLI
.cmd
    EQUS "/PORTAL", 13
.message
    EQUS "PORTALC", 13, 13, 0
ENDSECTION
