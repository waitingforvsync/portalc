\\ test/test.6502 - what make test's checks share: where their answers go, and the run, which the
\\ loader calls in a check's build (-D TEST=TRUE). Each check's program names its check, check.

TEST_RESULTS = &C000                    ; HAZEL, the filing system's 8K: paged in, its OS gone
TEST_RESULTS_END = &E000

SECTION TestResults, org = TEST_RESULTS, guard = TEST_RESULTS_END, virtual = TRUE
.t_done     SKIP 1                      ; &A5 once the check's answers are written
ENDSECTION

\\ Run the check.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     TestResults: its answers, t_done last

.test
{
    LDA #0:STA t_done
    JSR check
    LDA #&A5:STA t_done
    RTS
}
