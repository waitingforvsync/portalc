\ **************************************************************************
\ *
\ *     bss.6502 - the per-frame state (PLAN.md section 2.1)
\ *
\ **************************************************************************
\
\ Zeroed by start. What crosses the plot: two of the pool's pages (the
\ other six are in the spare), the segment pool, the sprite instances, and
\ the sprite pass's toggles. The capture's own state is in the junk rows
\ (scratch.6502, D13).

IN_ROWS = 33                    ; row edges an instance keeps: its art's height + 1, at most

.bss_start
.p_co   SKIP 256                ; the pool's odd colour pattern (both 0: a bound, not plotted)
.p_next SKIP 256                ; the next piece in its chain, 0 = the end
.segs   SKIP PT_SEG_POOL        ; clip segments: offsets into here, 0 = none

\ The sprite instances (pt_inst), a field a table, by instance (1..7).
.in_sprite SKIP PT_MAX_INSTS    ; the map's sprite
.in_cx0 SKIP PT_MAX_INSTS       ; the screen columns it covers, [cx0, cx1)
.in_cx1 SKIP PT_MAX_INSTS
.in_seg SKIP PT_MAX_INSTS       ; its clip segments, in x order
.in_segt SKIP PT_MAX_INSTS
.in_prev SKIP PT_MAX_INSTS      ; the draw order, far to near
.in_next SKIP PT_MAX_INSTS
.in_scl SKIP PT_MAX_INSTS       ; screen pixels per source pixel, u8.8
.in_sch SKIP PT_MAX_INSTS
.in_l0  SKIP PT_MAX_INSTS       ; the left edge's column, u8.8, 24 bits
.in_l1  SKIP PT_MAX_INSTS
.in_l2  SKIP PT_MAX_INSTS
.in_t0  SKIP PT_MAX_INSTS       ; the top edge's row, likewise
.in_t1  SKIP PT_MAX_INSTS
.in_t2  SKIP PT_MAX_INSTS
\ ...and the sprite pass's, stepped along its columns
.in_col SKIP PT_MAX_INSTS       ; the source column at the current one
.in_cn0 SKIP PT_MAX_INSTS       ; its right edge plus a half (rounding), u8.8, 24 bits
.in_cn1 SKIP PT_MAX_INSTS
.in_cn2 SKIP PT_MAX_INSTS
.in_cseg SKIP PT_MAX_INSTS      ; the segment the bound cursors are in, 0 = none yet
.in_cc  SKIP PT_MAX_INSTS       ; the column they're at, &FF = none
.in_tk  SKIP PT_MAX_INSTS       ; their pieces, as positions in the segment's lists
.in_bk  SKIP PT_MAX_INSTS
.in_tyl SKIP PT_MAX_INSTS       ; and those pieces' rows there, biased u8.8
.in_tyh SKIP PT_MAX_INSTS
.in_byl SKIP PT_MAX_INSTS
.in_byh SKIP PT_MAX_INSTS
.in_rows SKIP (PT_MAX_INSTS - 1) * IN_ROWS  ; each one's row edges (rowbase)
.in_top SKIP PT_MAX_INSTS       ; its top edge's row, rows[0]
.in_bot SKIP PT_MAX_INSTS       ; its bottom edge's row, rows[h]
.in_h   SKIP PT_MAX_INSTS       ; its art's height, and where the art is:
.in_dl  SKIP PT_MAX_INSTS       ; its data...
.in_dh  SKIP PT_MAX_INSTS
.in_pl  SKIP PT_MAX_INSTS       ; ...and its palette (one back)
.in_ph  SKIP PT_MAX_INSTS

\ The sprite pass's byte column: its toggles, a list from node 0 (its
\ head, no toggle) through tg_nx in row order to TG_TAIL (row &FF, past
\ them all), so inserting and removing cost the same anywhere.
TG_TAIL = PT_MAX_TOGS + 1
.tg_row SKIP TG_TAIL + 1
.tg_e   SKIP TG_TAIL + 1
.tg_o   SKIP TG_TAIL + 1
.tg_nx  SKIP TG_TAIL + 1

.aborts SKIP 1                  ; frames dropped on an overflow (D9)
