\ **************************************************************************
\ *
\ *     s5.6502 - checks S5 and S5u: the capture, replayed (PLAN.md 5.6)
\ *
\ **************************************************************************
\
\ CMD_REPLAY replays one recorded call (REPLAY.md). The host pokes the
\ record's frame state where the code keeps it (the pool's pages, the
\ visits' tables, cell_visit, the instances, the segments and the pending
\ stack), the counts that live in zero page into rp_pool and rp_nvis, the
\ record's CAM into rp_cam and its arguments, as the record has them, into
\ rp_buf. The shim unpacks them, makes the call, and packs its results
\ into rp_res, as the record has them, and the counts back, for the host
\ to peek, re-encode and compare.
\
\   arg0: the function (REPLAY.md's id)
\     0 own_piece      CX LINE r0 r1 st y; CX ret
\     1 chain_add      CX q r1 y; CX
\     2 close_columns  head l rr cbfb.e cbfb.o
\     3 run_end        CX; CX
\     4 merge          CX LINE r0 r1 st own yl yp; CX
\     5 flip           CX LINE p c e st in yl yp; CX ret
\     6 hide           CX LINE c c1 st yl yp; CX ret
\     7 meet           CX LINE p c c1 st yl yp; CX ret
\     8 clip_line      CX LINE c c1; CX
\     9 merge_above    CX LINE c c1; CX
\    10 inst_new       cell; ret
\    11 seg_record     vi
\    12 inst_issue     pend
\    13 visit_of       cell; ret
\    14 enter          vi ei xl xr VV; ret
\    15 process_edge   vi; ret
\    16 make_line      EP EP h.m h.below col.e col.o; LINE
\    17 edge_line      EL slot h.m h.below col.e col.o; EL LINE
\    18 transform      w.x w.y; VV
\    19 col_gt         VV c; ret
\    20 col_ge         VV c; ret
\   255 nothing: the timing's baseline
\
\ A CX's visit and slot are cx_act on the Beeb, the slot's table plus the
\ visit: they go in that way, and come back as they went in (no call
\ changes them).

CMD_REPLAY = 6

RP_LINE = 19                    ; a clip's LINE, after its CX...
RP_ARGS = RP_LINE + 9           ; ...and its other arguments, after that

\\ CMD_REPLAY.
.cmd_replay
{
    LDA rp_cam + 1 : STA fr_camx    ; the record's camera, for whatever transforms
    LDA rp_cam + 2 : STA fr_camx + 1
    LDA rp_cam + 3 : STA fr_camy
    LDA rp_cam + 4 : STA fr_camy + 1
    LDA rp_cam + 5 : STA fr_eyez
    LDA rp_cam + 6 : STA fr_angle
    LDA rp_cam + 7 : STA fr_cell
    LDA rp_pool : STA pool_last     ; the counts in zero page
    LDA rp_nvis : STA num_visits
    LDA rp_nvis + 1 : STA num_insts
    LDA rp_nvis + 2 : STA order_head
    LDA rp_nvis + 3 : STA order_tail
    LDA rp_nvis + 4 : STA seg_next
    LDA rp_nvis + 5 : STA num_pend
    JSR call
    LDA pool_last : STA rp_pool     ; and back
    LDA num_visits : STA rp_nvis
    LDA num_insts : STA rp_nvis + 1
    LDA order_head : STA rp_nvis + 2
    LDA order_tail : STA rp_nvis + 3
    LDA seg_next : STA rp_nvis + 4
    LDA num_pend : STA rp_nvis + 5
    RTS

.call                           ; the function, from rp_lo and rp_hi (an RTS dispatch)
    LDX MB_ARG
    CPX #RP_FNS : BCS other
    LDA rp_hi,X : PHA
    LDA rp_lo,X : PHA
    CPX #10 : BCS @+
    JSR rp_cx_in                ; the clip's: their CX and LINE
.@  RTS
    ZA_CANJUMP rp_own_piece, rp_chain_add, rp_close_columns, rp_run_end, rp_merge, rp_flip, rp_hide, rp_meet, rp_clip_line, rp_merge_above, rp_inst_new, rp_seg_record, rp_inst_issue, rp_visit_of, rp_enter, rp_process_edge, rp_make_line, rp_edge_line, rp_transform, rp_col_gt, rp_col_ge
.other
    CPX #255 : BNE bad
    JSR rp_start : JMP rp_stop  ; the timing's baseline
.bad
    TRAP 4
}

.rp_own_piece
    LDA rp_buf + RP_ARGS : STA rg_r0
    LDA rp_buf + RP_ARGS + 1 : STA rg_r1
    LDA rp_buf + RP_ARGS + 3 : STA rg_y
    LDA rp_buf + RP_ARGS + 4 : STA rg_y + 1
    LDA rp_buf + RP_ARGS + 2
    JSR rp_start : JSR own_piece : TXA
    JMP rp_ret
.rp_chain_add                   ; (no LINE: q r1 y)
    LDA rp_buf + RP_LINE + 1 : STA rg_r1
    LDA rp_buf + RP_LINE + 2 : STA rg_y
    LDA rp_buf + RP_LINE + 3 : STA rg_y + 1
    JSR rp_start : LDX rp_buf + RP_LINE : JSR chain_add
    JMP rp_cx_ret
.rp_close_columns               ; (no CX)
    LDA rp_buf + 1 : STA close_columns.l
    LDA rp_buf + 2 : STA close_columns.rr
    LDA rp_buf + 3 : STA close_columns.cbe
    LDA rp_buf + 4 : STA close_columns.cbo
    JSR rp_start : LDX rp_buf : JSR close_columns
    JMP rp_stop
.rp_run_end
    JSR rp_start : JSR run_end
    JMP rp_cx_ret
.rp_merge
    LDA rp_buf + RP_ARGS : STA merge.r0
    LDA rp_buf + RP_ARGS + 1 : STA merge.r1
    LDA rp_buf + RP_ARGS + 2 : STA merge.st
    LDA rp_buf + RP_ARGS + 3 : STA merge.own
    LDY #RP_ARGS + 4 : JSR rp_rows_in
    JSR rp_start : JSR merge
    JMP rp_cx_ret
.rp_flip
    LDA rp_buf + RP_ARGS : STA flip.p
    LDA rp_buf + RP_ARGS + 1 : STA flip.c
    LDA rp_buf + RP_ARGS + 2 : STA flip.e
    LDA rp_buf + RP_ARGS + 3 : STA flip.st
    LDA rp_buf + RP_ARGS + 4 : STA flip.in
    LDY #RP_ARGS + 5 : JSR rp_rows_in
    JSR rp_start : JSR flip
    JMP rp_ret
.rp_hide
    LDA rp_buf + RP_ARGS : STA hide.c
    LDA rp_buf + RP_ARGS + 1 : STA hide.c1
    LDA rp_buf + RP_ARGS + 2 : STA hide.st
    LDY #RP_ARGS + 3 : JSR rp_rows_in
    JSR rp_start : JSR hide
    JMP rp_ret
.rp_meet
    LDA rp_buf + RP_ARGS : STA meet.p
    LDA rp_buf + RP_ARGS + 1 : STA meet.c
    LDA rp_buf + RP_ARGS + 2 : STA meet.c1
    LDA rp_buf + RP_ARGS + 3 : STA meet.st
    LDY #RP_ARGS + 4 : JSR rp_rows_in
    JSR rp_start : JSR meet
    JMP rp_ret
.rp_clip_line
    LDA rp_buf + RP_ARGS : STA clip_line.c
    LDA rp_buf + RP_ARGS + 1 : STA clip_line.c1
    JSR rp_start : JSR clip_line
    JMP rp_cx_ret
.rp_merge_above
    LDA rp_buf + RP_ARGS : STA merge_above.c
    LDA rp_buf + RP_ARGS + 1 : STA merge_above.c1
    JSR rp_start : JSR merge_above
    JMP rp_cx_ret
.rp_inst_new
    JSR rp_start : LDX rp_buf : JSR inst_new
    JMP rp_byte
.rp_seg_record
    LDA rp_buf
    JSR rp_start : JSR seg_record
    JMP rp_stop
.rp_inst_issue
    LDA rp_buf
    JSR rp_start : JSR inst_issue
    JMP rp_stop
.rp_visit_of
    JSR rp_start : LDX rp_buf : JSR visit_of : TYA
    JMP rp_byte
.rp_enter
    LDA rp_buf : STA enter.vi
    LDA rp_buf + 1 : STA enter.ei
    LDA rp_buf + 2 : STA enter.xl
    LDA rp_buf + 3 : STA enter.xr
    LDX #0 : LDY #4 : JSR rp_vv_in  ; P, as the edge's start vertex
    JSR rp_start : JSR enter
    JMP rp_byte
.rp_process_edge
    LDA rp_buf : STA process_edge.vi
    JSR rp_start : JSR process_edge
    JMP rp_byte
.rp_make_line
    LDX #0 : LDY #0 : JSR rp_ep_in
    INX : LDY #7 : JSR rp_ep_in
    LDA rp_buf + 14 : STA h_m
    LDA rp_buf + 15 : STA h_below
    LDA rp_buf + 16 : STA l_ce
    LDA rp_buf + 17 : STA l_co
    JSR rp_start : JSR make_line : JSR rp_stop
    LDY #0 : JMP rp_line_out
.rp_transform
    LDA rp_buf : STA transform.wx
    LDA rp_buf + 1 : STA transform.wx + 1
    LDA rp_buf + 2 : STA transform.wy
    LDA rp_buf + 3 : STA transform.wy + 1
    JSR rp_start : JSR transform : JSR rp_stop
    LDA tf_x : STA rp_res
    LDA tf_x + 1 : STA rp_res + 1
    LDA tf_y : STA rp_res + 2
    LDA tf_y + 1 : STA rp_res + 3
    LDA tf_sx : STA rp_res + 4
    LDA tf_flags : STA rp_res + 5
    LDA tf_f : STA rp_res + 6
    LDA tf_e : STA rp_res + 7
    RTS
.rp_col_gt
    JSR rp_cv_in
    JSR rp_start : LDY #0 : JSR col_gt
    JMP rp_bool
.rp_col_ge
    JSR rp_cv_in
    JSR rp_start : LDY #0 : JSR col_ge
    JMP rp_bool

\ Each function's handler, less one (for the RTS).
RP_FNS = 21
.rp_lo
    EQUB LO(rp_own_piece - 1), LO(rp_chain_add - 1), LO(rp_close_columns - 1), LO(rp_run_end - 1)
    EQUB LO(rp_merge - 1), LO(rp_flip - 1), LO(rp_hide - 1), LO(rp_meet - 1), LO(rp_clip_line - 1)
    EQUB LO(rp_merge_above - 1), LO(rp_inst_new - 1), LO(rp_seg_record - 1), LO(rp_inst_issue - 1)
    EQUB LO(rp_visit_of - 1), LO(rp_enter - 1), LO(rp_process_edge - 1), LO(rp_make_line - 1)
    EQUB LO(rp_edge_line - 1), LO(rp_transform - 1), LO(rp_col_gt - 1), LO(rp_col_ge - 1)
.rp_hi
    EQUB HI(rp_own_piece - 1), HI(rp_chain_add - 1), HI(rp_close_columns - 1), HI(rp_run_end - 1)
    EQUB HI(rp_merge - 1), HI(rp_flip - 1), HI(rp_hide - 1), HI(rp_meet - 1), HI(rp_clip_line - 1)
    EQUB HI(rp_merge_above - 1), HI(rp_inst_new - 1), HI(rp_seg_record - 1), HI(rp_inst_issue - 1)
    EQUB HI(rp_visit_of - 1), HI(rp_enter - 1), HI(rp_process_edge - 1), HI(rp_make_line - 1)
    EQUB HI(rp_edge_line - 1), HI(rp_transform - 1), HI(rp_col_gt - 1), HI(rp_col_ge - 1)

\ The record's CX (rp_buf) into cx_*, and the LINE after it into l_* (for
\ the two with no LINE, the arguments after the CX land there, unread).
.rp_cx_in
{
    LDA rp_buf : STA cx_p
    LDA rp_buf + 1 : STA cx_p + 1
    LDA rp_buf + 2 : STA cx_tmax
    LDA rp_buf + 3 : STA cx_bmin
    LDX rp_buf + 5              ; the slot's table, plus the visit
    LDA act_base,X : CLC : ADC rp_buf + 4 : STA cx_act
    LDA rp_buf + 6 : STA cx_shut
    LDA rp_buf + 7 : STA cx_child
    LDA rp_buf + 8 : STA cx_tail
    LDA rp_buf + 9 : STA cx_own
    LDA rp_buf + 10 : STA cx_lc
    LDA rp_buf + 11 : STA cx_ly
    LDA rp_buf + 12 : STA cx_ly + 1
    LDA rp_buf + 13 : STA cx_cbfbe
    LDA rp_buf + 14 : STA cx_cbfbo
    LDA rp_buf + 15 : STA cx_rl
    LDA rp_buf + 16 : STA cx_rr
    LDA rp_buf + 17 : STA cx_ol
    LDA rp_buf + 18 : STA cx_orr
    LDA rp_buf + RP_LINE : STA l_x0
    LDA rp_buf + RP_LINE + 1 : STA l_x1
    LDA rp_buf + RP_LINE + 2 : STA l_y
    LDA rp_buf + RP_LINE + 3 : STA l_y + 1
    LDA rp_buf + RP_LINE + 4 : STA l_g
    LDA rp_buf + RP_LINE + 5 : STA l_g + 1
    LDA rp_buf + RP_LINE + 6 : STA l_below
    LDA rp_buf + RP_LINE + 7 : STA l_ce
    LDA rp_buf + RP_LINE + 8 : STA l_co
    RTS
}

\ cx_* back into rp_res, as a CX.
.rp_cx_out
{
    LDA cx_p : STA rp_res
    LDA cx_p + 1 : STA rp_res + 1
    LDA cx_tmax : STA rp_res + 2
    LDA cx_bmin : STA rp_res + 3
    LDA rp_buf + 4 : STA rp_res + 4
    LDA rp_buf + 5 : STA rp_res + 5
    LDA cx_shut : STA rp_res + 6
    LDA cx_child : STA rp_res + 7
    LDA cx_tail : STA rp_res + 8
    LDA cx_own : STA rp_res + 9
    LDA cx_lc : STA rp_res + 10
    LDA cx_ly : STA rp_res + 11
    LDA cx_ly + 1 : STA rp_res + 12
    LDA cx_cbfbe : STA rp_res + 13
    LDA cx_cbfbo : STA rp_res + 14
    LDA cx_rl : STA rp_res + 15
    LDA cx_rr : STA rp_res + 16
    LDA cx_ol : STA rp_res + 17
    LDA cx_orr : STA rp_res + 18
    RTS
}

\ The record's yl and yp, at rp_buf + Y, into rn_yl and rn_yp.
.rp_rows_in
{
    LDA rp_buf,Y : STA rn_yl
    LDA rp_buf + 1,Y : STA rn_yl + 1
    LDA rp_buf + 2,Y : STA rn_yp
    LDA rp_buf + 3,Y : STA rn_yp + 1
    RTS
}

\ After a call that returns a byte in A: the clock stopped, then the CX
\ and the byte into rp_res...
.rp_ret
{
    JSR rp_stop
    STA rp_res + 19
    JMP rp_cx_out
}

\ ...or the CX alone...
.rp_cx_ret
{
    JSR rp_stop
    JMP rp_cx_out
}

\ ...or the byte alone...
.rp_byte
{
    JSR rp_stop
    STA rp_res
    RTS
}

\ ...or C, as a byte.
.rp_bool
{
    JSR rp_stop
    LDA #0 : ROL A : STA rp_res
    RTS
}

\ The clock before a replayed call...
.rp_start
{
    PHP : PHA                   ; (some routines take an input in A)
    JSR now
    ZA_DISCARD rp_t0            ; rebuilt whole by the loop
    LDX #3
.keep
    LDA now.t,X : ZA_INDEXEDBY 0..3
    STA rp_t0,X : ZA_INDEXEDBY 0..3
    DEX : BPL keep
    PLA : PLP
    RTS
}

\ ...and after it: the microseconds to MB_USECS. Keeps A, X, Y and the
\ flags (col_gt's answer is in C).
.rp_stop
{
    PHP : PHA
    JSR now
    SEC
    FOR i = 0 ..< 4             ; (unrolled: a CPX would break the borrow)
        LDA now.t + i : SBC rp_t0 + i : STA MB_USECS + i
    NEXT
    PLA : PLP
    RTS
}
ZA_AUTO 4, rp_t0                ; the replay's clock at the call

\ The VV at rp_buf + Y into the edge's vertex X (ev_*), keeping X.
.rp_vv_in
{
    LDA rp_buf,Y : STA ev_xl,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 1,Y : STA ev_xh,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 2,Y : STA ev_yl,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 3,Y : STA ev_yh,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 4,Y : STA ev_sx,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 5,Y : STA ev_flags,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 6,Y : STA ev_f,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 7,Y : STA ev_e,X : ZA_INDEXEDBY 0..1
    RTS
}

\ Vertex X (ev_*) into rp_res + Y, as a VV, keeping X.
.rp_vv_out
{
    LDA ev_xl,X : ZA_INDEXEDBY 0..1
    STA rp_res,Y
    LDA ev_xh,X : ZA_INDEXEDBY 0..1
    STA rp_res + 1,Y
    LDA ev_yl,X : ZA_INDEXEDBY 0..1
    STA rp_res + 2,Y
    LDA ev_yh,X : ZA_INDEXEDBY 0..1
    STA rp_res + 3,Y
    LDA ev_sx,X : ZA_INDEXEDBY 0..1
    STA rp_res + 4,Y
    LDA ev_flags,X : ZA_INDEXEDBY 0..1
    STA rp_res + 5,Y
    LDA ev_f,X : ZA_INDEXEDBY 0..1
    STA rp_res + 6,Y
    LDA ev_e,X : ZA_INDEXEDBY 0..1
    STA rp_res + 7,Y
    RTS
}

\ The record's VV and c for col_gt and col_ge: the VV as visit 0's end
\ vertex (the null visit's, no real one's), A = c.
.rp_cv_in
{
    LDA rp_buf : STA vs1_xl
    LDA rp_buf + 1 : STA vs1_xh
    LDA rp_buf + 2 : STA vs1_yl
    LDA rp_buf + 3 : STA vs1_yh
    LDA rp_buf + 4 : STA vs1_sx
    LDA rp_buf + 5 : STA vs1_fl
    LDA rp_buf + 8
    RTS
}

\ The EP at rp_buf + Y into endpoint X, keeping X.
.rp_ep_in
{
    LDA rp_buf,Y : STA ep_xl,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 1,Y : STA ep_xh,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 2,Y : STA ep_yl,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 3,Y : STA ep_yh,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 4,Y : STA ep_sx,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 5,Y : STA ep_f,X : ZA_INDEXEDBY 0..1
    LDA rp_buf + 6,Y : STA ep_e,X : ZA_INDEXEDBY 0..1
    RTS
}

\ Endpoint X into rp_res + Y, keeping X.
.rp_ep_out
{
    LDA ep_xl,X : ZA_INDEXEDBY 0..1
    STA rp_res,Y
    LDA ep_xh,X : ZA_INDEXEDBY 0..1
    STA rp_res + 1,Y
    LDA ep_yl,X : ZA_INDEXEDBY 0..1
    STA rp_res + 2,Y
    LDA ep_yh,X : ZA_INDEXEDBY 0..1
    STA rp_res + 3,Y
    LDA ep_sx,X : ZA_INDEXEDBY 0..1
    STA rp_res + 4,Y
    LDA ep_f,X : ZA_INDEXEDBY 0..1
    STA rp_res + 5,Y
    LDA ep_e,X : ZA_INDEXEDBY 0..1
    STA rp_res + 6,Y
    RTS
}

\ The line into rp_res + Y, as a LINE.
.rp_line_out
{
    LDA l_x0 : STA rp_res,Y
    LDA l_x1 : STA rp_res + 1,Y
    LDA l_y : STA rp_res + 2,Y
    LDA l_y + 1 : STA rp_res + 3,Y
    LDA l_g : STA rp_res + 4,Y
    LDA l_g + 1 : STA rp_res + 5,Y
    LDA l_below : STA rp_res + 6,Y
    LDA l_ce : STA rp_res + 7,Y
    LDA l_co : STA rp_res + 8,Y
    RTS
}

\ edge_line: EL (v0 v1 sx0 sx1 have_ep e0 e1 vis), slot, h, col; out EL, LINE.
.rp_edge_line
{
    LDX #0 : LDY #0 : JSR rp_vv_in
    INX : LDY #8 : JSR rp_vv_in
    LDA rp_buf + 16 : STA el_sx0
    LDA rp_buf + 17 : STA el_sx1
    LDA rp_buf + 18 : STA el_have
    LDX #0 : LDY #19 : JSR rp_ep_in
    INX : LDY #26 : JSR rp_ep_in
    LDA rp_buf + 33 : STA el_vis
    LDA rp_buf + 35 : STA h_m
    LDA rp_buf + 36 : STA h_below
    LDA rp_buf + 37 : STA l_ce
    LDA rp_buf + 38 : STA l_co
    LDA rp_buf + 34             ; the slot
    JSR rp_start : JSR edge_line : JSR rp_stop
    LDY #34 : JSR rp_line_out
    LDX #0 : LDY #0 : JSR rp_vv_out     ; the EL back
    INX : LDY #8 : JSR rp_vv_out
    LDA el_sx0 : STA rp_res + 16
    LDA el_sx1 : STA rp_res + 17
    LDA el_have : STA rp_res + 18
    LDX #0 : LDY #19 : JSR rp_ep_out
    INX : LDY #26 : JSR rp_ep_out
    LDA el_vis : STA rp_res + 33
    RTS
}

\ ---- S5: every vertex's transform at every pose ----

CMD_S5T = 7
S5T_MAX = 128

\ Fold byte var into crc (CRC-16/XMODEM, crc_lo and crc_hi).
MACRO CRCVAR var, crc
    LDA var : EOR crc + 1 : TAX
    LDA crc : EOR crc_hi,X : STA crc + 1
    LDA crc_lo,X : STA crc
ENDMACRO

\\ CMD_S5T: arg0 poses (up to S5T_MAX) in io_area, 5 bytes each (the
\\ camera's x and y, its angle). For each, every map vertex transformed,
\\ and a CRC-16 of their view vertices (REPLAY.md's VV, 8 bytes each) in
\\ s5t_out.
.cmd_s5t
{
    ZA_AUTO2 rec                ; local: the next pose
    ZA_AUTO1 left, v, k         ; local: poses to go, the vertex, s5t_out's index
    ZA_AUTO2 crc                ; local
    LDA #LO(io_area) : STA rec
    LDA #HI(io_area) : STA rec + 1
    LDA #0 : STA k
    LDA MB_ARG : STA left : BNE pose
    RTS
.pose
    LDY #0 : LDA (rec),Y : STA fr_camx
    INY : LDA (rec),Y : STA fr_camx + 1
    INY : LDA (rec),Y : STA fr_camy
    INY : LDA (rec),Y : STA fr_camy + 1
    INY : LDA (rec),Y : STA fr_angle
    LDA rec : CLC : ADC #5 : STA rec
    BCC @+
    INC rec + 1
.@  LDA #0 : STA crc : STA crc + 1 : STA v
.vertex
    LDX v
    LDA vx_lo,X : STA transform.wx
    LDA vx_hi,X : STA transform.wx + 1
    LDA vy_lo,X : STA transform.wy
    LDA vy_hi,X : STA transform.wy + 1
    JSR transform
    CRCVAR tf_x, crc
    CRCVAR tf_x + 1, crc
    CRCVAR tf_y, crc
    CRCVAR tf_y + 1, crc
    CRCVAR tf_sx, crc
    CRCVAR tf_flags, crc
    CRCVAR tf_f, crc
    CRCVAR tf_e, crc
    INC v
    LDA v : CMP #MAP_NUM_VERTS : BEQ posed
    JMP vertex                  ; (out of branch range)
.posed
    LDX k
    LDA crc : STA s5t_out,X
    LDA crc + 1 : STA s5t_out + 1,X
    INX : INX : STX k
    DEC left : BEQ done
    JMP pose
.done
    RTS
}

\ ---- S5: make_line on synthetic endpoints ----

CMD_S5M = 8
S5M_REC = 27                    ; make_line's ARGS (18), then its LINE (9)

\\ CMD_S5M: arg0 records in io_area: for each, make_line, its line written
\\ into the record's last 9 bytes.
.cmd_s5m
{
    ZA_AUTO2 rec                ; local: the record
    ZA_AUTO1 left               ; local: records to go
    LDA #LO(io_area) : STA rec
    LDA #HI(io_area) : STA rec + 1
    LDA MB_ARG : STA left : BNE one
    RTS
.one
    LDX #0 : LDY #0 : JSR ep
    LDX #1 : JSR ep
    LDA (rec),Y : STA h_m : INY
    LDA (rec),Y : STA h_below : INY
    LDA (rec),Y : STA l_ce : INY
    LDA (rec),Y : STA l_co
    JSR make_line
    LDY #18
    LDA l_x0 : STA (rec),Y : INY
    LDA l_x1 : STA (rec),Y : INY
    LDA l_y : STA (rec),Y : INY
    LDA l_y + 1 : STA (rec),Y : INY
    LDA l_g : STA (rec),Y : INY
    LDA l_g + 1 : STA (rec),Y : INY
    LDA l_below : STA (rec),Y : INY
    LDA l_ce : STA (rec),Y : INY
    LDA l_co : STA (rec),Y
    LDA rec : CLC : ADC #S5M_REC : STA rec
    BCC @+
    INC rec + 1
.@  DEC left : BEQ done
    JMP one
.done
    RTS

\ Endpoint X from the record at Y (7 bytes), Y moved past it.
.ep
    LDA (rec),Y : STA ep_xl,X : ZA_INDEXEDBY 0..1
    INY
    LDA (rec),Y : STA ep_xh,X : ZA_INDEXEDBY 0..1
    INY
    LDA (rec),Y : STA ep_yl,X : ZA_INDEXEDBY 0..1
    INY
    LDA (rec),Y : STA ep_yh,X : ZA_INDEXEDBY 0..1
    INY
    LDA (rec),Y : STA ep_sx,X : ZA_INDEXEDBY 0..1
    INY
    LDA (rec),Y : STA ep_f,X : ZA_INDEXEDBY 0..1
    INY
    LDA (rec),Y : STA ep_e,X : ZA_INDEXEDBY 0..1
    INY
    RTS
}
