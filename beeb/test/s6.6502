\ **************************************************************************
\ *
\ *     s6.6502 - checks S6 and S7: whole captures and frames (PLAN.md 5.7)
\ *
\ **************************************************************************
\
\ CMD_S6 renders arg0 poses (up to S6_MAX) the host has put in io_area, 6
\ bytes each as the golden streams have them: x and y (u16), angle, cell.
\ Each one is a frame as pt_render_frame makes it, its sprites on if arg1
\ is (S7) and off if not (S6), into a zeroed image (the buffer under test
\ and its junk rows): clear, capture, plot, the sprite pass, fill. The
\ capture is CRCed before the plot (its own state lives in the junk rows,
\ D13), and the image's junk rows zeroed then, as the C's never held it.
\ With arg2 set (one pose, for a diagnosis) it stops after the capture,
\ the state left for the host and its zero-page counts in s6_extra. In the
\ profiler's build (SUITE 4), arg3 set samples the PC every PROF_TICK
\ microseconds through the frames' own stages (system VIA T1, hw.6502's
\ IRQ), into prof_buf from its start; prof_ptr ends past the last.
\ Per pose, S6_REC bytes in s6_out:
\
\    0  a CRC-16 of the capture: the pieces 1..pool_last (x0 x1 y0 yf glo
\       ghi ce co next each), the visits 1.. (cell k x xr tcur bcur tmax
\       bmin, v0, v1, inst, active[4]; a visit never entered, xr 0, has no
\       cursor, columns, vertices or instance yet, and they count as 0),
\       the instances 1.. (sprite cx0 cx1 seg seg_tail prev next, scale,
\       left and top in 24 bits), the order's head and tail, seg_next and
\       the segments 1.., num_pend
\    2  a CRC-16 of the image
\    4  pool_last
\    5  num_visits
\    6  the lowest stack byte the frame wrote
\    7  1 if capture dropped the frame (an overflow, with ovf_abort set)
\    8  the clear's microseconds (2 bytes)
\   10  capture's (3 bytes)
\   13  the plot's, sprite pass's and fill's (3 bytes)

CMD_S6 = 9
PROF_TICK = 997                 ; (prime-ish, so it walks across the code's loops)
S6_MAX = 16                     ; (s6_out indexed by a byte: 16 records of 16)
S6_REC = 16
S6_GAP = 16                     ; the canary stops this far below the command's own S

ZA_AUTO2 s6crc                  ; the CRC being formed

\ The profiler's sampling on (if arg3 asks for it) and off, in its build.
MACRO PROF_ON
    IF SUITE == 4
        LDA MB_ARG + 3 : STA prof_on
    ENDIF
ENDMACRO

MACRO PROF_OFF
    IF SUITE == 4
        LDA #0 : STA prof_on
    ENDIF
ENDMACRO
ZA_AUTO 4, s6t                  ; the clock at the start of what's being timed

\ Fold A into s6crc (CRC-16/XMODEM). Clobbers X.
.s6_crc
{
    EOR s6crc + 1 : TAX
    LDA s6crc : EOR crc_hi,X : STA s6crc + 1
    LDA crc_lo,X : STA s6crc
    RTS
}

\ The clock into s6t.
.s6_start
{
    JSR now
    ZA_DISCARD s6t              ; rebuilt whole by the loop
    LDX #3
.keep
    LDA now.t,X : ZA_INDEXEDBY 0..3
    STA s6t,X : ZA_INDEXEDBY 0..3
    DEX : BPL keep
    RTS
}

\ The microseconds since s6_start into s6_out + Y,X (3 bytes).
.s6_stop
{
    ZA_AUTO1 at                 ; local
    STY at
    JSR now
    TXA : CLC : ADC at : TAX    ; (the pose's record, plus Y)
    SEC
    LDA now.t : SBC s6t : STA s6_out,X
    LDA now.t + 1 : SBC s6t + 1 : STA s6_out + 1,X
    LDA now.t + 2 : SBC s6t + 2 : STA s6_out + 2,X
    RTS
}

\\ CMD_S6.
.cmd_s6
{
    ZA_AUTO2 rec                ; local: the next pose
    ZA_AUTO1 k, left            ; local: s6_out's index, poses to go
    ZA_AUTO2 p                  ; local: the image CRC's pointer
    ZA_AUTO1 top                ; local: the canary's end, below our own stack
    TSX : TXA : SEC : SBC #S6_GAP : STA top
    LDA #LO(io_area) : STA rec
    LDA #HI(io_area) : STA rec + 1
    LDA #0 : STA k
IF SUITE == 4
    STA prof_on
    LDA #LO(prof_buf) : STA prof_ptr
    LDA #HI(prof_buf) : STA prof_ptr + 1
    LDA MB_ARG + 3 : BEQ @+
    LDA #&40 : STA &FE4B        ; T1 free-running, PB7 alone
    LDA #LO(PROF_TICK - 2) : STA &FE46
    LDA #HI(PROF_TICK - 2) : STA &FE45  ; (starts it)
    LDA #&C0 : STA &FE4E        ; its interrupt on
.@
ENDIF
    LDA MB_ARG : STA left : BNE pose
    RTS
.pose
    LDY #0 : LDA (rec),Y : STA fr_camx
    INY : LDA (rec),Y : STA fr_camx + 1
    INY : LDA (rec),Y : STA fr_camy
    INY : LDA (rec),Y : STA fr_camy + 1
    INY : LDA (rec),Y : STA fr_angle
    INY : LDA (rec),Y : STA fr_cell
    LDA rec : CLC : ADC #6 : STA rec
    BCC @+
    INC rec + 1
.@  LDA #HI(IMG_START) : LDX #HI(IMG_END)
    JSR zero_pages
    LDA #HI(IMG_BUF) : STA scrnbase
    LDX top                     ; the stack's canary, from &100 up to top
.canary
    DEX
    TXA : EOR #&A5 : STA &100,X
    TXA : BNE canary

    JSR s6_start
    PROF_ON
    JSR clear
    PROF_OFF
    LDX k : LDY #8 : JSR s6_stop        ; (its third byte, 0, under capture's)
    JSR s6_start
    PROF_ON
    JSR capture
    PROF_OFF
    LDA #0 : ROL A
    LDX k : STA s6_out + 7,X
    LDY #10 : JSR s6_stop
    LDX k
    LDA pool_last : STA s6_out + 4,X
    LDA num_visits : STA s6_out + 5,X
    JSR s6_state
    LDX k
    LDA s6crc : STA s6_out,X
    LDA s6crc + 1 : STA s6_out + 1,X
    LDA MB_ARG + 2 : BEQ @+     ; the capture alone, for a diagnosis
    LDA num_insts : STA s6_extra
    LDA order_head : STA s6_extra + 1
    LDA order_tail : STA s6_extra + 2
    LDA seg_next : STA s6_extra + 3
    LDA num_pend : STA s6_extra + 4
    RTS
.@  \ the capture lived in the junk rows: the image's are zeroed, as the C's
IF TESTBUF == 0
    LDA #HI(JUNK0) : LDX #HI(JUNK0) + 1 : JSR zero_pages
    LDA #HI(JUNK1) : LDX #HI(JUNK1) + 1 : JSR zero_pages
ELSE
    LDA #HI(JUNK2) : LDX #HI(JUNK2) + 1 : JSR zero_pages
ENDIF
    JSR s6_start
    LDX k : LDA s6_out + 7,X : BNE dropped
    PROF_ON
    JSR plot
    LDA MB_ARG + 1 : BEQ @+
    JSR sprite_pass
.@  JSR fill
    PROF_OFF
.dropped
    LDX k : LDY #13 : JSR s6_stop

    LDY #0                      ; the lowest stack byte written
.low
    TYA : EOR #&A5 : CMP &100,Y : BNE @+
    INY : CPY top : BNE low
.@  LDX k
    TYA : STA s6_out + 6,X

    LDA #0 : STA s6crc : STA s6crc + 1 : STA p     ; the image's CRC
    LDA #HI(IMG_START) : STA p + 1
    LDY #0
.byte
    LDA (p),Y : JSR s6_crc
    INY : BNE byte
    INC p + 1
    LDA p + 1 : CMP #HI(IMG_END) : BNE byte
    LDX k
    LDA s6crc : STA s6_out + 2,X
    LDA s6crc + 1 : STA s6_out + 3,X
    TXA : CLC : ADC #S6_REC : STA k
    DEC left : BEQ done
    JMP pose                    ; (out of branch range)
.done
IF SUITE == 4
    LDA #&40 : STA &FE4E        ; T1's interrupt off
ENDIF
    RTS
}

\\ The capture's CRC into s6crc (as the header lists it).
.s6_state
{
    LDA #0 : STA s6crc : STA s6crc + 1
    LDY #0
.piece
    CPY pool_last : BEQ pieced
    INY
    LDA p_x0,Y : JSR s6_crc
    LDA p_x1,Y : JSR s6_crc
    LDA p_y0,Y : JSR s6_crc
    LDA p_yf,Y : JSR s6_crc
    LDA p_glo,Y : JSR s6_crc
    LDA p_ghi,Y : JSR s6_crc
    LDA p_ce,Y : JSR s6_crc
    LDA p_co,Y : JSR s6_crc
    LDA p_next,Y : JSR s6_crc
    JMP piece
.pieced
    LDY #1
.visit
    CPY num_visits : BCC @+
    JMP visited                 ; (out of branch range)
.@  LDA vs_cell,Y : JSR s6_crc
    LDA vs_xr,Y : BEQ fresh0
    LDA vs_k,Y : JSR s6_crc
    LDA vs_x,Y : JSR s6_crc
    JMP walked
.fresh0                         ; never entered: no cursor or columns yet
    LDA #0 : JSR s6_crc
    LDA #0 : JSR s6_crc
.walked
    LDA vs_xr,Y : JSR s6_crc
    LDA vs_tcur,Y : JSR s6_crc
    LDA vs_bcur,Y : JSR s6_crc
    LDA vs_tmax,Y : JSR s6_crc
    LDA vs_bmin,Y : JSR s6_crc
    LDA vs_xr,Y : BEQ fresh1
    LDA vs0_xl,Y : JSR s6_crc
    LDA vs0_xh,Y : JSR s6_crc
    LDA vs0_yl,Y : JSR s6_crc
    LDA vs0_yh,Y : JSR s6_crc
    LDA vs0_sx,Y : JSR s6_crc
    LDA vs0_fl,Y : JSR s6_crc
    LDA vs0_f,Y : JSR s6_crc
    LDA vs0_e,Y : JSR s6_crc
    LDA vs1_xl,Y : JSR s6_crc
    LDA vs1_xh,Y : JSR s6_crc
    LDA vs1_yl,Y : JSR s6_crc
    LDA vs1_yh,Y : JSR s6_crc
    LDA vs1_sx,Y : JSR s6_crc
    LDA vs1_fl,Y : JSR s6_crc
    LDA vs1_f,Y : JSR s6_crc
    LDA vs1_e,Y : JSR s6_crc
    LDA vs_inst,Y : JSR s6_crc
    JMP acts
.fresh1                         ; nor vertices, nor an instance
    FOR i = 0 ..< 17
        LDA #0 : JSR s6_crc
    NEXT
.acts
    FOR s = 0 ..< PT_NUM_SLOTS
        LDA vs_act + s * VISITS,Y : JSR s6_crc
    NEXT
    INY
    JMP visit
.visited
    LDY #1
.inst
    CPY num_insts : BCS insted
    LDA in_sprite,Y : JSR s6_crc
    LDA in_cx0,Y : JSR s6_crc
    LDA in_cx1,Y : JSR s6_crc
    LDA in_seg,Y : JSR s6_crc
    LDA in_segt,Y : JSR s6_crc
    LDA in_prev,Y : JSR s6_crc
    LDA in_next,Y : JSR s6_crc
    LDA in_scl,Y : JSR s6_crc
    LDA in_sch,Y : JSR s6_crc
    LDA in_l0,Y : JSR s6_crc
    LDA in_l1,Y : JSR s6_crc
    LDA in_l2,Y : JSR s6_crc
    LDA in_t0,Y : JSR s6_crc
    LDA in_t1,Y : JSR s6_crc
    LDA in_t2,Y : JSR s6_crc
    INY
    JMP inst
.insted
    LDA order_head : JSR s6_crc
    LDA order_tail : JSR s6_crc
    LDA seg_next : JSR s6_crc
    LDY #1
.seg
    CPY seg_next : BEQ segged
    LDA segs,Y : JSR s6_crc
    INY : BNE seg
.segged
    LDA num_pend
    JMP s6_crc
}
