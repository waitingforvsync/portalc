\ **************************************************************************
\ *
\ *     clip.6502 - pieces, bounds and the clip (render.c; spec 7.9)
\ *
\ **************************************************************************
\
\ A row is a biased u8.8 value: the row in the high byte, its fraction plus
\ a half in the low, so the nearest row is just the high byte. A piece
\ keeps its exact row at x0 (p_y0 and p_yf), so a split never moves a row
\ and the plotter starts from the fraction the clip compared. A gradient
\ is a sign (bit 7 of its high byte) and a u7.8 magnitude.
\
\ One clip runs at a time, so its context is zero-page globals: render.c's
\ pt_clip as cx_*, the line being clipped as l_*. The bounds' pieces are
\ cx_p + ST_ABOVE (the top's) and cx_p + ST_BELOW (the bottom's), so a
\ side's status indexes its own. A visit's active pieces are four tables
\ of VISITS end to end, a slot each (vs_act, scratch.6502): cx_act is the
\ line's entry, its slot's table plus its visit.
\
\ What render.c passes from call to call in the clip lives here too: the
\ range being placed and its row (rg_*), and the line's and the bound's
\ rows where a run starts (rn_*), which hide and meet move on as they go
\ and flip and merge only read.

\ A capacity overflow (PLAN.md 4.4, D9): the release drops the frame, and
\ a test build stops with the code (unless a check asks for the release's
\ way: test/mailbox.6502's overflow).
MACRO OVERFLOW code
    IF HARNESS
        LDA #code : JMP overflow
    ELSE
        JMP capture_abort
    ENDIF
ENDMACRO

ST_ABOVE = 0                    ; clip statuses (render.c's): hidden above the top...
ST_BELOW = 1                    ; ...hidden below the bottom...
ST_VISIBLE = 2                  ; ...between them...
ST_NONE = 3                     ; ...and the shut status of a line forming no bound

ZA_AUTO 2, cx_p                 ; the bounds' pieces at or before the column reached, a status each
ZA_AUTO1 cx_tmax, cx_bmin       ; the bounds' row extents, for the fast path
ZA_AUTO1 cx_act                 ; the line's active piece: its index in vs_act
ZA_AUTO1 cx_shut                ; the status that closes the child: ST_ABOVE for the line forming
                                ; its bottom, ST_BELOW its top, else ST_NONE
ZA_AUTO1 cx_child, cx_tail      ; the visit whose bound the line builds, and its last piece (0 none)
ZA_AUTO1 cx_own                 ; the line's last range so far: 0 none, 1 hidden, 2 visible
ZA_AUTO1 cx_lc                  ; the line's row in hand: its column plus one (0 none)...
ZA_AUTO2 cx_ly                  ; ...and the row
ZA_AUTO1 cx_cbfbe, cx_cbfbo     ; the child's ceiling EOR its floor: its whole stack, telescoped
ZA_AUTO1 cx_rl, cx_rr           ; the open run being tallied, [rl, rr) (empty: none)
ZA_AUTO1 cx_ol, cx_orr          ; the first, the child's (empty: none yet)
ZA_AUTO1 rg_r0, rg_r1           ; a range being placed, [r0, r1)...
ZA_AUTO2 rg_y                   ; ...and the row at r0, in hand
ZA_AUTO2 rn_yl, rn_yp           ; the line's and the bound's rows where a run starts
ZA_AUTO1 l_x0, l_x1             ; the line: on the screen over [x0, x1)...
ZA_AUTO2 l_y, l_g               ; ...its row at x0 and its gradient...
ZA_AUTO1 l_below                ; ...the side it was cut off on (1 below the screen)...
ZA_AUTO1 l_ce, l_co             ; ...and its colour

\ ---- rows ----

\\ y + or - |g| * dx: the add saturates at &FFFF, the subtract stops at 0
\\ (and a product past &FFFF reaches either end whatever y was).
\\ in: y, g, A = dx. out: y.
.row_step
{
    ZA_AUTO2 y, g               ; in (y also out)
    ZA_AUTO1 m, dl              ; local: |g|'s high byte, then the product's; its low byte
    TAY : BEQ done              ; at the anchor: nothing to add
    LDA g + 1 : AND #&7F : BNE steep
    ORA g : BEQ done            ; flat
    TYA : SETMUL                ; dx
    LDY g : MULX : STX dl       ; shallow: |g|.lo * dx, 16 bits
.sign
    STA m
    BIT g + 1 : BMI up
    LDA y : CLC : ADC dl : STA y
    LDA y + 1 : ADC m : STA y + 1
    BCC done
.ff
    LDA #&FF : STA y : STA y + 1
    RTS
.up
    LDA y : SEC : SBC dl : STA y
    LDA y + 1 : SBC m : STA y + 1
    BCS done
.zero
    LDA #0 : STA y : STA y + 1
.done
    RTS
.sat
    BIT g + 1 : BMI zero
    BPL ff                      ; (always)
.steep
    STA m
    TYA : SETMUL                ; dx
    LDY m : MULX : BNE sat      ; |g|.hi * dx past a byte: past 16 bits
    STX m                       ; its low byte, 8 bits up
    LDY g : MULX : STX dl       ; + |g|.lo * dx
    CLC : ADC m : BCS sat       ; its high byte; a carry saturates
    BCC sign                    ; (always)
}

\\ Piece X's row at column A (at or past its x0), in row_step.y.
.piece_y
{
    SEC : SBC p_x0,X
    LDY p_yf,X : STY row_step.y
    LDY p_y0,X : STY row_step.y + 1
    LDY p_glo,X : STY row_step.g
    LDY p_ghi,X : STY row_step.g + 1
    JMP row_step
}

\\ The line's row at column A for its clip, into cx_ly: the row in hand
\\ (cx_lc is c + 1), or one column on from it (cx_lc is c, c inside the
\\ line: the plotter's own step, an add, no product), or else worked out;
\\ it's then in hand. Where the line was cut off at the screen's edge
\\ (outside [x0, x1)) it's beyond every bound on that side: the furthest
\\ row there is, &FFFF below and 0 above.
.line_at
{
    ZA_AUTO1 c, t               ; local: the column; |g|'s high byte
    STA c
    TAX : INX
    CPX cx_lc : BEQ done        ; c + 1: in hand already
    LDY cx_lc : STX cx_lc       ; (Y = the column in hand plus one) c's from here on
    CMP l_x1 : BCS cut          ; (an empty line, x0 = x1, is cut off throughout)
    CMP l_x0 : BCC cut
    BEQ anchor
    CPY c : BNE eval            ; the row in hand is c - 1's: a step on
    LDA l_g + 1 : BMI up
    CLC
    LDA cx_ly : ADC l_g : STA cx_ly
    LDA cx_ly + 1 : ADC l_g + 1 : STA cx_ly + 1
    BCC done
    LDA #&FF : STA cx_ly : STA cx_ly + 1    ; past &FFFF: saturated
.done
    RTS
.up                             ; (C set by the CPY)
    AND #&7F : STA t
    LDA cx_ly : SBC l_g : STA cx_ly
    LDA cx_ly + 1 : SBC t : STA cx_ly + 1
    BCS done
    LDA #0 : STA cx_ly : STA cx_ly + 1      ; past 0: stops there
    RTS
.anchor
    LDA l_y : STA cx_ly
    LDA l_y + 1 : STA cx_ly + 1
    RTS
.cut
    LDA #0
    LDX l_below : BEQ @+
    LDA #&FF
.@  STA cx_ly : STA cx_ly + 1
    RTS
.eval
    LDA c : SEC : SBC l_x0      ; dx
    LDY l_y : STY row_step.y
    LDY l_y + 1 : STY row_step.y + 1
    LDY l_g : STY row_step.g
    LDY l_g + 1 : STY row_step.g + 1
    JSR row_step
    LDA row_step.y : STA cx_ly
    LDA row_step.y + 1 : STA cx_ly + 1
    RTS
}

\ ---- the pool ----

\ A new piece: X = its index, its fields the caller's to fill straight
\ into the pool's pages. Keeps A and Y.
MACRO POOL_NEW
{
    LDX pool_last : INX : BNE room
    OVERFLOW 2                  ; the pool's full
.room
    STX pool_last
}
ENDMACRO

\ Piece X's row at x0 from y, a biased u8.8 value: on the screen's bottom
\ edge if it's further down (render.c's pool_alloc), a hidden piece of a
\ line past its pre-clip column, which stays below every bound there
\ either way. Keeps X and Y.
MACRO PUT_ROW y
{
    LDA y + 1 : CMP #PT_SCREEN_HEIGHT + 1 : BCS low
    STA p_y0,X
    LDA y : STA p_yf,X
    BCC done                    ; (always)
.low
    LDA #PT_SCREEN_HEIGHT : STA p_y0,X
    LDA #128 : STA p_yf,X
.done
}
ENDMACRO

\\ Split piece X at column A, where its row is row_step.y: it keeps
\\ [x0, c), a new piece takes [c, x1) from that row exactly. out: X = the
\\ piece, Y = the new one.
.pool_split
{
    ZA_AUTO1 p, c               ; local
    STX p : STA c
    POOL_NEW
    PUT_ROW row_step.y
    LDY p
    LDA p_x1,Y : STA p_x1,X
    LDA c : STA p_x0,X : STA p_x1,Y
    LDA p_glo,Y : STA p_glo,X
    LDA p_ghi,Y : STA p_ghi,X
    LDA p_ce,Y : STA p_ce,X
    LDA p_co,Y : STA p_co,X
    LDA p_next,Y : STA p_next,X ; linked in after it
    TXA : STA p_next,Y
    TAY : LDX p
    RTS
}

\\ The piece of chain X holding column A. out: X.
.piece_at
{
.loop
    CMP p_x1,X : BCC donex      ; c < x1: this one (x0 <= c on a chain walked in order)
    LDY p_next,X
    CMP p_x1,Y : BCC doney
    LDX p_next,Y
    JMP loop
.doney
    TYA : TAX
.donex
    RTS
}

\ ---- the line's pieces, and the bounds it builds ----

\\ The line's own piece over [rg_r0, rg_r1), status A: coloured where it's
\\ visible, not where it's hidden (kept so a later visit can extend it).
\\ The line's last piece grows if it ends at r0 in that colour, keeping its
\\ anchor; else a new piece starts at rg_y, the line's row at r0. A line
\\ forming one of the child's bounds has its visible pieces in that bound,
\\ so for one of those the last piece must also be visible or hidden alike
\\ (a bound line can be uncoloured: the child's floor the same shade as
\\ the parent's), unless it's from an earlier visit (cx_own 0).
\\ in: A = st, rg_*. out: X = the piece.
.own_piece
{
    ZA_AUTO1 ce, co, own        ; local
    LDX #0 : STX ce : STX co
    INX                         ; hidden: uncoloured, own 1
    CMP #ST_VISIBLE : BNE @+
    LDA l_ce : STA ce
    LDA l_co : STA co
    INX                         ; visible: own 2
.@  STX own
    LDY cx_own : STX cx_own     ; (Y = the line's last range)
    LDX cx_act : LDA vs_act,X : BEQ new
    TAX
    LDA p_x1,X : CMP rg_r0 : BNE new
    LDA p_ce,X : CMP ce : BNE new
    LDA p_co,X : CMP co : BNE new
    LDA cx_shut : CMP #ST_NONE : BEQ grow   ; alike: no bound built...
    TYA : BEQ grow              ; ...or nothing of the line's yet this visit...
    CPY own : BNE new           ; ...or as its last
.grow
    LDA rg_r1 : STA p_x1,X
    RTS
.new
    POOL_NEW
    TXA : LDY cx_act : STA vs_act,Y
    PUT_ROW rg_y
    LDA rg_r0 : STA p_x0,X
    LDA rg_r1 : STA p_x1,X
    LDA l_g : STA p_glo,X
    LDA l_g + 1 : STA p_ghi,X
    LDA ce : STA p_ce,X
    LDA co : STA p_co,X
    LDA #0 : STA p_next,X
    RTS
}

\\ Link piece X, over columns up to rg_r1, into the bound the line builds:
\\ its head, or after its tail (X may be the tail already, grown). The
\\ bound's row extent takes in the new columns: the bottom's least row,
\\ the top's greatest. A piece is straight, so that's at one end of them,
\\ the gradient's sign says which; rg_y is the row at the first, in hand.
\\ (X is the line's own piece or a twin: in no other chain still walked.)
.chain_add
{
    CPX cx_tail : BEQ linked
    LDA #0 : STA p_next,X
    LDY cx_tail : BEQ head
    TXA : STA p_next,Y
    JMP tail
.head
    LDY cx_child
    TXA
    LDX cx_shut : BNE top       ; (ST_ABOVE: the line builds the bottom)
    STA vs_bcur,Y
    BEQ tailx                   ; (always: X = 0)
.top
    STA vs_tcur,Y
.tailx
    TAX
.tail
    STX cx_tail
.linked
    LDA cx_shut : BNE topx
    LDA p_ghi,X : BPL bnear     ; the bottom's least row: a falling one's at r0
    LDA rg_r1 : SEC : SBC #1 : JSR piece_y  ; a rising one's at r1 - 1
    LDA row_step.y : LDY row_step.y + 1
    JMP bmin
.bnear
    LDA rg_y : LDY rg_y + 1
.bmin                           ; the row it truncates into, (y - 128) >> 8 (bmin is
    CMP #128                    ; at most H, so one past H never takes)
    TYA : SBC #0 : BCS @+
    LDA #0
.@  LDY cx_child
    CMP vs_bmin,Y : BCS done
    STA vs_bmin,Y
.done
    RTS
.topx
    LDA p_ghi,X : BMI tnear     ; the top's greatest row: a rising one's at r0
    LDA rg_r1 : SEC : SBC #1 : JSR piece_y  ; a falling one's at r1 - 1
    LDA row_step.y : LDY row_step.y + 1
    JMP tmax
.tnear
    LDA rg_y : LDY rg_y + 1
.tmax                           ; the row it rounds up into, (y + 127) >> 8, at most H
    CMP #129
    TYA : ADC #0 : BCS clamp
    CMP #PT_SCREEN_HEIGHT + 1 : BCC @+
.clamp
    LDA #PT_SCREEN_HEIGHT
.@  LDY cx_child
    CMP vs_tmax,Y : BCC done : BEQ done
    STA vs_tmax,Y
    RTS
}

\\ Close columns [l, rr) of a bound after the fact: the child's whole stack
\\ there telescopes to its ceiling EOR its floor, EORed into the bound's
\\ pieces over exactly those columns, as a merge does where the line closes
\\ the child. in: X = the bound (a piece at or before l), l, rr, cbe, cbo.
.close_columns
{
    ZA_AUTO1 l, rr, cbe, cbo    ; in
    ZA_AUTO1 p                  ; local
    LDA l : JSR piece_at
    LDA p_x0,X : CMP l : BCS run
    STX p
    LDA l : JSR piece_y         ; starts before l: split there
    LDX p : LDA l : JSR pool_split
    TYA : TAX
.run
    LDA p_x0,X : CMP rr : BCS done
    LDA rr : CMP p_x1,X : BCS whole
    STX p
    JSR piece_y                 ; (A = rr) ends past rr: split there
    LDX p : LDA rr : JSR pool_split
.whole
    LDA p_ce,X : EOR cbe : STA p_ce,X
    LDA p_co,X : EOR cbo : STA p_co,X
    LDA p_next,X : TAX : BNE run
.done
    RTS
}

\ Columns [r0, r1) where the line leaves the child open: the run goes on.
MACRO RUN_OPEN r0, r1
{
    LDA cx_rl : CMP cx_rr : BNE on
    LDA r0 : STA cx_rl
.on
    LDA r1 : STA cx_rr
}
ENDMACRO

\\ The open run ends. Every portal opening is convex on the screen (spec
\\ 7.9.4), so its open columns are one run, closed only at its ends, and
\\ the child is that run. Exact rows keep it so but for a crossing's
\\ rounding, which could pinch a sliver-thin opening shut in the middle:
\\ then the child is the first run, and a later one is closed after the
\\ fact.
.run_end
{
    LDA cx_rl : CMP cx_rr : BEQ done
    LDA cx_ol : CMP cx_orr : BNE close
    LDA cx_rl : STA cx_ol
    LDA cx_rr : STA cx_orr
    JMP over
.close
    LDA cx_rl : STA close_columns.l
    LDA cx_rr : STA close_columns.rr
    LDA cx_cbfbe : STA close_columns.cbe
    LDA cx_cbfbo : STA close_columns.cbo
    LDY cx_child : LDX vs_bcur,Y
    JSR close_columns
.over
    LDA #0 : STA cx_rl : STA cx_rr
.done
    RTS
}

\ ---- clipping a line against the bounds (spec 7.9) ----
\
\ A bound is a chain of pieces, left to right. A hidden stretch of a line
\ is merged into the bound piece hiding it, split from it only at the
\ stretch's ends. A line forming a bound builds the child's bound from its
\ own visible pieces and twins of the parent's pieces where it's hidden,
\ so a chain, once built, only ever gains pieces by splits.

\\ |ga - gb| for two sign-and-magnitude gradients: the same signs subtract,
\\ opposite ones add (both under &8000, so no carry).
\\ in: ga, gb. out: d.
.grad_diff
{
    ZA_AUTO2 ga, gb             ; in
    ZA_AUTO2 d                  ; out
    LDA gb + 1 : AND #&7F : STA d + 1   ; |gb|, for now
    LDA ga + 1 : EOR gb + 1 : BMI add
    LDA ga + 1 : AND #&7F : TAX ; |ga| high
    LDA ga : SEC : SBC gb : STA d       ; |ga| - |gb|...
    TXA : SBC d + 1 : STA d + 1
    BCS done
    LDA #0 : SEC : SBC d : STA d        ; ...or |gb| - |ga|
    LDA #0 : SBC d + 1 : STA d + 1
    RTS
.add
    LDA ga : CLC : ADC gb : STA d
    LDA ga + 1 : AND #&7F : ADC d + 1 : STA d + 1
.done
    RTS
}

\\ The first column at or after which a linear difference has changed sign:
\\ floor(d0 / dg) + 1, inside (c, e).
\\ in: c, e, d0, dg (dg > 0). out: A.
.crossing
{
    ZA_AUTO1 c, e               ; in
    ZA_AUTO2 d0, dg             ; in
    LDA d0 : STA div_cols.num
    LDA d0 + 1 : STA div_cols.num + 1
    LDA dg : STA div_cols.den
    LDA dg + 1 : STA div_cols.den + 1
    JSR div_cols                ; q
    TAX
    LDA e : CLC : SBC c         ; span = e - 1 - c (C clear: one more off)
    STX e                       ; (e's done with: q)
    CMP e : BCC span            ; span <= q: span...
    BEQ span
    LDA e : CLC : ADC #1        ; ...else q + 1
.span                           ; (never 0: the sign changes between c and e - 1, so
    CLC : ADC c                 ; e - 1 > c, and the C's "at least 1" is dead)
    RTS
}

\\ Merge the line's colour into the bound piece on side st over exactly
\\ [r0, r1) (spec 7.9.1: the same as plotting the line on the bound),
\\ split from it only at the range's ends and only if there's a colour to
\\ merge. Where the line closes the child, the child's stack goes in with
\\ it and the open run ends. Where the line forms the child's bound, the
\\ bound there is a twin of the piece: a new one on the same rows exactly,
\\ uncoloured until the child's own lines merge into it. So the parent's
\\ bound is never relinked: splits only ever add to a chain, and its
\\ cursors stay good. With own, the line keeps a hidden piece of its own
\\ there, where it's on the screen. rn_yl and rn_yp are the line's and the
\\ piece's rows at r0 (the own piece's start, and the split's and the
\\ twin's). in: r0, r1, st, own, rn_*.
.merge
{
    ZA_AUTO1 r0, r1, st, own    ; in
    ZA_AUTO1 ce, co, p          ; local
    LDA l_ce : STA ce
    LDA l_co : STA co
    LDA st : CMP cx_shut : BNE @+
    LDA ce : EOR cx_cbfbe : STA ce      ; the line closes the child: its stack too
    LDA co : EOR cx_cbfbo : STA co
.@  LDY st : LDX cx_p,Y : ZA_INDEXEDBY 0..1
    LDA ce : ORA co : BEQ merged
    LDA p_x0,X : CMP r0 : BCS @+
    LDA rn_yp : STA row_step.y          ; starts before r0: split there...
    LDA rn_yp + 1 : STA row_step.y + 1
    LDA r0 : JSR pool_split
    TYA : TAX                           ; ...and on with the second part
    LDY st : STX cx_p,Y : ZA_INDEXEDBY 0..1
.@  LDA r1 : CMP p_x1,X : BCS whole
    STX p
    JSR piece_y                         ; (A = r1) ends past r1: split there
    LDX p : LDA r1 : JSR pool_split
.whole
    LDA p_ce,X : EOR ce : STA p_ce,X
    LDA p_co,X : EOR co : STA p_co,X
.merged
    LDA st : CMP cx_shut : BNE open
    JSR run_end                         ; closed here: the open run ends
    JMP owned
.open
    LDA cx_shut : CMP #ST_NONE : BEQ owned
    STX p                               ; the child's bound here: a twin
    LDA r0 : STA rg_r0
    LDA r1 : STA rg_r1
    LDA rn_yp : STA rg_y
    LDA rn_yp + 1 : STA rg_y + 1
    POOL_NEW
    PUT_ROW rg_y
    LDA r0 : STA p_x0,X
    LDA r1 : STA p_x1,X
    LDY p
    LDA p_glo,Y : STA p_glo,X
    LDA p_ghi,Y : STA p_ghi,X
    LDA #0 : STA p_ce,X : STA p_co,X    ; (chain_add ends its chain)
    JSR chain_add
    RUN_OPEN r0, r1
.owned
    LDA own : BEQ done
    LDA r0 : CMP l_x0 : BCS @+          ; where the line is on the screen:
    LDA l_x0                            ; [max(r0, x0), min(r1, x1))
.@  STA rg_r0
    LDA r1 : CMP l_x1 : BCC @+
    LDA l_x1
.@  STA rg_r1
    CMP rg_r0 : BEQ done : BCC done
    LDA rg_r0 : CMP r0 : BNE later
    LDA rn_yl : STA rg_y                ; from r0: the row in hand
    LDA rn_yl + 1 : STA rg_y + 1
    LDA st
    JMP own_piece
.later
    JSR line_at                         ; (A = its first column)
    LDA cx_ly : STA rg_y
    LDA cx_ly + 1 : STA rg_y + 1
    LDA st
    JMP own_piece
.done
    RTS
}

\\ A visible range [rg_r0, rg_r1): the line's own piece, coloured, and in
\\ the child's bound if it forms one. rg_y is the line's row at r0.
.visible
{
    LDA #ST_VISIBLE : JSR own_piece
    LDA cx_shut : CMP #ST_NONE : BEQ done
    JSR chain_add
    RUN_OPEN rg_r0, rg_r1
.done
    RTS
}

\\ The first column of [c, e) where the line, against bound piece p, is no
\\ longer beyond it on side st (with in 1) or is (in 0), or e; rn_yl and
\\ rn_yp are their rows at c (on the bound counts as beyond: a line on a
\\ bound merges, the same pixels with one fewer plot). A stretch of the
\\ line at a time: over each both are single lines, so their difference
\\ changes sign at most once (and a stretch where the line was cut off is
\\ beyond on its side throughout). The difference is side st's way round
\\ (the bound's row less the line's above, the line's less the bound's
\\ below), so no borrow is beyond.
\\ in: p, c, e, st, in, rn_*. out: A.
.flip
{
    ZA_AUTO1 p, c, e, st, in    ; in
    ZA_AUTO1 s, last            ; local: the stretch's end, and its last column
    ZA_AUTO2 d                  ; local: the difference at c
    LDA st : BNE below
    LDA rn_yp : SEC : SBC rn_yl : STA d
    LDA rn_yp + 1 : SBC rn_yl + 1 : STA d + 1
    JMP stretch
.below
    LDA rn_yl : SEC : SBC rn_yp : STA d
    LDA rn_yl + 1 : SBC rn_yp + 1 : STA d + 1
.stretch                        ; (C: beyond at c)
    LDA #0 : ROL A : CMP in : BEQ @+
    LDA c                       ; not as it was at c, already
    RTS
.@  LDA c : CMP l_x0 : BCS @+   ; the stretch: to the line's start...
    LDA l_x0
    BCC cap                     ; (always)
.@  CMP l_x1 : BCS ends         ; ...or its end, or e, whichever's first
    LDA l_x1
.cap
    CMP e : BCC @+
.ends
    LDA e
.@  STA s
    TAX : DEX : STX last
    LDA c : CMP l_x0 : BCC cut
    CMP l_x1 : BCC on
.cut                            ; cut off throughout, its row the furthest there is on
    LDA l_below : CMP st : BNE on   ; its side: on the bound's side it's beyond to the
    INX : STX cx_lc             ; end, whatever the bound's rows (and in is 1: at c it
    LDA #0 : LDY st : BEQ @+    ; was), so only the line's row is taken, as line_at
    LDA #&FF                    ; takes it
.@  STA cx_ly : STA cx_ly + 1
    JMP same
.on
    TXA : JSR line_at           ; the line's row at the stretch's last column...
    LDX p : LDA last : JSR piece_y  ; ...and the piece's
    LDA st : BNE below1
    LDA row_step.y : CMP cx_ly
    LDA row_step.y + 1 : SBC cx_ly + 1
    JMP side
.below1
    LDA cx_ly : CMP row_step.y
    LDA cx_ly + 1 : SBC row_step.y + 1
.side
    LDA #0 : ROL A : CMP in : BNE cross
.same
    LDA s : CMP e : BCC next
    RTS                         ; as at c to the end
.next                           ; the next stretch, from s
    STA c
    JSR line_at                 ; (one on from the last: a step, or a cut-off's row)
    LDX p : LDA c : JSR piece_y
    LDA st : BNE below2
    LDA row_step.y : SEC : SBC cx_ly : STA d
    LDA row_step.y + 1 : SBC cx_ly + 1 : STA d + 1
    JMP stretch
.below2
    LDA cx_ly : SEC : SBC row_step.y : STA d
    LDA cx_ly + 1 : SBC row_step.y + 1 : STA d + 1
    JMP stretch
.cross                          ; the sign changes inside the stretch: where
    LDA l_g : STA grad_diff.ga
    LDA l_g + 1 : STA grad_diff.ga + 1
    LDX p
    LDA p_glo,X : STA grad_diff.gb
    LDA p_ghi,X : STA grad_diff.gb + 1
    JSR grad_diff
    LDA grad_diff.d : ORA grad_diff.d + 1 : BEQ parallel
    LDA grad_diff.d : STA crossing.dg
    LDA grad_diff.d + 1 : STA crossing.dg + 1
    LDA in : BNE @+             ; the difference's size at c: it was beyond with in,
    LDA #0 : SEC : SBC d : STA d    ; not beyond (negative) without
    LDA #0 : SBC d + 1 : STA d + 1
.@  LDA d : STA crossing.d0
    LDA d + 1 : STA crossing.d0 + 1
    LDA c : STA crossing.c
    LDA s : STA crossing.e
    JMP crossing
.parallel                       ; (a saturated row: the stretch's last column)
    LDA last
    RTS
}

\\ A hidden run from column c, the line beyond the bound on side st there
\\ (rn_yl and rn_yp: the line's and the bound's rows at c): it merges into
\\ that bound's pieces one after another until it comes back inside, or
\\ c1. in: c, c1, st, rn_*. out: A = the run's end.
.hide
{
    ZA_AUTO1 c, c1, st          ; in
    ZA_AUTO1 e, x               ; local
    LDY st : LDX cx_p,Y : ZA_INDEXEDBY 0..1
    LDA c : JSR piece_at
.piece                          ; (X = the bound's piece at c)
    LDY st : STX cx_p,Y : ZA_INDEXEDBY 0..1
    STX flip.p
    LDA p_x1,X : CMP c1 : BCC @+
    LDA c1
.@  STA e : STA flip.e
    LDA c : STA flip.c
    STY flip.st
    LDA #1 : STA flip.in
    JSR flip
    CMP c : BEQ done            ; back inside where the piece starts
    STA x
    STA merge.r1
    LDA c : STA merge.r0
    LDA st : STA merge.st
    LDA #1 : STA merge.own
    JSR merge
    LDA x : CMP e : BCC done    ; back inside in the piece...
    CMP c1 : BCS done           ; ...or at the end
    STA c
    JSR line_at                 ; one on from the stretch's last: a step
    LDA cx_ly : STA rn_yl
    LDA cx_ly + 1 : STA rn_yl + 1
    LDY st : LDX cx_p,Y : ZA_INDEXEDBY 0..1
    LDA c : JSR piece_at        ; the next piece, which starts at c...
    LDA p_yf,X : STA rn_yp      ; ...on its anchor row: no product
    LDA p_y0,X : STA rn_yp + 1
    JMP piece
.done
    RTS
}

\\ Where a line inside the bounds at column c first meets the bound on
\\ side st (reaches it or goes beyond), walking that bound's pieces from
\\ p; c1 if it doesn't before then. rn_yl and rn_yp: the line's and p's
\\ rows at c. in: p, c, c1, st, rn_*. out: A.
.meet
{
    ZA_AUTO1 p, c, c1, st       ; in
    ZA_AUTO1 e                  ; local
    LDX p : LDA c : JSR piece_at
.piece                          ; (X = the piece at c)
    STX p : STX flip.p
    LDA p_x1,X : CMP c1 : BCC @+
    LDA c1
.@  STA e : STA flip.e
    LDA c : STA flip.c
    LDA st : STA flip.st
    LDA #0 : STA flip.in
    JSR flip
    CMP e : BCC done            ; met inside the piece...
    LDX e : CPX c1 : BCS done   ; ...or not by c1
    STX c
    TXA : JSR line_at           ; one on from the stretch's last: a step
    LDA cx_ly : STA rn_yl
    LDA cx_ly + 1 : STA rn_yl + 1
    LDX p : LDA c : JSR piece_at    ; the next piece, which starts at c...
    LDA p_yf,X : STA rn_yp      ; ...on its anchor row: no product
    LDA p_y0,X : STA rn_yp + 1
    JMP piece
.done
    RTS
}

\ The fast path's test: is row y (biased u8.8, unclamped) inside the
\ bounds' extents, at or below the top's lowest row and at or above the
\ bottom's highest? Branches to out if not.
MACRO INSIDE y, out
{
    LDA y : CMP #128            ; (y - 128) >> 8, no borrow, at least tmax...
    LDA y + 1 : SBC #0 : BCC out
    CMP cx_tmax : BCC out
    LDA y : CMP #129            ; ...and (y + 127) >> 8, no carry, at most bmin
    LDA y + 1 : ADC #0 : BCS out
    CMP cx_bmin : BEQ yes : BCS out
.yes
}
ENDMACRO

\\ Clip line l_* over a visit's columns [c, c1) against the bounds, left
\\ to right, a run at a time: a run goes on as long as the line stays
\\ beyond one bound, or between both, so a bound piece is split only where
\\ a run ends inside it. Columns where the line was cut off at the
\\ screen's edge are beyond every bound on that side, and join the run
\\ there. The fast path takes a line lying wholly inside the bounds' row
\\ extents whole. Its rows are unclamped, so a line cut off, or carried
\\ past its pre-clip column (running off the screen), never passes it. A
\\ line is straight, so it's inside if both its ends are; the last
\\ column's row is worked out only if the first's passes. Each run starts
\\ from the rows its first column's test took, the line's and the bounds'.
\\ in: c, c1, cx_*, l_*.
.clip_line
{
    ZA_AUTO1 c, c1              ; in
    ZA_AUTO2 yl, yt, yb         ; local: the rows at c
    LDA #0 : STA cx_lc
    LDA c : JSR line_at
    LDA cx_ly : STA yl
    LDA cx_ly + 1 : STA yl + 1
    INSIDE yl, run
    LDA c1 : SEC : SBC #1 : JSR line_at
    INSIDE cx_ly, run
    LDA c : STA rg_r0           ; wholly inside: one visible range
    LDA c1 : STA rg_r1
    LDA yl : STA rg_y
    LDA yl + 1 : STA rg_y + 1
    JMP visible

.run                            ; the cursors on to c, and the bounds' rows there
    LDA c
    LDX cx_p : JSR piece_at : STX cx_p
    LDA c
    LDX cx_p + 1 : JSR piece_at : STX cx_p + 1
    LDX cx_p : LDA c : JSR piece_y
    LDA row_step.y : STA yt
    LDA row_step.y + 1 : STA yt + 1
    LDA yt : CMP yl             ; above the top (on it counts)?
    LDA yt + 1 : SBC yl + 1 : BCC under
    LDA #ST_ABOVE : STA hide.st
    LDA yt : STA rn_yp
    LDA yt + 1 : STA rn_yp + 1
    JMP hidden
.under
    LDX cx_p + 1 : LDA c : JSR piece_y
    LDA row_step.y : STA yb
    LDA row_step.y + 1 : STA yb + 1
    LDA yl : CMP yb             ; below the bottom (on it counts)?
    LDA yl + 1 : SBC yb + 1 : BCC between
    LDA #ST_BELOW : STA hide.st
    LDA yb : STA rn_yp
    LDA yb + 1 : STA rn_yp + 1
.hidden
    LDA yl : STA rn_yl
    LDA yl + 1 : STA rn_yl + 1
    LDA c : STA hide.c
    LDA c1 : STA hide.c1
    JSR hide
    JMP on
.between                        ; visible to where it meets either bound
    LDA yl : STA rn_yl
    LDA yl + 1 : STA rn_yl + 1
    LDA yt : STA rn_yp
    LDA yt + 1 : STA rn_yp + 1
    LDA cx_p : STA meet.p
    LDA c : STA meet.c
    LDA c1 : STA meet.c1
    LDA #ST_ABOVE : STA meet.st
    JSR meet
    STA meet.c1
    LDA yl : STA rn_yl          ; (the top's meet may have moved them on)
    LDA yl + 1 : STA rn_yl + 1
    LDA yb : STA rn_yp
    LDA yb + 1 : STA rn_yp + 1
    LDA cx_p + 1 : STA meet.p
    LDA c : STA meet.c
    LDA #ST_BELOW : STA meet.st
    JSR meet
    STA rg_r1
    LDA c : STA rg_r0
    LDA yl : STA rg_y
    LDA yl + 1 : STA rg_y + 1
    JSR visible
    LDA rg_r1
.on                             ; (A = the column the run reached)
    CMP c1 : BCS done
    STA c
    JSR line_at
    LDA cx_ly : STA yl
    LDA cx_ly + 1 : STA yl + 1
    JMP run
.done
    RTS
}

\\ Columns [c, c1) where the floor line closed the child: the ceiling
\\ line's above the top there too, and merges into it with nothing
\\ evaluated. It keeps no piece of its own there. in: c, c1.
.merge_above
{
    ZA_AUTO1 c, c1              ; in
    ZA_AUTO1 e                  ; local
.next
    LDA c : CMP c1 : BCS done
    LDX cx_p : JSR piece_at : STX cx_p
    LDA p_x1,X : CMP c1 : BCC @+
    LDA c1
.@  STA e
    LDA c : JSR piece_y         ; the piece's row at c, for a split there
    LDA row_step.y : STA rn_yp
    LDA row_step.y + 1 : STA rn_yp + 1
    LDA c : STA merge.r0
    LDA e : STA merge.r1
    LDA #ST_ABOVE : STA merge.st
    LDA #0 : STA merge.own
    JSR merge
    LDA e : STA c
    JMP next
.done
    RTS
}
