\\ boot.6502 - !BOOT, *RUN by SHIFT-BREAK (the disc's *OPT 4,2): machine
\\ code at &400, as spritescale's.

SECTION Boot, filename = "!BOOT", org = &FFFF1900, exec = &FFFF0000+boot_entry

\\ Silence the beep, find a bank of sideways RAM (an error if there's
\\ none), print the title, run PORTAL.

BASIC
10CALLPAGE+{
    EQUS AS_STRING(sram_check-&1900)
}
20*{
.cmd
    EQUS "/"
.message
    EQUS "PORTAL"
.message_end
}
ENDBASIC

    ZA_ENTRY

.basic_entry

    \\ sideways RAM: a bank whose first byte takes a write

.sram_check
    SEI                                 ; nothing pages it out under us
    LDX #15
.probe
    STX &FE30                           ; ROMSEL: bank X at &8000
    LDA &8000:TAY
    EOR #&FF:STA &8000
    CMP &8000                           ; Z: it took
    STY &8000                           ; put it back
    BEQ found
    DEX
    BPL probe
    
    LDA &F4:STA &FE30                   ; the OS's bank back
    CLI
    BRK
    EQUB 0
    EQUS "PORTAL needs sideways RAM", 0
    ZA_UNREACHABLE                      ; the BRK doesn't come back

.found
    STX &400                            ; the bank, for PORTAL
    LDA &F4:STA &FE30
    CLI
    RTS

    \\ *RUN comes in here

.boot_entry
    CLI
    LDA #15:LDX #0:JSR &FFF4            ; *FX15,0: silence the beep

    \\ print the title

    LDX #0
.messageloop
    LDA message,X
    JSR &FFE3                           ; OSASCI
    INX
    CPX #message_end+1-message
    BNE messageloop
    JSR &FFE7

    JSR sram_check                      ; find a bank of sideways RAM

    \\ run PORTAL

    LDX #LO(cmd)
    LDY #HI(cmd)
    JMP &FFF7                           ; OSCLI


ENDSECTION
