\ **************************************************************************
\ *
\ *     arith.6502 - the fixed-point arithmetic (arith.c; PLAN.md Phase 2)
\ *
\ **************************************************************************
\
\ Every multiply is a quarter-square one, a*b = q(a+b) - q(b-a) with
\ q(x) = x*x/4, read through four zero-page pointers whose low byte is the
\ multiplier: one (zp),Y load per table for any Y = b. Every division is a
\ multiply by a reciprocal normalised into 128..255, so it's 256 + f with f
\ a byte. The tables live at &300-&EFF (tables.6502).
\
\ The primitives are macros named after their C functions, expanded where
\ they're used, on the caller's own variables; the composites (the
\ divisions, the projections, rot) are routines built from them.
\
\ The C's reciprocal multiplies are 17 bits wide. Here they leave 16 in the
\ caller's variable and the 17th in C, which every caller either knows is
\ clear (the routine's asserts keep the product small), takes as
\ saturation, or feeds into its first right shift. A host check over every
\ routine's domain (the Phase 2 journal) backs each claim.
\
\ Not ported: pt_mulu8_neg and pt_mulu16_frac_neg (nothing calls them),
\ and the C's clamps that can never fire (host/uncovered.txt and the
\ Phase 2 journal): grad_mag's, gradq8_mag's right-shift one, div_q8's
\ byte-denominator and e < 8 paths and its 0xFFFF one (its only caller
\ divides by 256 or more), project_col's and project_rowd's.

ZA_AUTO2 mul_q1l                ; the multiplier's table pointers: q(a+b) low bytes...
ZA_AUTO2 mul_q1h                ; ...and high; q(b-a) low...
ZA_AUTO2 mul_q2l
ZA_AUTO2 mul_q2h                ; ...and high. Pages set once by arith_init; low bytes by SETMUL

\\ Point the multiply's pointers at their tables, once.
.arith_init
{
    LDA #HI(sq1lo) : STA mul_q1l + 1
    LDA #HI(sq1hi) : STA mul_q1h + 1
    LDA #HI(sq2lo) : STA mul_q2l + 1
    LDA #HI(sq2hi) : STA mul_q2h + 1
    RTS
}

\ ---- the primitives ----

\ A = the multiplier, for every multiply until the next SETMUL.
MACRO SETMUL
    STA mul_q1l : STA mul_q1h
    EOR #&FF
    STA mul_q2l : STA mul_q2h
ENDMACRO

\ The multiplier times Y: X = the low byte, A = the high byte (pt_mulu8).
\ 24-28 cycles: a load crossing a page costs one more.
MACRO MULX
    SEC
    LDA (mul_q1l),Y : SBC (mul_q2l),Y : TAX
    LDA (mul_q1h),Y : SBC (mul_q2h),Y
ENDMACRO

\ The same for the high byte alone (the low one only lends its borrow).
MACRO MULHI
    SEC
    LDA (mul_q1l),Y : SBC (mul_q2l),Y
    LDA (mul_q1h),Y : SBC (mul_q2h),Y
ENDMACRO

\ The same with the low byte stored to lo, leaving X alone.
MACRO MULTO lo
    SEC
    LDA (mul_q1l),Y : SBC (mul_q2l),Y : STA lo
    LDA (mul_q1h),Y : SBC (mul_q2h),Y
ENDMACRO

\ After SETMUL m: r = (u * m) >> 8 for a u16 u, exact. Can't carry out of
\ 16 bits. Clobbers X, Y.
MACRO MULU16_FRAC u, r
{
    LDY u : MULHI : STA r       ; (u.lo * m) >> 8
    LDY u + 1 : MULX : STA r + 1    ; + u.hi * m
    TXA : CLC : ADC r : STA r
    BCC done
    INC r + 1
.done
}
ENDMACRO

\ The same rounded to nearest: 128 added to the low partial before its
\ shift. A u under 256 skips the high multiply. Clobbers X, Y.
MACRO MULU16_FRAC_ROUND u, r
{
    LDY u : MULX
    CPX #&80 : ADC #0 : STA r   ; (u.lo * m + 128) >> 8: the low byte's carry rounds
    LDY u + 1 : BEQ byte
    MULX : STA r + 1
    TXA : CLC : ADC r : STA r
    BCC done
    INC r + 1
    BCS done                    ; (always)
.byte
    STY r + 1                   ; (Y = 0)
.done
}
ENDMACRO

\ After SETMUL dx: r = g * dx, saturating at &FFFF (a gradient times a
\ column count). Clobbers X, Y.
MACRO MULG_U16 g, r
{
    LDY g + 1 : MULX : BNE sat  ; g.hi * dx past a byte: past 16 bits
    STX r + 1                   ; its low byte, 8 bits up
    LDY g : MULX : STX r
    CLC : ADC r + 1 : BCS sat   ; + g.lo * dx's high byte; a carry saturates
    STA r + 1
    JMP done
.sat
    LDA #&FF : STA r : STA r + 1
.done
}
ENDMACRO

\ The reciprocal of a byte n > 0, two lookups. Y = n: A = f, X = e.
MACRO RECIP8
    LDX sbyte,Y
    LDA nrm,Y : TAY
    LDA recipf_n - 128,Y
ENDMACRO

\ The reciprocal of a u16 n >= 256, with Y = n's high byte: A = f, X = e - k
\ (k 0 or 8: a caller shifting by e - 8 asks for it here). n shifts right by
\ the high byte's bit length s, to the high byte's bits moved up ORed with
\ the low byte shifted down (its low bits fall away).
MACRO RECIPW n, k
{
    ZA_AUTO1 m                  ; local: n normalised
    LDX k8,Y                    ; s, 1..8
    LDA n
.shift
    LSR A : DEX : BNE shift     ; the low byte >> s
    ORA nrm,Y : STA m
    IF k == 8
        LDX k8,Y                ; e - 8 = s...
    ELSE
        LDA k8,Y : CLC : ADC #8 - k : TAX   ; e - k = s + 8 - k...
    ENDIF
    LDY m : CPY #128 : BNE f
    DEX                         ; ...one less for a power of two (f = 0 then means 512)
.f
    LDA recipf_n - 128,Y
}
ENDMACRO

\ The reciprocal of a u16 n > 0: A = f, X = e. Clobbers Y.
MACRO RECIP16 n
{
    LDY n + 1 : BEQ byte
    RECIPW n, 0
    JMP done
.byte
    LDY n
    RECIP8
.done
}
ENDMACRO

\ q = num * (256 + f): 16 bits, and the 17th in C. A = f, Y = num, a byte
\ also in num (and not in q). X kept.
MACRO MUL_RECIP8 num, q
    SETMUL
    MULTO q
    CLC : ADC num : STA q + 1   ; num into the high byte: C, the 17th bit
ENDMACRO

\ q = num * (256 + f) >> 8 for a u16 num (not q): num plus (num * f) >> 8,
\ 16 bits and the 17th in C. A = f. X kept; clobbers Y.
MACRO MUL_RECIP16 num, q
{
    SETMUL
    LDY num + 1 : MULTO q : STA q + 1   ; num.hi * f
    LDY num : MULHI             ; + (num.lo * f) >> 8
    CLC : ADC q : STA q
    BCC sum
    INC q + 1                   ; can't wrap: (num * f) >> 8 < 65536
.sum
    CLC : ADC num : STA q       ; + num (A is q either way)
    LDA q + 1 : ADC num + 1 : STA q + 1 ; C: the 17th bit
}
ENDMACRO

\ q = q + 1:A >> X, A the low byte (whole bytes first, then bits). A = the
\ low byte after. Clobbers X, Y.
MACRO ACC_SHR_A q
{
    CPX #8 : BCS bytes
    CPX #0 : BEQ store
.bits
    LSR q + 1 : ROR A
    DEX : BNE bits
    BEQ store                   ; (always)
.bytes
    LDA q + 1                   ; >> 8: the high byte comes down...
    LDY #0 : STY q + 1
    CPX #8 : BEQ store
.byte
    LSR A                       ; ...and the rest of the shift is A's
    DEX : CPX #8 : BNE byte
.store
    STA q
}
ENDMACRO

\ q >>= X, 16 bits. A = the low byte after. Clobbers X, Y.
MACRO ACC_SHR q
    LDA q
    ACC_SHR_A q
ENDMACRO

\ q >>= X with C as q's 17th bit (as the multiplies leave it): the first
\ shift brings it in, and the rest are 16-bit. A = the low byte after; C
\ set after if the result is still past 16 bits (X = 0 with C set).
\ Clobbers X, Y.
MACRO ACC_SHR17 q
{
    LDA q                       ; (C untouched)
    DEX : BMI done              ; a shift of 0: C stays
    ROR q + 1 : ROR A
    ACC_SHR_A q
    CLC                         ; under 2^16 now
.done
}
ENDMACRO

\ q <<= X (X >= 1), stopping with C set if a bit goes past 16 (the caller
\ saturates). A = the low byte after.
MACRO ACC_SHL q
{
    LDA q
.loop
    ASL A : ROL q + 1 : BCS done
    DEX : BNE loop
.done
    STA q
}
ENDMACRO

\ ---- the composites ----

\\ num / den as a u0.8 clip parameter, clamped to 255.
\\ in: num, den (u16; den > 0, num <= den). out: A.
.div_t
{
    ZA_AUTO2 num, den           ; in
    ZA_AUTO2 q                  ; local: the quotient
    LDY den + 1 : BNE wide
    LDY den : RECIP8            ; a byte den: num is a byte too. X = e, 0..8
    LDY num : MUL_RECIP8 num, q
    JMP shift
.wide
    RECIPW den, 8               ; X = e - 8, 0..8
    MUL_RECIP16 num, q
.shift
    BCS sat                     ; a 17th bit: shifted at most 8, t > 255
    ACC_SHR q
    LDY q + 1 : BNE sat
    RTS
.sat
    LDA #&FF
    RTS
}

\\ floor(num / den) for two u8.8 values, clamped to 127 (the crossing quotient).
\\ in: num, den (u16; den > 0). out: A.
.div_cols
{
    ZA_AUTO2 num, den           ; in
    ZA_AUTO2 q                  ; local: the quotient
    RECIP16 den                 ; X = e, 0..16
    MUL_RECIP16 num, q
    ACC_SHR17 q                 ; >> e (0 only for den = 1, where f = 0: no 17th bit)
    LDY q + 1 : BNE sat
    CMP #128 : BCS sat
    RTS
.sat
    LDA #127
    RTS
}

\\ (num << 8) / den, for den >= 256 (the camera's corner deflection, its
\\ only caller, divides by 256 or more). in: num, den (u16). out: q (u16).
.div_q8
{
    ZA_AUTO2 num, den           ; in
    ZA_AUTO2 q                  ; out
    LDY den + 1 : RECIPW den, 8 ; X = e - 8, 0..8
    MUL_RECIP16 num, q
    ACC_SHR17 q                 ; (e - 8 = 0 only for den 256 and 257, where f = 0)
    RTS
}

\\ (dy << 8) / dx: a gradient magnitude from a row delta and a column count.
\\ dy * (256 + f) is under 2^15 (dy <= 64): no 17th bit.
\\ in: A = dy (0..64), Y = dx (>= 1). out: q (u16, u7.8).
.grad_mag
{
    ZA_AUTO2 q                  ; out
    ZA_AUTO1 dy                 ; local
    STA dy
    RECIP8                      ; X = e, A = f
    SETMUL
    LDY dy : MULTO q            ; dy * f...
    CLC : ADC dy                ; ...+ dy << 8
    CPX #0 : BEQ done
.shift
    LSR A : ROR q               ; >> e, the high byte kept in A
    DEX : BNE shift
.done
    STA q + 1
    RTS
}

\\ (dy << 16) / dx_q8, saturating at &7FFF: the near clip's gradient from a
\\ fractional column count. dy * (256 + f) is under 2^15: no 17th bit.
\\ in: A = dy (0..64), dx (u16, > 0). out: q (u16).
.gradq8_mag
{
    ZA_AUTO2 dx                 ; in
    ZA_AUTO2 q                  ; out
    ZA_AUTO1 dy                 ; local
    STA dy
    RECIP16 dx                  ; X = e
    LDY dy : MUL_RECIP8 dy, q   ; X kept
    CPX #8 : BCS right
    TXA : EOR #&FF : ADC #9 : TAX   ; 8 - e: ~e + 9 (C clear)
    ACC_SHL q                   ; << 8 - e
    BCS sat
    LDA q + 1 : BMI sat         ; at or past &8000
    RTS
.right
    TXA : SBC #8 : TAX          ; e - 8 (C set by the CPX)
    ACC_SHR q
    RTS
.sat
    LDA #&FF : STA q
    LDA #&7F : STA q + 1
    RTS
}

\\ floor(64 + 64*y/x): the screen column of an in-frustum vertex. From e = 6
\\ (depth 33) on, |y| * (256 + f) >> 8 fits 16 bits (it's under 2|y|, and
\\ |y| <= 32768), so it's one multiply and one 16-bit shift by e - 6.
\\ in: y (s16, |y| <= x), f, e (x's reciprocal). out: A.
.project_col
{
    ZA_AUTO2 y                  ; in
    ZA_AUTO1 f, e               ; in
    ZA_AUTO2 u                  ; local: |y|
    ZA_AUTO1 lo                 ; local: q's low byte
    ZA_AUTO2 q                  ; local: the near product
    LDA y + 1 : BPL pos
    LDA #0 : SEC : SBC y : STA u
    LDA #0 : SBC y + 1 : STA u + 1
    JMP mag
.pos
    STA u + 1
    LDA y : STA u
.mag
    LDA e : CMP #6 : BCC near
    LDA f : SETMUL
    LDY u : MULHI : STA lo      ; (|y|.lo * f) >> 8
    LDY u + 1 : BEQ @+          ; (|y| under 256: no more)
    MULX : TAY                  ; |y|.hi * f: Y = high, X = low
    TXA : CLC : ADC lo : STA lo
    BCC @+
    INY
.@  LDA lo : CLC : ADC u : STA lo   ; + |y|
    TYA : ADC u + 1             ; A:lo
    LDX e : CPX #6 : BEQ sign
.shift
    LSR A : ROR lo              ; >> e - 6
    DEX : CPX #6 : BNE shift
.sign
    LDA y + 1 : BMI left
    LDA lo : CLC : ADC #64
    RTS
.left
    LDA #64 : SEC : SBC lo
    RTS
.near                           ; depth 32 or less: |y| is a byte, the product under 2^14
    LDY u : LDA f : MUL_RECIP8 u, q
    LDA e : CLC : ADC #2 : TAX  ; >> e + 2
    ACC_SHR q
    STA lo
    JMP sign
}

\\ The same at depth d, as u8.8 (the near clip's column): y is clamped to
\\ the ray first, since interpolation can nudge it just past.
\\ in: y (s16), d (u16, 0 < d < 16384). out: q (u16).
.project_col_q8
{
    ZA_AUTO2 y, d               ; in
    ZA_AUTO2 q                  ; out
    ZA_AUTO2 u                  ; local: |y|, then shifted
    LDA y + 1 : BPL pos         ; |y|
    LDA #0 : SEC : SBC y : STA u
    LDA #0 : SBC y + 1 : STA u + 1
    JMP clamp
.pos
    STA u + 1
    LDA y : STA u
.clamp
    LDA d : CMP u               ; |y| > d: |y| = d
    LDA d + 1 : SBC u + 1
    BCS inside
    LDA d : STA u
    LDA d + 1 : STA u + 1
.inside
    RECIP16 d                   ; X = e, at most 14
    PHA                         ; f, while the numerator is shifted
    TXA : EOR #&FF : SEC : ADC #14 : TAX    ; 14 - e
    BEQ mul
.up
    ASL u : ROL u + 1           ; |y| << 14 - e: exact, at most 16,510
    DEX : BNE up
.mul
    PLA : MUL_RECIP16 u, q      ; at most 16,514: no 17th bit
    LDA #&00 : CMP q            ; q past 64 << 8: q = 64 << 8
    LDA #&40 : SBC q + 1
    BCS sign
    LDA #0 : STA q
    LDA #&40 : STA q + 1
.sign
    LDA y + 1 : BMI left
    LDA q + 1 : CLC : ADC #&40 : STA q + 1  ; (64 << 8) + q
    RTS
.left
    LDA #0 : SEC : SBC q : STA q            ; (64 << 8) - q
    LDA #&40 : SBC q + 1 : STA q + 1
    RTS
}

\\ 64*len/x as u8.8, saturating at &FFFF: a length's projected size. A
\\ byte len's exact product shifts by e - 6, a wide len's by e - 14, either
\\ way; the 17th bit, in C, comes in on a right shift and saturates a left.
\\ in: len (u16), f, e (x's reciprocal). out: q (u16).
.project_q8
{
    ZA_AUTO2 len                ; in
    ZA_AUTO1 f, e               ; in
    ZA_AUTO2 q                  ; out
    LDY len + 1 : BNE wide
    LDA e : SEC : SBC #6 : TAX  ; e - 6, signed (first: the multiply's carry is wanted)
    LDY len : LDA f : MUL_RECIP8 len, q
    JMP shift
.wide
    LDA e : SEC : SBC #14 : TAX ; e - 14
    LDA f : MUL_RECIP16 len, q
.shift
    TXA : BMI left              ; (C untouched)
    ACC_SHR17 q                 ; >> e - k
    BCS sat                     ; still past 16 bits
    RTS
.left
    BCS sat                     ; past 16 bits already
    EOR #&FF : ADC #1 : TAX     ; << k - e (C clear)
    ACC_SHL q
    BCS sat
    RTS
.sat
    LDA #&FF : STA q : STA q + 1
    RTS
}

\\ 64*8*h8/x: the row offset of a line endpoint from the screen's centre,
\\ for an endpoint on screen (x >= 16*h8). From depth 256 on (e >= 9) the
\\ answer is the product's top nine bits, C:A, shifted right by e - 9.
\\ in: Y = h8, A = f, X = e (x's reciprocal). out: A.
.project_rowd
{
    ZA_AUTO1 h                  ; local
    ZA_AUTO2 q                  ; local: the near product
    STY h
    CPX #9 : BCC near
    SETMUL
    MULHI                       ; (h8 * f) >> 8...
    CPX #9 : BEQ nine           ; (compared first: a CPX after the ADC would eat its carry)
    CLC : ADC h                 ; ...+ h8: p >> 8, its 17th bit in C
    ROR A                       ; >> 9, bringing the 17th bit in
    CPX #10 : BEQ done
.shift
    LSR A
    DEX : CPX #10 : BNE shift
.done
    RTS
.nine
    CLC : ADC h                 ; >> e - 1 = 8: p >> 8 (q <= 32: no 17th bit)
    RTS
.near                           ; depth 257 or less: h8 <= 16, the product under 2^13
    MUL_RECIP8 h, q             ; X kept
    TXA : BEQ left              ; e is 0 only at depth 1, where h8 is 0
    DEX                         ; >> e - 1
    ACC_SHR q
    RTS
.left
    LDA q : ASL A
    RTS
}

\\ va + t * (vb - va) for a u0.8 t: the comparison picks the direction, and
\\ the difference is multiplied unsigned.
\\ in: va, vb (s16), A = t. out: r (s16).
.lerp16
{
    ZA_AUTO2 va, vb             ; in
    ZA_AUTO2 r                  ; out
    ZA_AUTO2 d, p               ; local: |vb - va|, t times it
    SETMUL                      ; t
    LDA vb : SEC : SBC va : STA d
    LDA vb + 1 : SBC va + 1 : STA d + 1
    BVC @+
    EOR #&80                    ; N EOR V: vb < va
.@  BMI down
    MULU16_FRAC d, p            ; va + t * (vb - va)
    LDA va : CLC : ADC p : STA r
    LDA va + 1 : ADC p + 1 : STA r + 1
    RTS
.down
    LDA #0 : SEC : SBC d : STA d    ; va - vb
    LDA #0 : SBC d + 1 : STA d + 1
    MULU16_FRAC d, p            ; va - t * (va - vb)
    LDA va : SEC : SBC p : STA r
    LDA va + 1 : SBC p + 1 : STA r + 1
    RTS
}

\ s = pa with sign na plus pb with sign nb (bit 7 each), two's complement:
\ opposite signs are one subtraction; two negatives negate the sum.
MACRO ACC2 pa, pb, na, nb, s
{
    LDA na : EOR nb : BMI differ
    LDA pa : CLC : ADC pb : STA s
    LDA pa + 1 : ADC pb + 1 : STA s + 1
    BIT na : BPL done
    LDA #0 : SEC : SBC s : STA s
    LDA #0 : SBC s + 1 : STA s + 1
    JMP done
.differ
    BIT na : BMI bfirst
    LDA pa : SEC : SBC pb : STA s
    LDA pa + 1 : SBC pb + 1 : STA s + 1
    JMP done
.bfirst
    LDA pb : SEC : SBC pa : STA s
    LDA pb + 1 : SBC pa + 1 : STA s + 1
.done
}
ENDMACRO

\\ Rotate (x, y) into the frame of an angle: x' = x cos + y sin,
\\ y' = y cos - x sin, each product rounded. Each table value multiplies
\\ both magnitudes (two SETMULs), and the signed sums are inline.
\\ in: x, y (s16, not -32768), A = the angle. out: rx, ry (s16).
.rot
{
    ZA_AUTO2 x, y               ; in
    ZA_AUTO2 rx, ry             ; out
    ZA_AUTO2 ux, uy             ; local: |x|, |y|
    ZA_AUTO2 cx, cy, sx, sy     ; local: the rounded products
    ZA_AUTO1 sneg, cneg         ; local: the sine's and cosine's signs, bit 7
    ZA_AUTO1 na, nb             ; local: a sum's terms' signs, bit 7
    STA sneg
    CLC : ADC #64 : STA cneg
    LDA x + 1 : BPL xpos        ; |x|
    LDA #0 : SEC : SBC x : STA ux
    LDA #0 : SBC x + 1 : STA ux + 1
    JMP ymag
.xpos
    STA ux + 1
    LDA x : STA ux
.ymag
    LDA y + 1 : BPL ypos        ; |y|
    LDA #0 : SEC : SBC y : STA uy
    LDA #0 : SBC y + 1 : STA uy + 1
    JMP cosine
.ypos
    STA uy + 1
    LDA y : STA uy
.cosine                         ; index 0 is zero; a stored 0 means 256
    LDA cneg : AND #&7F : TAX : BEQ czero
    LDA sine,X : BEQ cone
    SETMUL
    MULU16_FRAC_ROUND ux, cx
    MULU16_FRAC_ROUND uy, cy
    JMP sine_
.czero
    STA cx : STA cx + 1 : STA cy : STA cy + 1
    JMP sine_
.cone
    LDA ux : STA cx : LDA ux + 1 : STA cx + 1
    LDA uy : STA cy : LDA uy + 1 : STA cy + 1
.sine_
    LDA sneg : AND #&7F : TAX : BEQ szero
    LDA sine,X : BEQ sone
    SETMUL
    MULU16_FRAC_ROUND ux, sx
    MULU16_FRAC_ROUND uy, sy
    JMP sums
.szero
    STA sx : STA sx + 1 : STA sy : STA sy + 1
    JMP sums
.sone
    LDA ux : STA sx : LDA ux + 1 : STA sx + 1
    LDA uy : STA sy : LDA uy + 1 : STA sy + 1
.sums
    LDA x + 1 : EOR cneg : STA na       ; x' = ux cos (nx != cneg) + uy sin (ny != sneg)
    LDA y + 1 : EOR sneg : STA nb
    ACC2 cx, sy, na, nb, rx
    LDA y + 1 : EOR cneg : STA na       ; y' = uy cos (ny != cneg) + ux sin (nx == sneg)
    LDA x + 1 : EOR sneg : EOR #&80 : STA nb
    ACC2 cy, sx, na, nb, ry
    RTS
}

\\ (mag cos, mag sin) in s8.8: the camera's facing step, exact.
\\ in: A = mag (0..127), X = the angle. out: dx, dy (s16).
.dir8
{
    ZA_AUTO1 mag, ang           ; local
    ZA_AUTO1 sgn, hi            ; local: a term's sign (bit 7) and high byte
    ZA_AUTO2 dx, dy             ; out
    STA mag : STX ang
    TXA : CLC : ADC #64 : JSR term     ; the cosine...
    STX dx : STA dx + 1
    LDA ang : JSR term                 ; ...and the sine
    STX dy : STA dy + 1
    RTS
\ mag times the sine of the angle in A, signed: X = low, A = high.
.term
    STA sgn
    AND #&7F : BEQ zero         ; index 0: zero
    TAX : LDA sine,X : BEQ whole    ; a stored 0 means 256
    LDY mag : SETMUL : MULX     ; mag * v
    BIT sgn : BPL done
    STA hi                      ; negate X:A
    TXA : EOR #&FF : CLC : ADC #1 : TAX
    LDA hi : EOR #&FF : ADC #0
.done
    RTS
.whole
    LDX #0 : LDA mag            ; mag << 8
    BIT sgn : BPL done
    EOR #&FF : CLC : ADC #1     ; -(mag << 8): the low byte stays 0
    RTS
.zero
    LDX #0 : TXA
    RTS
}

\\ The angle's ray basis: k1 = C - S, k2 = C + S, at scale 256, decoded as
\\ rot's terms decode them. in: A = the angle. out: k1, k2 (s16).
.ray_basis
{
    ZA_AUTO2 k1, k2             ; out
    ZA_AUTO2 c                  ; local: the cosine
    ZA_AUTO1 ang                ; local
    STA ang
    CLC : ADC #64 : JSR sin256
    STX c : STA c + 1
    LDA ang : JSR sin256        ; X:A = S
    STX k2 : STA k2 + 1         ; (keep S)
    LDA c : SEC : SBC k2 : STA k1   ; C - S
    LDA c + 1 : SBC k2 + 1 : STA k1 + 1
    LDA c : CLC : ADC k2 : STA k2   ; C + S
    LDA c + 1 : ADC k2 + 1 : STA k2 + 1
    RTS
\ The signed sine of the angle in A at scale 256: X = low, A = high.
.sin256
    TAY : AND #&7F : BEQ zero
    TAX : LDA sine,X : BEQ whole
    LDX #0                      ; 0 < v < 256
    CPY #&80 : BCS negv
    TAX : LDA #0                ; v
    RTS
.negv
    EOR #&FF : CLC : ADC #1 : TAX   ; -v: X = low...
    LDA #&FF                        ; ...A = high
    RTS
.whole
    LDX #0 : LDA #1             ; 256
    CPY #&80 : BCC done
    LDA #&FF                    ; -256
.done
    RTS
.zero
    LDX #0 : TXA
    RTS
}
