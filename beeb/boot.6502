\\ boot.6502 - !BOOT, *RUN by SHIFT-BREAK (the disc's *OPT 4,2): machine
\\ code at &400, as spritescale's.

SECTION Boot, filename = "!BOOT", org = &FFFF1900, exec = &FFFF0000+boot_entry

\\ Silence the beep, find a bank of sideways RAM (an error if there's
\\ none), print the title, run PORTAL.

BASIC
0CALLPAGE+{
    EQUS AS_STRING(basic_entry-&1900)
}
ENDBASIC

    ZA_ENTRY

.basic_entry
    LDA &18
    STA messageloop+2
    STA cmdhi+1

    \\ silence the beep

.boot_entry                             ; *RUN comes in here
    CLI
    LDA #15:LDX #0:JSR &FFF4            ; *FX15,0: flush the buffers

    \\ sideways RAM: a bank whose first byte takes a write

    SEI                                 ; nothing pages it out under us
    LDX #15
.probe
    STX &FE30                           ; ROMSEL: bank X at &8000
    LDA &8000:TAY
    EOR #&FF:STA &8000
    CMP &8000                           ; Z: it took
    STY &8000                           ; put it back
    BEQ found
    DEX
    BPL probe
    
    LDA &F4:STA &FE30                   ; the OS's bank back
    CLI
    BRK
    EQUB 0
    EQUS "PORTAL needs sideways RAM", 0
    ZA_UNREACHABLE                      ; the BRK doesn't come back

.found
    STX &400                            ; the bank, for PORTAL
    LDA &F4:STA &FE30
    CLI

    \\ print the title

    LDX #0
.messageloop
    LDA message,X
    JSR &FFE3                           ; OSASCI
    INX
    CPX #message_end-message
    BNE messageloop

    \\ run PORTAL

    LDX #LO(cmd)
.cmdhi
    LDY #HI(cmd)
    JMP &FFF7                           ; OSCLI

.cmd
    EQUS "/"
.message
    EQUS "PORTAL", 13, 13
.message_end

ENDSECTION
