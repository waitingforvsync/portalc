\ **************************************************************************
\ *
\ *     mode5.6502 - the back buffer: clears, fills and the cursor (mode5.c)
\ *
\ **************************************************************************
\
\ A buffer is 16 character rows of 256 bytes, byte column c's block at
\ c * 8 in each, a scanline a byte. The engine works in canvas rows,
\ scanline pairs: row r is scanlines 2r (its even pattern) and 2r + 1 (its
\ odd), in character row r DIV 4 at Y = (r MOD 4) * 2. A junk character
\ row either side takes a line's overrun, rows -4..-1 and 64..67; nothing
\ clears, fills or shows them.
\
\ The cursor is a block address in zero page and Y, as the C plotters'
\ pt_mode5_cur: AT places it, ROW EORs a pixel pair in, and DOWN, UP,
\ NEXTBYTE and RIGHT move it. ROW, DOWN and UP leave C alone, for the
\ plotters' fractions.

\ A pixel column's two bits in its byte, by column MOD 4.
.pixmasks
    EQUB &88, &44, &22, &11

\ Place cursor c at canvas row A (-4..67, a byte) and pixel column X, in
\ the buffer whose first page is in page: c = the row's block in the
\ column's byte, Y = the row's even scanline.
MACRO AT c, page
    TAY
    CMP #&80 : ROR A            ; row ASR 2, the sign kept: the character
    CMP #&80 : ROR A            ; row, -1 in the junk row above
    CLC : ADC page : STA c + 1
    TYA : AND #3 : ASL A : TAY  ; (row MOD 4) * 2
    TXA : ASL A : AND #&F8 : STA c  ; (column DIV 4) * 8
ENDMACRO

\ EOR patterns pe and po under a mask into the row at the cursor: pe into
\ its even scanline, po into its odd. Y is left on the odd one.
MACRO ROW c, "#" mask, pe, po
    IF mask == &FF
        LDA pe : EOR (c),Y : STA (c),Y
        INY
        LDA po : EOR (c),Y : STA (c),Y
    ELSE
        LDA pe : AND #mask : EOR (c),Y : STA (c),Y
        INY
        LDA po : AND #mask : EOR (c),Y : STA (c),Y
    ENDIF
ENDMACRO

MACRO ROW c, m, pe, po
    LDA pe : AND m : EOR (c),Y : STA (c),Y
    INY
    LDA po : AND m : EOR (c),Y : STA (c),Y
ENDMACRO

\ From a row's odd scanline (as ROW leaves Y) down to the next row's even
\ one: past the block's end, the top of the block below.
MACRO DOWN c
    INY
    TYA : AND #7 : BNE same
    TAY                         ; Y = 0
    INC c + 1
.same
ENDMACRO

\ From a row's odd scanline up to the row above's even one: above the
\ block's top, the bottom of the block above.
MACRO UP c
    DEY : DEY : DEY
    BPL same
    LDY #6
    DEC c + 1
.same
ENDMACRO

\ A byte column right: the next block along (never carrying, within a
\ character row). Clobbers A and C.
MACRO NEXTBYTE c
    LDA c : CLC : ADC #8 : STA c
ENDMACRO

\ A pixel column right: mask m moves along the byte, and past its last
\ pixel back to &88 in the next block. Clobbers A and C.
MACRO RIGHT c, m
    LSR m : BCC same            ; &11 shifts a 1 out: the byte's done
    LDA #&88 : STA m
    LDA c : ADC #7 : STA c      ; the next block: + 8 with the carry
.same
ENDMACRO

\ Clear a buffer to zero, its junk rows alone: 16 pages a pass, about 21.8k
\ cycles.
MACRO CLEARBODY base
    LDA #0
    TAY
.loop
FOR pg = 0 ..< 16
    STA base + pg * 256, Y
NEXT
    INY
    BNE loop
ENDMACRO

\\ Clear the buffer scrnbase names.
.clear
    LDA scrnbase : CMP #HI(BUF_B) : BEQ clear_b
.clear_a
    CLEARBODY BUF_A
    RTS

.clear_b
    CLEARBODY BUF_B
    RTS

\ The EOR fill (pt_mode5_fill): down each byte column, its even scanlines
\ then its odd, each byte becoming the EOR of itself and every byte above
\ it. X is the column's block, so abs,X never leaves its page. Unrolled: 9
\ cycles a byte, about 37k cycles a buffer.
MACRO FILLBODY base
    LDX #0
    CLC                         ; and clear for good: the body never touches it,
.column                         ; and the loop only goes round without a carry
FOR s = {0, 1}                  ; the even pass, then the odd
    LDA base + s, X             ; the column's first: nothing above it
    FOR r = 0 ..< 16
        FOR k = s..s+2..<8      ; the pass's scanlines in each block
            IF r * 8 + k != s
                EOR base + r * 256 + k, X
                STA base + r * 256 + k, X
            ENDIF
        NEXT
    NEXT
NEXT
    TXA : ADC #8 : TAX          ; the next byte column
    BCS done                    ; past the 32nd
    JMP column
.done
ENDMACRO

IF HARNESS                      ; (release-bound, once main calls it)
\\ Fill the buffer scrnbase names.
.fill
    LDA scrnbase : CMP #HI(BUF_B) : BNE fill_a
    JMP fill_b                  ; (out of branch range)
.fill_a
    FILLBODY BUF_A
    RTS

.fill_b
    FILLBODY BUF_B
    RTS
ENDIF
